  .thumb-card{ background:#fff; border:1px solid #E8E3DC; border-radius:12px; padding:8px; display:flex; flex-direction:column; gap:6px; }
  .thumb-card img{ width:100%; height:120px; object-fit:contain; border-radius: 10px; background:#F8F7F4; }
  .thumb-label{ text-align:center; font-size:12px; font-weight:600; color:#57534E; }
  .thumb-actions{ margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; }
  @media (max-width:640px){ .thumb-actions{ flex-direction:column;} }
</style>

<Disclaimer variant="general" />

  <script>
  import { saveFileAs } from '../../lib/utils/save-file.js';
  // Lazy-load heavy libs only when user actually selects a file — saves ~3.6 MB on initial load
  let pdfjsCache = null;
  let jszipCache = null;
  async function getPdfJs() {
    if (pdfjsCache) return pdfjsCache;
    const m = await import('pdfjs-dist/legacy/build/pdf.mjs');
    m.GlobalWorkerOptions.workerSrc = new URL('pdfjs-dist/legacy/build/pdf.worker.mjs', import.meta.url).toString();
    pdfjsCache = m;
    return m;
  }
  async function getJSZip() {
    if (jszipCache) return jszipCache;
    const m = await import('jszip');
    jszipCache = m.default || m;
    return jszipCache;
  }
  // yield to main thread between pages so UI stays responsive under load
  const yieldToMain = () => new Promise(r => setTimeout(r, 0));
  const MAX_FILE_SIZE = 50 * 1024 * 1024;
  const MAX_FILE_SIZE_LABEL = '50 MB';
  const MAX_PAGES_SAFE = 120; // guard OOM on low-end devices

  const root = document.getElementById('pdf-tool-pdf-to-jpg');
  if (root) {
    const $ = (sel) => root.querySelector(sel);
    const fileInput = $('#pdf-file-input');
    const dropzone = $('#pdf-dropzone');
    const filePanel = $('#pdf-file-panel');
    const fileList = $('#pdf-file-list');
    const countEl = $('#pdf-count');
    const optionsEl = $('#pdf-options');
    const pagesPanel = $('#pdf-pages-panel');
    const actionWrap = $('#pdf-action-wrap');
    const actionBtn = $('#pdf-action');
    const errorEl = $('#pdf-error');
    const progressEl = $('#pdf-progress');
    const progressTitle = $('#pdf-progress-title');
    const progressBar = $('#pdf-progress-bar');
    const progressText = $('#pdf-progress-text');
    const resultEl = $('#pdf-result');
    const resultTitle = $('#pdf-result-title');
    const resultDetail = $('#pdf-result-detail');
    const resultInfo = $('#pdf-result-info');
    const resultGrid = $('#pdf-result-grid');
    const downloadBtn = $('#pdf-download');
    const resetBtn = $('#pdf-reset');
    const qualitySelect = $('#pdf-quality');
    const changeFileBtn = document.getElementById('pdf-change-file');

    let files = [];
    let busy = false;
    let resultUrls = [];
    let selectedPages = new Set();
    let totalPages = 0;
    let convertedPages = [];

    const fmt = (b) => b < 1048576 ? `${Math.max(1, Math.round(b / 1024))} KB` : `${(b / 1048576).toFixed(1)} MB`;
    const sanitize = (s) => s.replace(/[^a-zA-Z0-9._-]/g, '_').replace(/_+/g, '_');
    const err = (msg = '') => { if (!errorEl) return; errorEl.textContent = msg; errorEl.classList.toggle('hidden', !msg); };
    const setBusy = (v) => { busy = v; if (actionBtn) { actionBtn.disabled = v; actionBtn.classList.toggle('opacity-60', v); } };
    const showProgress = (title) => {
      progressEl.classList.remove('hidden');
      progressTitle.textContent = title || 'Converting PDF…';
      progressBar.style.width = '0%'; progressBar.parentElement?.setAttribute('aria-valuenow', '0');
      progressText.textContent = '';
    };
    const setProgress = (cur, total, label) => {
      const pct = Math.round((cur / total) * 100);
      progressBar.style.width = `${pct}%`; progressBar.parentElement?.setAttribute('aria-valuenow', String(pct));
      progressText.textContent = label || `Converting page ${cur} of ${total}…`;
    };
    const hideProgress = () => { progressEl.classList.add('hidden'); progressBar.style.width = '0%'; progressText.textContent = ''; };
    const revokeUrls = () => { resultUrls.forEach(URL.revokeObjectURL); resultUrls = []; };
    const validate = (list) => [...list].filter((f) => f.size <= MAX_FILE_SIZE && (f.type === 'application/pdf' || /\.pdf$/i.test(f.name)));

    const segRadios = root.querySelectorAll('input[name="pdf-quality-radio"]');
    segRadios.forEach(r => r.addEventListener('change', () => { if (qualitySelect) qualitySelect.value = r.value; }));
    const segAll = root.querySelector('[data-pages="all"]');
    const segCustom = root.querySelector('[data-pages="custom"]');
    function setPagesMode(mode) {
      segAll?.classList.toggle('is-active', mode === 'all');
      segCustom?.classList.toggle('is-active', mode === 'custom');
      if (mode === 'all') {
        for (let i = 1; i <= totalPages; i++) selectedPages.add(i);
        pagesPanel.querySelectorAll('#pdf-page-chk input').forEach(c => { c.checked = true; syncChk(c); });
      } else {
        selectedPages.clear();
        pagesPanel.querySelectorAll('#pdf-page-chk input').forEach(c => { c.checked = false; syncChk(c); });
      }
      updateConvertBtn();
    }
    segAll?.addEventListener('click', () => setPagesMode('all'));
    segCustom?.addEventListener('click', () => setPagesMode('custom'));

    function renderFiles() {
      if (!fileList) return;
      fileList.innerHTML = '';
      if (countEl) countEl.textContent = `${files.length} file${files.length === 1 ? '' : 's'}`;
      files.forEach((file, idx) => {
        const row = document.createElement('div');
        row.className = 'flex min-w-0 items-center gap-2';
        row.style.display = 'flex';
        const icon = document.createElement('span');
        icon.className = 'h-10 w-10 shrink-0 rounded flex items-center justify-center bg-[var(--nk-muted)] text-[10px] font-bold';
        icon.style.background = '#FDE7E4'; icon.style.color = '#E62B1E';
        icon.textContent = 'PDF';
        row.append(icon);
        const info = document.createElement('div');
        info.className = 'min-w-0 flex-1';
        // NOTE: file.name is attacker-controlled — never interpolate into HTML.
        const nameP = document.createElement('p');
        nameP.className = 'truncate text-sm font-medium';
        nameP.style.color = '#171717';
        nameP.textContent = file.name;
        const sizeP = document.createElement('p');
        sizeP.className = 'meta text-xs';
        sizeP.style.color = '#6B6B6B';
        sizeP.textContent = fmt(file.size);
        info.append(nameP, sizeP);
        row.append(info);
        if (file) {
          (async () => {
            try {
              const { getDocument } = await getPdfJs();
              const data = await file.arrayBuffer();
              const pdf = await getDocument({ data }).promise;
            const m = info.querySelector('.meta');
            if (m) m.textContent = `${fmt(file.size)} · ${pdf.numPages} page${pdf.numPages === 1 ? '' : 's'}`;
            } catch {}
          })();
        }
        const rm = document.createElement('button');
        rm.type = 'button'; rm.textContent = '×'; rm.title = `Remove ${file.name}`;
        rm.style.cssText = 'width:28px;height:28px;border-radius: 10px;border:1px solid #E8E3DC;background:#fff;color:#6B6B6B;cursor:pointer;';
        rm.onclick = () => { files.splice(idx, 1); renderFiles(); updateVisibility(); if (pagesPanel) { pagesPanel.innerHTML=''; pagesPanel.classList.add('hidden'); } };
        row.append(rm);
        fileList.append(row);
      });
    }

    function addFiles(list) {
      const valid = validate(list);
      if (!valid.length) { err(`Choose a PDF file up to ${MAX_FILE_SIZE_LABEL}.`); return; }
      const tooLarge = [...list].some(f => f.size > MAX_FILE_SIZE);
      if (tooLarge) err(`File too large. Maximum ${MAX_FILE_SIZE_LABEL}.`);
      else err('');
      files = valid.slice(0, 1);
      renderFiles();
      updateVisibility();
      setupPagesPanel();
    }

    function updateVisibility() {
      const has = files.length > 0;
      filePanel?.classList.toggle('hidden', !has);
      optionsEl?.classList.toggle('hidden', !has);
      if (dropzone) dropzone.style.display = has ? 'none' : 'flex';
      if (has) {
        pagesPanel?.classList.remove('hidden');
        actionWrap?.classList.remove('hidden');
      } else {
        pagesPanel?.classList.add('hidden');
        actionWrap?.classList.add('hidden');
      }
    }

    if (dropzone && fileInput) {
      // label[for] handles click natively — no JS click needed, fixes double-click/first-click miss
      dropzone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
      fileInput.addEventListener('change', () => { if (fileInput.files?.length) addFiles(fileInput.files); fileInput.value = ''; });
      ['dragenter','dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('is-dragging'); }));
      ['dragleave','drop'].forEach(ev => dropzone.addEventListener(ev, (e) => { if (ev==='drop') e.preventDefault(); dropzone.classList.remove('is-dragging'); }));
      dropzone.addEventListener('drop', (e) => { const dt = e.dataTransfer; if (dt?.files?.length) addFiles(dt.files); });
    }
    changeFileBtn?.addEventListener('click', () => fileInput?.click());

    function setupPagesPanel() {
      if (!pagesPanel || files.length === 0) return;
      pagesPanel.innerHTML = '';
      selectedPages.clear(); convertedPages = [];
      files[0].arrayBuffer().then(async (data) => {
        const { getDocument } = await getPdfJs();
        const pdf = await getDocument({ data }).promise;
        // keep original pdf variable via closure
        totalPages = pdf.numPages;
        for (let i = 1; i <= totalPages; i++) selectedPages.add(i);
        pagesPanel.innerHTML = `
          <div class="pages-head">
            <span class="opt-label">Select pages</span>
            <span class="pages-count">${totalPages} page${totalPages===1?'':'s'}</span>
          </div>
          <div id="pdf-page-chk" class="page-chips"></div>
          <p id="pdf-select-hint" class="hidden" style="margin-top:8px;text-align:center;font-size:12px;color:#DC2626;">Select at least one page.</p>
        `;
        const chkContainer = pagesPanel.querySelector('#pdf-page-chk');
        for (let i = 1; i <= totalPages; i++) {
          const label = document.createElement('label');
          label.className = 'page-chip';
          const cb = document.createElement('input');
          cb.type = 'checkbox'; cb.checked = true;
          cb.addEventListener('change', () => { cb.checked ? selectedPages.add(i) : selectedPages.delete(i); syncChk(cb); updateConvertBtn(); });
          const sp = document.createElement('span');
          sp.textContent = `Page ${i}`;
          label.append(cb, sp);
          chkContainer.append(label);
          syncChk(cb);
        }
        const actions = document.createElement('div');
        actions.className = 'page-actions';
        actions.innerHTML = `<button type="button" class="ghost-btn" id="pdf-sel-all">Select all</button><button type="button" class="ghost-btn" id="pdf-desel-all">Deselect all</button>`;
        pagesPanel.append(actions);
        pagesPanel.querySelector('#pdf-sel-all')?.addEventListener('click', () => setPagesMode('all'));
        pagesPanel.querySelector('#pdf-desel-all')?.addEventListener('click', () => setPagesMode('custom'));
        updateConvertBtn();
      }).catch(() => { pagesPanel.innerHTML = '<p class="field-error">Could not read this PDF. It may be corrupted.</p>'; });
    }

    function syncChk(cb) {
      const l = cb.closest('label');
      if (!l) return;
      l.classList.toggle('is-checked', cb.checked);
    }

    function updateConvertBtn() {
      if (!actionBtn) return;
      const n = selectedPages.size;
      const label = totalPages > 1 ? `Convert ${n} page${n === 1 ? '' : 's'} to JPG` : 'Convert to JPG';
      actionBtn.textContent = label;
      const disabled = n === 0 || totalPages === 0;
      actionBtn.disabled = disabled;
      actionBtn.setAttribute('aria-disabled', String(disabled));
      const hint = pagesPanel?.querySelector('#pdf-select-hint');
      hint?.classList.toggle('hidden', n > 0);
      const allSelected = n === totalPages && totalPages>0;
      segAll?.classList.toggle('is-active', allSelected);
      segCustom?.classList.toggle('is-active', !allSelected && n>0);
    }

    async function runPdfToJpg() {
      if (busy || !files.length || selectedPages.size === 0) return;
      err(); setBusy(true); revokeUrls(); convertedPages = [];
      showProgress('Converting PDF…');
      resultEl?.classList.add('hidden');
      try {
        const { getDocument } = await getPdfJs();
        const pdf = await getDocument({ data: await files[0].arrayBuffer() }).promise;
        if (pdf.numPages > MAX_PAGES_SAFE) {
          err(`This PDF has ${pdf.numPages} pages — please select up to ${MAX_PAGES_SAFE} to avoid memory issues on mobile.`);
          setBusy(false); hideProgress(); return;
        }
        const quality = qualitySelect?.value || 'standard';
        const scales = { standard: 1.5, high: 2.0, print: 3.0 };
        const jpgQ = { standard: 0.82, high: 0.9, print: 0.95 };
        const scale = scales[quality] || 1.5;
        const jq = jpgQ[quality] || 0.82;
        const baseName = sanitize(files[0].name.replace(/\.pdf$/i, ''));
        const pages = [...selectedPages].sort((a,b)=>a-b);
        const total = pages.length;
        for (let i=0;i<total;i++) {
          setProgress(i, total, `Converting page ${pages[i]} of ${total}…`);
          const pageNum = pages[i];
          try {
            const page = await pdf.getPage(pageNum);
            const vp = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            canvas.width = Math.ceil(vp.width); canvas.height = Math.ceil(vp.height);
            await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
            const blob = await new Promise((r)=> canvas.toBlob(r,'image/jpeg',jq));
            canvas.width=0; canvas.height=0;
            await yieldToMain();
            if (blob && blob.type==='image/jpeg' && blob.size>0) {
              const url = URL.createObjectURL(blob);
              resultUrls.push(url);
              convertedPages.push({ pageNum, blob, url, fileName: `${baseName}-page-${pageNum}.jpg`, width: Math.ceil(vp.width), height: Math.ceil(vp.height) });
            } else convertedPages.push({ pageNum, error:true });
          } catch { convertedPages.push({ pageNum, error:true }); }
        }
        progressBar.style.width='100%';
        hideProgress();
        const ok = convertedPages.filter(p=>!p.error);
        const fail = convertedPages.filter(p=>p.error);
        if (!ok.length) throw new Error('No pages could be converted.');
        if (resultTitle) resultTitle.textContent = `Conversion complete`;
        if (resultDetail) resultDetail.textContent = `${ok.length} JPG image${ok.length===1?'':'s'} ${fail.length?`· ${fail.length} page${fail.length===1?'':'s'} failed`:''} ready to download.`;
        const totalOut = ok.reduce((s,p)=>s+p.blob.size,0);
        if (resultInfo) {
          resultInfo.innerHTML = `<div class="result-meta"><span>Original</span><span>PDF · ${fmt(files[0].size)} · ${totalPages} pages</span></div><div class="result-meta"><span>Output</span><span>JPG · ${fmt(totalOut)} total ${ok.length===1?`· ${ok[0].width}×${ok[0].height}px`:''}</span></div>`;
        }
        renderJpgResult(ok);
        resultEl?.classList.remove('hidden');
        resultEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (downloadBtn) { downloadBtn.classList.add('hidden'); }
      } catch (e) {
        hideProgress();
        const msg = e.message?.includes('password') ? 'This PDF is password protected.' : `Conversion failed: ${e.message || 'Please try another PDF.'}`;
        err(msg);
      } finally { setBusy(false); updateConvertBtn(); }
    }

    function renderJpgResult(pages) {
      if (!resultGrid) return;
      resultGrid.innerHTML = '';
      if (pages.length === 1) {
        const p = pages[0];
        const wrap = document.createElement('div'); wrap.className = 'single-preview';
        const img = document.createElement('img'); img.src = p.url; img.alt = p.fileName; img.loading='lazy';
        wrap.append(img);
        const btns = document.createElement('div'); btns.className='single-actions';
        const dl = document.createElement('button'); dl.type='button'; dl.className='btn-primary'; dl.textContent='Download JPG';
        dl.addEventListener('click',()=> dlJpg(p));
        const again = document.createElement('button'); again.type='button'; again.className='btn-secondary'; again.textContent='Convert another PDF';
        again.addEventListener('click', ()=> resetBtn?.click());
        btns.append(dl, again);
        resultGrid.append(wrap, btns);
      } else {
        const g = document.createElement('div'); g.className='thumb-grid';
        pages.forEach(p=>{
          const c=document.createElement('div'); c.className='thumb-card';
          const img=document.createElement('img'); img.src=p.url; img.alt=p.fileName; img.loading='lazy';
          const m=document.createElement('span'); m.className='thumb-label'; m.textContent=`Page ${p.pageNum}`;
          const b=document.createElement('button'); b.type='button'; b.className='ghost-btn'; b.style.width='100%'; b.textContent='Download';
          b.addEventListener('click',()=> dlJpg(p));
          c.append(img,m,b); g.append(c);
        });
        const actions=document.createElement('div'); actions.className='thumb-actions';
        const all=document.createElement('button'); all.type='button'; all.className='btn-primary'; all.textContent=`Download all (${pages.length} JPGs)`;
        all.addEventListener('click',()=> dlAllJpg(pages));
        const again=document.createElement('button'); again.type='button'; again.className='btn-secondary'; again.textContent='Convert another PDF';
        again.addEventListener('click',()=> resetBtn?.click());
        actions.append(all, again);
        resultGrid.append(g, actions);
      }
    }

    async function dlBlob(blob, filename) { await saveFileAs(blob, filename); }
    function dlJpg(p) { dlBlob(p.blob, p.fileName); }
    async function dlAllJpg(pages) {
      if (pages.length===1) return dlJpg(pages[0]);
      const JSZipCls = await getJSZip();
      const zip = new JSZipCls();
      pages.forEach(p=> zip.file(p.fileName, p.blob));
      const blob = await zip.generateAsync({ type:'blob' });
      await dlBlob(blob, `${sanitize(files[0].name.replace(/\.pdf$/i,''))}-jpgs.zip`);
    }

    actionBtn?.addEventListener('click', runPdfToJpg);

    resetBtn?.addEventListener('click', () => {
      files=[]; revokeUrls(); convertedPages=[]; selectedPages.clear(); totalPages=0;
      resultEl?.classList.add('hidden'); resultGrid && (resultGrid.innerHTML=''); resultInfo && (resultInfo.innerHTML='');
      err(''); renderFiles(); updateVisibility();
      if (pagesPanel) pagesPanel.innerHTML='';
      if (dropzone) dropzone.style.display='flex';
      segRadios.forEach(r=>{ if(r.value==='standard') r.checked=true; });
      if (qualitySelect) qualitySelect.value='standard';
      segAll?.classList.add('is-active'); segCustom?.classList.remove('is-active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    updateVisibility();
  }
</script>

