  .single-preview{ border:1px solid #E8E3DC; border-radius:12px; overflow:hidden; background:#fff; }
  .single-preview img{ width:100%; max-height:420px; object-fit:contain; display:block; }
  .single-actions{ margin-top:12px; display:flex; gap:8px; }
  @media (max-width:640px){ .single-actions{ flex-direction:column; } }
