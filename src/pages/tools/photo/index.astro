---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Sidebar from '../../../components/navigation/Sidebar.astro';
import CategoryChips from '../../../components/navigation/CategoryChips.astro';
import ToolCard from '../../../components/cards/ToolCard.astro';
import { getToolsByCategory } from '../../../data/tools.js';
import Disclaimer from '../../../components/ui/Disclaimer.astro';
const tools = getToolsByCategory('photo');
const currentPath = Astro.url.pathname;
---
<BaseLayout title="Photo & Image Tools — Passport Photos & Image Compressor | SolutionsNepal" description="Free photo tools: Nepal passport photo, passport size photo, visa photo, DV lottery photo, citizenship photo and image compressor.">
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
    <Breadcrumbs items={[{ label: 'Photo & Image' }]} />
    <div class="flex gap-10">
      <Sidebar currentPath={currentPath} />
      <main class="min-w-0 flex-1">
        <CategoryChips currentId="photo" />
        <div class="mb-8"><h1 class="text-3xl font-bold sm:text-4xl" style="color:var(--nk-text);">Photo & Image</h1><p class="mt-2 text-base" style="color:var(--nk-text-secondary);">Passport photos, ID photos and image compression — crop, resize and compress right in your browser.</p></div>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {tools.map((tool) => <ToolCard title={tool.title} description={tool.description} href={tool.href} />)}
        </div>
      </main>
    </div>
  </div>
  <Disclaimer variant="general" />
</BaseLayout>
