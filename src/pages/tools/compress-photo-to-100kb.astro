---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PassportPhotoResizer from '../../components/tools/PassportPhotoResizer.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';

const title = 'Compress Photo to 100 KB Online | SolutionsNepal';
const description = 'Compress any photo to 100 KB free. Smart quality search lands closest to 100 KB with optional ID-size cropping. In-browser.';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Compress Photo to 100KB', description: 'Compress any photo to 100 KB with smart quality search.', url: 'https://solutionsnepal.com/tools/compress-photo-to-100kb', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How do I compress a photo to 100 KB?', acceptedAnswer: { '@type': 'Answer', text: 'Upload your photo — the 100 KB target is already set. Crop if needed and download. The tool finds the highest quality that fits.' } },
    { '@type': 'Question', name: 'Will the quality be good enough for forms?', acceptedAnswer: { '@type': 'Answer', text: 'Yes for most online forms, job portals and government uploads. The tool maximises quality within the 100 KB limit.' } },
  ] },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumbs items={[{ label: 'Tools', href: '/tools' }, { label: 'Compress Photo to 100 KB' }]} />

    <div class="mb-5">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight" style="color:var(--nk-text);">Compress Photo to 100 KB</h1>
      <p class="mt-1 text-xs sm:text-sm" style="color:var(--nk-text-secondary);">Many government portals cap uploads at 100 KB — land right under it without wrecking your photo.</p>
    </div>

    <PassportPhotoResizer initialPreset="custom" initialTargetKB={100} />

    <div class="mt-10 space-y-8 max-w-3xl">
      <section>
        <h2 class="text-base font-bold" style="color:var(--nk-text);">Resize image to 100 KB — the smart way</h2>
        <p class="text-sm leading-relaxed mt-2" style="color:var(--nk-text-secondary);">
          Government job portals, exam forms and scholarship sites frequently reject files over 100 KB.
          Rather than guessing with a quality slider and re-exporting repeatedly, this tool measures real
          output sizes for you: it searches JPEG qualities at your photo's dimensions, and only if even the
          lowest sane quality stays above 100 KB does it gently step the resolution down (keeping aspect ratio)
          until the closest possible result is found.
        </p>
        <p class="text-sm leading-relaxed mt-2" style="color:var(--nk-text-secondary);">
          You can also crop to an ID format first — a tighter crop alone often halves the file size while
          improving compliance. Pick Passport, Visa, DV or Citizenship above, or keep Custom to resize any
          general photo to 100 KB.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold" style="color:var(--nk-text);">Good to know</h3>
        <ul class="text-sm leading-relaxed mt-2 space-y-1" style="color:var(--nk-text-secondary);">
          <li>• Output is measured in actual bytes — never estimated.</li>
          <li>• Your file will not come out at 20 KB when you asked for 100 KB.</li>
          <li>• The result can never be bigger than your original photo.</li>
          <li>• JPG output uses a white fill behind any transparency; choose PNG if you need alpha.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-base font-bold" style="color:var(--nk-text);">Frequently Asked Questions</h2>
        <div class="mt-3 space-y-2">
          <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
            <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">How do I make a picture exactly 100 KB?</summary>
            <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">Upload it here with the 100 KB target selected and download the result. The tool reports the exact final size — typically within a few percent of 100 KB.</p></div>
          </details>
          <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
            <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">What if my photo is already smaller than 100 KB?</summary>
            <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">Then you're done — no compression is needed, and the tool won't inflate or degrade it.</p></div>
          </details>
        </div>
      </section>

      <p class="text-sm" style="color:var(--nk-text-secondary);">
        Other targets: <a class="underline hover:opacity-80" href="/tools/compress-photo-to-50kb" style="color:var(--nk-accent);">50 KB</a> ·
        <a class="underline hover:opacity-80" href="/tools/compress-passport-photo-to-200kb" style="color:var(--nk-accent);">200 KB</a>.
      </p>
    </div>
  </div>
  <Disclaimer variant="general" />
</BaseLayout>
