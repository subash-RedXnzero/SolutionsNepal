---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../components/ui/RelatedTools.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import ImageConverter from '../../components/tools/ImageConverter.astro';

const faqItems = [
  {q:'What is WebP and why convert to it?',a:'WebP is a modern image format that is roughly 25–35% smaller than JPEG at the same visual quality, and unlike JPEG it supports transparency. All modern browsers, phones and social apps support it.'},
  {q:'Which formats can I convert from?',a:'JPG, PNG and existing WebP files. PNGs with transparency keep their transparency in the WebP output.'},
  {q:'What quality should I choose?',a:'90–92% is visually identical to the original for most photos. Drop to 75–80% for thumbnails and previews where every kilobyte counts.'},
  {q:'Is my image uploaded to a server?',a:'No. Conversion happens entirely in your browser. Your images never leave your device.'},
];
---

<BaseLayout
  title="JPG & PNG to WebP Converter | SolutionsNepal"
  description="Convert JPG and PNG images to WebP online for free. Files ~30% smaller at the same quality, with adjustable compression — in your browser, no upload."
  jsonLd={[{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Image to WebP Converter",
    "description": "Convert JPG and PNG images to WebP format free in your browser.",
    "url": "https://solutionsnepal.com/tools/webp-converter",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", priceCurrency: "NPR" }
  }, {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(item => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a }
    }))
  }]}
>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumbs items={[{label:"Tools",href:"/tools"},{label:"WebP Converter"}]} />

    <div class="mb-5">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight" style="color:var(--nk-text);">Image to WebP Converter</h1>
      <p class="mt-1 text-xs sm:text-sm" style="color:var(--nk-text-secondary);">Convert JPG & PNG to modern WebP — smaller files, same look, free in your browser.</p>
    </div>

    <ImageConverter
      fromLabel="JPG / PNG"
      fromMimes={["image/jpeg", "image/png", "image/webp"]}
      fromAccept="image/jpeg,image/png,image/webp"
      toMime="image/webp"
      toLabel="WebP"
      toExt="webp"
      defaultQuality={0.9}
      showQuality={true}
    />

    <p class="mt-3 text-center text-[10px]" style="color:var(--nk-text-secondary);">🔒 Your image is processed in your browser and is not uploaded to our server.</p>

    <div class="mt-8 space-y-5">
      <h2 class="text-base font-bold" style="color:var(--nk-text);">Why convert images to WebP</h2>
      <ul class="text-sm leading-relaxed space-y-1" style="color:var(--nk-text-secondary);">
        <li>• <strong style="color:var(--nk-text);">~30% smaller</strong> than JPEG at the same visual quality</li>
        <li>• <strong style="color:var(--nk-text);">Keeps transparency</strong> from PNGs, unlike JPG</li>
        <li>• <strong style="color:var(--nk-text);">Works everywhere</strong> — all modern browsers and phones</li>
      </ul>
      <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Need a classic JPG instead? Try our <a href="/tools/png-to-jpg" style="color:var(--nk-accent);">PNG to JPG converter</a>, or hit an exact file size with the <a href="/tools/image-compressor" style="color:var(--nk-accent);">image compressor</a>.</p>
    </div>

    <div class="mt-8 space-y-3">
      <h2 class="text-base font-bold" style="color:var(--nk-text);">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {faqItems.map(item => (
          <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
            <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">{item.q}</summary>
            <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>

    <Disclaimer variant="general" />
    <RelatedTools tools={[
      { title: 'JPG to PNG', description: 'Convert JPG photos to lossless PNG', href: '/tools/jpg-to-png' },
      { title: 'PNG to JPG', description: 'Convert PNG images to smaller JPG files', href: '/tools/png-to-jpg' },
      { title: 'Image Compressor', description: 'Shrink images to an exact KB target', href: '/tools/image-compressor' },
    ]} />
  </div>
</BaseLayout>
