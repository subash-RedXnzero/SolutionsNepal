---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import GuideCard from '../components/blog/GuideCard.astro';
import { getGuideCategories, getGuidesPrioritized } from '../data/guides.js';

// CONTENT: guides come from Guideedit/*.md (one file = one guide).
// DESIGN: card look lives in src/components/blog/GuideCard.astro.
// To add/edit a guide, edit the .md file only — never this page.

// Lead order: the important hand-picked guides (FEATURED_GUIDE_SLUGS in
// src/data/guides.js — same list that spotlights the homepage) render first,
// then the rest in library order. Category chips and counts count the whole
// library, so this reorder only changes which card leads.
const guides = getGuidesPrioritized();
const categories = getGuideCategories();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "SolutionsNepal Guides — Step-by-Step How-Tos for Nepal",
    "description": "Practical step-by-step guides for documents, money, vehicles, dates and daily life in Nepal.",
    "url": "https://solutionsnepal.com/guides",
    "numberOfItems": guides.length,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://solutionsnepal.com" },
      { "@type": "ListItem", "position": 2, "name": "Guides" }
    ]
  }
];
---

<BaseLayout
  title="Guides — Step-by-Step How-Tos for Nepal | SolutionsNepal"
  description="Practical step-by-step guides for documents, money, vehicles, dates and daily life in Nepal. Citizenship, passport, EMI, land registration and more."
  ogImage="/og-default.png"
  jsonLd={jsonLd}
>
  <div class="guides-layout">
    <Breadcrumbs items={[{ label: 'Guides' }]} />

    <header class="guides-header">
      <h1 class="guides-h1">Guides</h1>
      <p class="guides-sub">Step-by-step how-tos for documents, money, vehicles, dates and daily life in Nepal — written to be finished in one read.</p>
    </header>

    <div class="guides-filters" role="group" aria-label="Filter guides by topic">
      <button type="button" class="gd-chip gd-active" data-filter="all">All ({guides.length})</button>
      {categories.map(cat => (
        <button type="button" class="gd-chip" data-filter={cat.name}>{cat.name} ({cat.count})</button>
      ))}
    </div>

    <p class="guides-count" id="guides-count" aria-live="polite">Showing all {guides.length} guides</p>

    <div class="guides-grid" id="guides-grid">
      {guides.map(post => <GuideCard post={post} />)}
    </div>

    <p class="guides-cross">Looking for stories, rates and explainers? <a href="/blog">Visit the Blog →</a></p>
  </div>
</BaseLayout>

<script>
  (function () {
    const chips = Array.from(document.querySelectorAll('.gd-chip'));
    const cards = Array.from(document.querySelectorAll('.gd-card'));
    const count = document.getElementById('guides-count');
    if (!chips.length || !cards.length || !count) return;
    const total = cards.length;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.toggle('gd-active', c === chip));
        const f = chip.getAttribute('data-filter');
        let shown = 0;
        cards.forEach((card) => {
          const show = f === 'all' || card.getAttribute('data-category') === f;
          card.classList.toggle('hidden', !show);
          if (show) shown += 1;
        });
        count.textContent = f === 'all'
          ? `Showing all ${total} guides`
          : `Showing ${shown} of ${total} guides`;
      });
    });
  })();
</script>

<style>
  .guides-layout {
    max-width: 1400px;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: 28px clamp(20px, 3.5vw, 44px) 88px;
    overflow-x: clip;
  }
  .guides-header { margin: 12px 0 32px; max-width: 720px; }
  .guides-h1 {
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--nk-text);
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .guides-sub {
    font-size: 17px;
    color: var(--nk-text-secondary);
    max-width: 640px;
    line-height: 1.7;
    margin: 0;
    overflow-wrap: break-word;
  }
  .guides-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
    max-width: 100%;
  }
  .gd-chip {
    padding: 8px 18px;
    border-radius: 9999px;
    border: 1px solid var(--nk-border);
    background: var(--nk-surface);
    color: var(--nk-text-secondary);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
    min-height: 36px;
    max-width: 100%;
    overflow-wrap: break-word;
  }
  .gd-chip:hover { border-color: var(--nk-accent); color: var(--nk-accent); }
  .gd-chip.gd-active { background: var(--nk-accent); border-color: var(--nk-accent); color: #fff; font-weight: 600; }
  .guides-count { font-size: 13px; color: var(--nk-text-tertiary); margin: 0 0 24px; }
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    min-width: 0;
    max-width: 100%;
  }
  /* Card look lives in src/components/blog/GuideCard.astro */
  .guides-cross { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--nk-hairline); font-size: 15px; line-height: 1.7; color: var(--nk-text-secondary); }
  .guides-cross a { color: var(--nk-accent); font-weight: 600; text-decoration: none; }
  .guides-cross a:hover { text-decoration: underline; }

  @media (max-width: 1024px) {
    .guides-layout { padding: 24px 24px 72px; }
    .guides-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 640px) {
    .guides-layout { padding: 16px 16px 56px; }
    .guides-header { margin: 4px 0 20px; }
    .guides-h1 { font-size: 26px; }
    .guides-sub { font-size: 14px; }
    .guides-filters { gap: 8px; margin-bottom: 10px; }
    .gd-chip { padding: 7px 14px; font-size: 13px; min-height: 36px; }
    .guides-count { margin: 0 0 16px; }
    .guides-grid { grid-template-columns: 1fr; gap: 16px; }
    .guides-cross { margin-top: 32px; }
  }
  @media (max-width: 380px) {
    .guides-layout { padding: 12px 12px 48px; }
    .guides-h1 { font-size: 24px; }
  }
</style>
