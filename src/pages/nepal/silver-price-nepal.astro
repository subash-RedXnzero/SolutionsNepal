---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getSilverPriceAsync, getSilverPriceHistory, formatNPR, GRAMS_PER_TOLA } from '../../lib/nepal/silver-price.js';
import Disclaimer from '../../components/ui/Disclaimer.astro';

const priceData = await getSilverPriceAsync();
// FENEGOSIDA publishes today + yesterday only — the trend is those two
// real points. No fabricated multi-day history (see getSilverPriceHistory).
const trendHistory = getSilverPriceHistory();
---

<BaseLayout
  title="Silver Price Nepal — Live FENEGOSIDA Rate"
  description="Check today's live silver price in Nepal. FENEGOSIDA rates for silver per tola, gram, aana, and lal."
>

<div class="sp-wrap">
  <Breadcrumbs items={[
    { label: 'Nepal', href: '/nepal' },
    { label: 'Silver Price' },
  ]} />

  <!-- HEADER -->
  <div class="sp-header">
    <span class="sp-label">SILVER PRICE NEPAL</span>
    <h1 class="sp-title">Today's Silver Price</h1>
    <p class="sp-sub">Check the latest silver rate in Nepal.</p>
  </div>

  <!-- MAIN LAYOUT -->
  <div class="sp-layout">
  <div class="sp-main">
  <!-- MAIN PRICE CARD -->
  <div class="sp-price-card">
    <div class="sp-price-top">
      <span class="sp-price-type">Fine Silver</span>
      <span class="sp-price-updated" id="sp-updated">Updated today · {priceData.lastUpdatedTime}</span>
    </div>
    <div class="sp-price-main" id="sp-main-price">
      {formatNPR(priceData.silver.pricePerTola)}
    </div>
    <div class="sp-price-unit">per Tola</div>
    <div class="sp-price-change" id="sp-change">
      <span class={priceData.change.direction === 'up' ? 'sp-up' : 'sp-down'}>
        {priceData.change.direction === 'up' ? '↑' : '↓'} {formatNPR(priceData.change.amount)} today
      </span>
    </div>
  </div>

  <!-- SILVER RATE TABLE -->
  <div class="sp-section">
    <h2 class="sp-section-title">Silver Rate</h2>
    <div class="sp-rate-table">
      <div class="sp-rate-row">
        <span class="sp-rate-label">1 Tola</span>
        <span class="sp-rate-value" id="sp-v-tola">{formatNPR(priceData.silver.pricePerTola)}</span>
      </div>
      <div class="sp-rate-row">
        <span class="sp-rate-label">10 Gram</span>
        <span class="sp-rate-value" id="sp-v-10g">{formatNPR(priceData.silver.pricePer10Gram)}</span>
      </div>
      <div class="sp-rate-row">
        <span class="sp-rate-label">1 Gram</span>
        <span class="sp-rate-value" id="sp-v-gram">{formatNPR(priceData.silver.pricePerGram)}</span>
      </div>
    </div>

    <!-- More units (expandable) -->
    <details class="sp-more">
      <summary class="sp-more-toggle">More units</summary>
      <div class="sp-rate-table" style="margin-top: 8px;">
        <div class="sp-rate-row">
          <span class="sp-rate-label">1 Aana</span>
          <span class="sp-rate-value" id="sp-v-aana">{formatNPR(priceData.silver.pricePerAana)}</span>
        </div>
        <div class="sp-rate-row">
          <span class="sp-rate-label">1 Lal</span>
          <span class="sp-rate-value" id="sp-v-lal">{formatNPR(priceData.silver.pricePerLal)}</span>
        </div>
      </div>
    </details>
  </div>

  <!-- CALCULATOR -->
  <div class="sp-section">
    <h2 class="sp-section-title">Silver Calculator</h2>
    <div class="sp-calc">
      <div class="sp-calc-grid">
        <div>
          <label class="sp-calc-label">Weight</label>
          <input inputmode="decimal" type="number" id="sp-calc-weight" class="sp-calc-input" placeholder="1" min="0" step="0.01" />
        </div>
        <div>
          <label class="sp-calc-label">Unit</label>
          <select id="sp-calc-unit" class="sp-calc-select">
            <option value="tola">Tola</option>
            <option value="gram">Gram</option>
            <option value="10gram">10 Gram</option>
            <option value="aana">Aana</option>
            <option value="lal">Lal</option>
          </select>
        </div>
      </div>
      <div class="sp-calc-result">
        <span class="sp-calc-result-label">Estimated Value</span>
        <span class="sp-calc-result-value" id="sp-calc-value">{formatNPR(priceData.silver.pricePerTola)}</span>
        <span class="sp-calc-result-note">Calculated estimate</span>
      </div>
    </div>
  </div>

  </div><!-- /sp-main -->
  <aside class="sp-side" aria-label="Trend and comparison">
  <!-- YESTERDAY VS TODAY -->
  <div class="sp-section">
    <h2 class="sp-section-title">Yesterday vs Today</h2>
    <div class="sp-compare">
      <div class="sp-compare-item">
        <span class="sp-compare-label">Yesterday</span>
        <span class="sp-compare-price" id="sp-cmp-yesterday">{formatNPR(priceData.yesterday.pricePerTola)}</span>
      </div>
      <div class="sp-compare-arrow">
        <span class={priceData.change.direction === 'up' ? 'sp-up' : 'sp-down'}>
          {priceData.change.direction === 'up' ? '→' : '→'}
        </span>
      </div>
      <div class="sp-compare-item">
        <span class="sp-compare-label">Today</span>
        <span class="sp-compare-price sp-compare-today" id="sp-cmp-today">{formatNPR(priceData.silver.pricePerTola)}</span>
      </div>
    </div>
    <div class="sp-compare-change" id="sp-cmp-change">
      <span class={priceData.change.direction === 'up' ? 'sp-up' : 'sp-down'}>
        {priceData.change.direction === 'up' ? '↑' : '↓'} {formatNPR(priceData.change.amount)} ({priceData.change.percent}%)
      </span>
    </div>
  </div>

  <!-- CHART -->
  <div class="sp-section">
    <h2 class="sp-section-title">Silver Price Trend</h2>
    <p class="sp-chart-note">Yesterday → today · FENEGOSIDA publishes daily rates only, so the chart shows the two published points.</p>
    <div class="sp-chart-wrap">
      <canvas id="sp-chart" width="560" height="200"></canvas>
      <div class="sp-chart-tooltip" id="sp-tooltip" style="display:none;"></div>
    </div>
    <div class="sp-chart-legend">
      <span id="sp-chart-label">Yesterday → Today</span>
      <span id="sp-chart-range"></span>
    </div>
  </div>

  </aside><!-- /sp-side -->
  </div><!-- /sp-layout -->

  <!-- DATA SOURCE -->
  <div class="sp-section sp-source">
    <h2 class="sp-source-title">Where does this price come from?</h2>
    <p class="sp-source-text">{priceData.source}</p>
    <p class="sp-source-detail">Rate type: {priceData.rateType}</p>
    <p class="sp-source-detail" id="sp-source-updated">Last updated: Today · {priceData.lastUpdatedTime}</p>
  </div>

  <!-- RELATED TOOLS -->
  <div class="sp-section">
    <h2 class="sp-section-title">Related Tools</h2>
    <div class="sp-related">
      <a href="/nepal/gold-price-nepal" class="sp-related-link">Gold Price</a>
      <a href="/nepal/gold/tola-to-gram" class="sp-related-link">Tola → Gram</a>
      <a href="/nepal/gold/gram-to-tola" class="sp-related-link">Gram → Tola</a>
    </div>
  </div>

  <!-- HIDDEN DATA FOR JS -->
  <Disclaimer variant="price" />

  <script is:inline define:vars={{
    trendHistory: JSON.stringify(trendHistory),
    pricePerTola: priceData.silver.pricePerTola,
    pricePerGram: priceData.silver.pricePerGram,
  }}>
    window.__sp_data = {
      trendHistory: JSON.parse(trendHistory),
      pricePerTola: pricePerTola,
      pricePerGram: pricePerGram,
    };
  </script>
</div>

<style>
  /* ══════════════════════════════════════════════════════════════
     Silver Price Nepal — Clean, Trustworthy, Nepal-focused
     ══════════════════════════════════════════════════════════════ */

  .sp-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 16px 80px;
  }

  /* ── Two-column layout: content left, sticky tools right ── */
  .sp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 16px;
    align-items: start;
  }
  .sp-main { min-width: 0; }
  .sp-side { position: sticky; top: 20px; min-width: 0; }
  @media (max-width: 900px) {
    .sp-layout { grid-template-columns: 1fr; }
    .sp-side { position: static; }
  }

  /* ── HEADER ── */
  .sp-header { margin-bottom: 20px; }
  .sp-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #71717A;
    margin-bottom: 4px;
    display: block;
  }
  .sp-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--nk-text);
    margin: 0 0 4px;
  }
  .sp-sub {
    font-size: 13px;
    color: var(--nk-text-secondary);
  }

  /* ── MAIN PRICE CARD ── */
  .sp-price-card {
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    text-align: center;
  }
  .sp-price-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .sp-price-type {
    font-size: 12px;
    font-weight: 600;
    color: var(--nk-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sp-price-updated {
    font-size: 11px;
    color: var(--nk-text-tertiary);
  }
  .sp-price-main {
    font-size: 36px;
    font-weight: 700;
    color: var(--nk-text);
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .sp-price-unit {
    font-size: 13px;
    color: var(--nk-text-secondary);
    margin-bottom: 12px;
  }
  .sp-price-change {
    padding-top: 12px;
    border-top: 1px solid var(--nk-border);
  }
  .sp-up {
    color: #16A34A;
    font-size: 13px;
    font-weight: 600;
  }
  .sp-down {
    color: #DC2626;
    font-size: 13px;
    font-weight: 600;
  }

  /* ── SECTIONS ── */
  .sp-section { margin-bottom: 16px; }
  .sp-section-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--nk-text);
    margin: 0 0 10px;
  }

  /* ── RATE TABLE ── */
  .sp-rate-table {
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 10px;
    overflow: hidden;
  }
  .sp-rate-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--nk-border);
  }
  .sp-rate-row:last-child { border-bottom: none; }
  .sp-rate-label {
    font-size: 13px;
    color: var(--nk-text-secondary);
  }
  .sp-rate-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--nk-text);
    font-family: var(--font-mono);
  }

  /* More units */
  .sp-more { margin-top: 8px; }
  .sp-chart-note {
    margin: 0 0 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--nk-text-tertiary);
  }
  .sp-more-toggle {
    font-size: 12px;
    color: var(--nk-accent);
    cursor: pointer;
    padding: 8px 0;
    font-weight: 500;
  }
  .sp-more-toggle:hover { color: var(--nk-accent-hover); }

  /* ── COMPARE ── */
  .sp-compare {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 10px;
    padding: 16px;
  }
  .sp-compare-item { flex: 1; text-align: center; }
  .sp-compare-label {
    display: block;
    font-size: 11px;
    color: var(--nk-text-tertiary);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sp-compare-price {
    font-size: 16px;
    font-weight: 600;
    color: var(--nk-text);
    font-family: var(--font-mono);
  }
  .sp-compare-today { color: var(--nk-accent); }
  .sp-compare-arrow { font-size: 18px; flex-shrink: 0; }
  .sp-compare-change { text-align: center; margin-top: 8px; font-size: 13px; }

  /* ── CHART ── */
  .sp-chart-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    border: 1px solid var(--nk-border);
    border-radius: 8px;
    padding: 3px;
    background: var(--nk-muted);
  }
  .sp-chart-tab {
    flex: 1;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 500;
    font-family: var(--font-sans);
    border: none;
    background: transparent;
    color: var(--nk-text-secondary);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.1s ease;
  }
  .sp-chart-tab.active {
    background: var(--nk-surface);
    color: var(--nk-text);
    box-shadow: 0 1px 2px rgba(0,0,0,0.06);
  }
  .sp-chart-wrap {
    position: relative;
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 10px;
    padding: 16px;
    overflow: hidden;
  }
  .sp-chart-wrap canvas {
    width: 100% !important;
    height: auto !important;
  }
  .sp-chart-tooltip {
    position: absolute;
    background: var(--nk-text);
    color: var(--nk-surface);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-mono);
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    transform: translateX(-50%);
  }
  .sp-chart-legend {
    display: flex;
    justify-content: space-between;
    padding: 8px 0 0;
    font-size: 11px;
    color: var(--nk-text-tertiary);
  }

  /* ── CALCULATOR ── */
  .sp-calc {
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 10px;
    padding: 16px;
  }
  .sp-calc-row { margin-bottom: 12px; }
  .sp-calc-row:last-of-type { margin-bottom: 16px; }
  .sp-calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  .sp-calc-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--nk-text-secondary);
    margin-bottom: 6px;
  }
  .sp-calc-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid var(--nk-border);
    background: var(--nk-bg);
    color: var(--nk-text);
    font-size: 15px;
    font-family: var(--font-mono);
    font-weight: 600;
    box-sizing: border-box;
  }
  .sp-calc-input:focus { outline: none; border-color: var(--nk-accent); }
  .sp-calc-select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid var(--nk-border);
    background: var(--nk-bg);
    color: var(--nk-text);
    font-size: 13px;
    font-family: var(--font-sans);
    box-sizing: border-box;
    appearance: auto;
  }
  .sp-calc-result {
    text-align: center;
    padding: 16px;
    background: var(--nk-accent-subtle);
    border-radius: 8px;
  }
  .sp-calc-result-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: var(--nk-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .sp-calc-result-value {
    display: block;
    font-size: 24px;
    font-weight: 700;
    color: var(--nk-accent);
    font-family: var(--font-mono);
    line-height: 1.2;
  }
  .sp-calc-result-note {
    display: block;
    font-size: 10px;
    color: var(--nk-text-tertiary);
    margin-top: 4px;
  }

  /* ── SOURCE ── */
  .sp-source {
    background: var(--nk-surface);
    border: 1px solid var(--nk-border);
    border-radius: 10px;
    padding: 16px;
  }
  .sp-source-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--nk-text);
    margin: 0 0 8px;
  }
  .sp-source-text {
    font-size: 13px;
    color: var(--nk-text-secondary);
    margin-bottom: 4px;
  }
  .sp-source-detail {
    font-size: 12px;
    color: var(--nk-text-tertiary);
    margin-bottom: 2px;
  }

  /* ── RELATED ── */
  .sp-related { display: flex; gap: 8px; flex-wrap: wrap; }
  .sp-related-link {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--nk-text-secondary);
    border: 1px solid var(--nk-border);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.1s ease;
  }
  .sp-related-link:hover { border-color: var(--nk-accent); color: var(--nk-accent); }

  /* ── RESPONSIVE ── */
  @media (max-width: 480px) {
    .sp-wrap { padding: 16px 12px 60px; }
    .sp-price-main { font-size: 28px; }
    .sp-compare { flex-direction: column; gap: 8px; }
    .sp-compare-arrow { transform: rotate(90deg); }
    .sp-chart-tabs { flex-wrap: wrap; }
  }
</style>

<script is:inline>
(function() {
  var data = window.__sp_data;
  if (!data) return;

  var GRAMS_PER_TOLA = 11.6638125;

  function formatNPR(n) {
    if (n == null || isNaN(n)) return '—';
    return 'Rs. ' + n.toLocaleString('en-IN');
  }

  function calculateValue(weight, unit) {
    var ppt = data.pricePerTola;
    var tola;
    switch (unit) {
      case 'gram': tola = weight / GRAMS_PER_TOLA; break;
      case '10gram': tola = (weight * 10) / GRAMS_PER_TOLA; break;
      case 'aana': tola = weight / 12; break;
      case 'lal': tola = weight / 96; break;
      default: tola = weight;
    }
    return Math.round(tola * ppt);
  }

  // ── CALCULATOR ──
  var calcWeight = document.getElementById('sp-calc-weight');
  var calcUnit = document.getElementById('sp-calc-unit');
  var calcValue = document.getElementById('sp-calc-value');

  function updateCalc() {
    if (calcWeight.value.trim() === '') { calcValue.textContent = '—'; return; }
    var w = parseFloat(calcWeight.value) || 0;
    var u = calcUnit.value;
    var val = calculateValue(w, u);
    calcValue.textContent = formatNPR(val);
  }

  calcWeight.addEventListener('input', updateCalc);
  calcUnit.addEventListener('change', updateCalc);
  updateCalc(); // Empty weight at start: show placeholder until the user types

  // ── CHART ──
  var canvas = document.getElementById('sp-chart');
  var ctx = canvas.getContext('2d');
  var tooltip = document.getElementById('sp-tooltip');
  var chartLabel = document.getElementById('sp-chart-label');
  var chartRange = document.getElementById('sp-chart-range');
  // Single honest series: yesterday → today (the only points FENEGOSIDA publishes).
  var currentData = data.trendHistory;

  function drawChart(chartData) {
    if (!chartData || chartData.length === 0) return;

    var dpr = window.devicePixelRatio || 1;
    var rect = canvas.parentElement.getBoundingClientRect();
    var w = rect.width - 32;
    var h = 180;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.scale(dpr, dpr);

    ctx.clearRect(0, 0, w, h);

    var prices = chartData.map(function(d) { return d.price; });
    var min = Math.min.apply(null, prices) * 0.999;
    var max = Math.max.apply(null, prices) * 1.001;
    var range = max - min || 1;

    var padTop = 10;
    var padBottom = 24;
    var chartH = h - padTop - padBottom;
    var chartW = w;

    // Grid lines
    ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--nk-border').trim() || '#E5E7EB';
    ctx.lineWidth = 0.5;
    for (var i = 0; i < 4; i++) {
      var y = padTop + (chartH / 3) * i;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Line
    var isUp = prices[prices.length - 1] >= prices[0];
    var lineColor = isUp ? '#16A34A' : '#DC2626';
    var fillColor = isUp ? 'rgba(22, 163, 74, 0.08)' : 'rgba(220, 38, 38, 0.08)';

    ctx.beginPath();
    ctx.strokeStyle = lineColor;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';

    var points = [];
    for (var i = 0; i < chartData.length; i++) {
      var x = (i / (chartData.length - 1)) * chartW;
      var y = padTop + (1 - (chartData[i].price - min) / range) * chartH;
      points.push({ x: x, y: y, data: chartData[i] });
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Fill area
    ctx.lineTo(points[points.length - 1].x, padTop + chartH);
    ctx.lineTo(points[0].x, padTop + chartH);
    ctx.closePath();
    ctx.fillStyle = fillColor;
    ctx.fill();

    // Dots
    ctx.fillStyle = lineColor;
    ctx.beginPath();
    ctx.arc(points[0].x, points[0].y, 3, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(points[points.length - 1].x, points[points.length - 1].y, 3, 0, Math.PI * 2);
    ctx.fill();

    // Date labels
    ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--nk-text-tertiary').trim() || '#9CA3AF';
    ctx.font = '10px ' + (getComputedStyle(document.body).fontFamily || 'Poppins, sans-serif');
    ctx.textAlign = 'center';
    var labelCount = Math.min(5, chartData.length);
    for (var i = 0; i < labelCount; i++) {
      var idx = Math.round((i / (labelCount - 1)) * (chartData.length - 1));
      var d = new Date(chartData[idx].date);
      var label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      ctx.fillText(label, points[idx].x, h - 4);
    }

    // Price labels
    ctx.textAlign = 'right';
    ctx.fillText(formatNPR(Math.round(max)), w, padTop + 8);
    ctx.fillText(formatNPR(Math.round(min)), w, padTop + chartH - 2);

    // Legend
    chartLabel.textContent = 'Yesterday → Today';
    var first = chartData[0];
    var last = chartData[chartData.length - 1];
    chartRange.textContent = first.date + ' — ' + last.date;

    // Hover
    canvas.onmousemove = function(e) {
      var rect = canvas.getBoundingClientRect();
      var mx = e.clientX - rect.left;
      var closest = null;
      var minDist = Infinity;
      for (var i = 0; i < points.length; i++) {
        var dist = Math.abs(points[i].x - mx);
        if (dist < minDist) { minDist = dist; closest = points[i]; }
      }
      if (closest && minDist < 30) {
        tooltip.style.display = 'block';
        tooltip.style.left = closest.x + 16 + 'px';
        tooltip.style.top = (closest.y - 10) + 'px';
        var d = new Date(closest.data.date);
        tooltip.innerHTML = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + '<br>' + formatNPR(closest.data.price);
      } else {
        tooltip.style.display = 'none';
      }
    };
    canvas.onmouseleave = function() {
      tooltip.style.display = 'none';
    };
  }

  // Initial draw (single honest yesterday → today series)
  drawChart(currentData);

  var resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() { drawChart(currentData); }, 150);
  });

  // ── LIVE REFRESH (stays live after hosting) ──
  // The baked snapshot freezes at build time. This same-origin worker route
  // re-fetches FENEGOSIDA at the edge (cached 6h). On success every number,
  // the change block and the calculator rate update to live values.
  // Any failure keeps the baked snapshot silently — never an error state.
  (function refreshLiveSilver() {
    function nptTime(iso) {
      try {
        return new Date(iso).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kathmandu' });
      } catch (e) { return ''; }
    }
    function setText(id, txt) {
      var el = document.getElementById(id);
      if (el) el.textContent = txt;
    }
    var ctl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
    var kill = setTimeout(function () { if (ctl) ctl.abort(); }, 8000);
    function done() { clearTimeout(kill); }
    fetch('/api/live/metals', ctl ? { signal: ctl.signal } : {})
      .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
      .then(function (j) {
        done();
        var s = j && j.ok && j.data && j.data.silver;
        if (!s || !isFinite(s.pricePerTola) || s.pricePerTola <= 0) return;
        var tola = Math.round(s.pricePerTola);
        var gram = Math.round(tola / GRAMS_PER_TOLA);
        var yest = (isFinite(s.yesterdayPricePerTola) && s.yesterdayPricePerTola > 0) ? Math.round(s.yesterdayPricePerTola) : null;
        var diff = (yest == null) ? 0 : tola - yest;
        var dirUp = diff >= 0;
        var pct = yest ? Math.round((Math.abs(diff) / yest) * 100 * 100) / 100 : 0;
        var when = j.fetchedAt ? nptTime(j.fetchedAt) : '';
        var stamp = when ? 'Live · ' + when : 'Live';
        setText('sp-main-price', formatNPR(tola));
        var chg = document.getElementById('sp-change');
        if (chg) chg.innerHTML = '<span class="' + (dirUp ? 'sp-up' : 'sp-down') + '">' + (dirUp ? '↑ ' : '↓ ') + formatNPR(diff) + ' today</span>';
        setText('sp-v-tola', formatNPR(tola));
        setText('sp-v-10g', formatNPR(gram * 10));
        setText('sp-v-gram', formatNPR(gram));
        setText('sp-v-aana', formatNPR(Math.round(tola / 12)));
        setText('sp-v-lal', formatNPR(Math.round(tola / 96)));
        setText('sp-cmp-yesterday', yest == null ? '—' : formatNPR(yest));
        setText('sp-cmp-today', formatNPR(tola));
        var cmp = document.getElementById('sp-cmp-change');
        if (cmp) cmp.innerHTML = '<span class="' + (dirUp ? 'sp-up' : 'sp-down') + '">' + (dirUp ? '↑ ' : '↓ ') + formatNPR(diff) + ' (' + pct + '%)</span>';
        setText('sp-updated', stamp);
        setText('sp-source-updated', 'Last updated: ' + stamp);
        // Calculator + future interactions use the live rate.
        data.pricePerTola = tola;
        data.pricePerGram = gram;
        if (calcWeight.value.trim() !== '') updateCalc();
      }, function () { done(); });
  })();
})();
</script>
</BaseLayout>
