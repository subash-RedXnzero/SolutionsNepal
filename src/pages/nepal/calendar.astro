    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--cal-radius-sm);
    border: 1px solid var(--cal-border);
    background: var(--cal-card);
    color: var(--cal-text-2);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .cal-nav-btn:hover {
    background: var(--cal-hover);
    color: var(--cal-text);
    border-color: var(--cal-border-2);
  }
  .cal-dropdown-btn {
    width: 28px;
    height: 28px;
  }

  /* ── आज Button ── */
  /* Same bordered family as .cal-nav-btn — one button look, not a pill outlier */
  .cal-today-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 14px;
    border-radius: var(--cal-radius-sm);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-nepali);
    border: 1px solid var(--cal-border);
    background: var(--cal-card);
    color: var(--cal-text-2);
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    line-height: 1;
    flex-shrink: 0;
  }
  .cal-today-btn:hover {
    background: var(--cal-hover);
    color: var(--cal-text);
    border-color: var(--cal-border-2);
  }

  /* ── Month Picker ── */
  .cal-month-picker {
    position: absolute;
    z-index: 20;
    background: var(--cal-card);
    border: 1px solid var(--cal-border);
    border-radius: var(--cal-radius);
    box-shadow: var(--cal-shadow-md);
    padding: 14px;
    top: 60px;
    left: 56px;
  }
  .cal-month-picker.hidden { display: none; }
  .cal-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .cal-picker-year {
    font-size: 14px;
    font-weight: 600;
    color: var(--cal-text);
    font-family: var(--font-nepali);
  }
  .cal-picker-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
  }
  .cal-picker-month {
    padding: 8px 8px;
    border: 1px solid var(--cal-border);
    border-radius: var(--cal-radius-sm);
    background: var(--cal-card);
    color: var(--cal-text);
    font-size: 12px;
    font-family: var(--font-nepali);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }
  .cal-picker-month:hover {
    background: var(--cal-hover);
    border-color: var(--cal-border-2);
  }
  .cal-picker-month.active {
    background: var(--cal-red);
    color: #FFFFFF;
    border-color: var(--cal-red);
  }

  /* ═══════════════════════════════════════════════════════════════
     Weekday Headers
     ═══════════════════════════════════════════════════════════════ */
  .cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-bottom: 1px solid var(--cal-border);
  }
  .cal-weekday {
    padding: 10px 2px;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--cal-text-2);
    font-family: var(--font-nepali);
    white-space: nowrap;
    letter-spacing: 0.04em;
    overflow: hidden;
    min-width: 0;
  }
  .cal-weekday-sat {
    color: var(--cal-red);
  }
  .cal-weekday-short {
    display: none;
  }

  /* ═══════════════════════════════════════════════════════════════
     Calendar Grid
