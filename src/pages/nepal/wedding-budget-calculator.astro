  #res-total { font-size: 30px; font-weight: 700; letter-spacing: -.02em; line-height: 1.15; }
  .res-hero-sub { font-size: 11px; margin-top: 2px; opacity: .85; }
  .stat-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .stat-tile {
    border: 1px solid var(--nk-border); border-radius: var(--radius-lg);
