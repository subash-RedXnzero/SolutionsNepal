  .kv-row strong { color: var(--nk-text); font-weight: 600; white-space: nowrap; }
  .tabular-nums { font-variant-numeric: tabular-nums; }
  .top-bar { height: 6px; border-radius: 9999px; background-color: var(--nk-hover); overflow: hidden; margin-top: 3px; }
  .top-fill { height: 100%; border-radius: 9999px; background: var(--nk-gradient-primary); }
  .tip-line {
    border-radius: 8px; padding: 8px 12px; font-size: 11.5px; line-height: 1.6;
    background-color: var(--nk-hover); border: 1px solid var(--nk-border);
    color: var(--nk-text-secondary);
  }
  .tip-line strong { color: var(--nk-text); }
  /* NOTE: warning lines are created by JS at runtime — keep :global(). */
  :global(.warn-line) {
    border-radius: 8px; padding: 8px 12px; font-size: 11px; line-height: 1.55;
    background-color: #fef3cd; border: 1px solid #ffc107; color: #856404;
  }
  :global([data-theme="dark"] .warn-line) { background-color: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.3); color: #fbbf24; }
  .alloc-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
    padding: 3px 0; border-bottom: 1px dashed var(--nk-border);
  }
  .alloc-row:last-child { border-bottom: none; }
  @media print {
    #input-card, .nk-btn, .seg-wrap { display: none !important; }
    #result-card { border: 1px solid #999; }
  }
</style>

<script>
  import {
    calculateWeddingBudget, suggestBudgetAllocation,
    formatNPR, formatNumberIN, parseAmount, sanitizeGuests,
  } from '../../lib/calculators/wedding-budget.js';
  import {
    BUDGET_ALLOCATION, STORAGE_KEY, WEDDING_EXPENSE_KEYS, WEDDING_LABELS,
  } from '../../data/wedding-budget.js';

  const $ = (id) => document.getElementById(id);
  const EXP_KEYS = WEDDING_EXPENSE_KEYS;

  let mode = 'estimate';
  let venueMode = 'total';
  let bufferChoice = 5; // number or 'custom'

  // ── Mode ──
  const modeCards = [...document.querySelectorAll('.seg-btn[data-mode]')];
  function setMode(m) {
    mode = m;
    modeCards.forEach((c) => {
      const on = c.dataset.mode === m;
      c.classList.toggle('seg-active', on);
      c.setAttribute('aria-checked', String(on));
    });
    $('budget-panel').classList.toggle('hidden', m !== 'budget');
  }
  modeCards.forEach((c) => c.addEventListener('click', () => setMode(c.dataset.mode)));

  // ── Guests ──
  document.querySelectorAll('[data-guests]').forEach((b) => b.addEventListener('click', () => {
    $('guests').value = b.dataset.guests;
    document.querySelectorAll('[data-guests]').forEach((x) => x.classList.toggle('quick-active', x === b));
    updateCateringPreview();
  }));
  $('guests').addEventListener('input', updateCateringPreview);

  // ── Events ──
  function selectedEvents() {
    return [...document.querySelectorAll('.event-chip.chip-active')].map((c) => c.dataset.event);
  }
  function toggleEvent(chip, force) {
    const on = force !== undefined ? force : !chip.classList.contains('chip-active');
    chip.classList.toggle('chip-active', on);
    chip.setAttribute('aria-checked', String(on));
    const row = document.querySelector(`[data-erow="${chip.dataset.event}"]`);
    if (row) row.classList.toggle('hidden', !on);
    updateCateringPreview();
  }
  document.querySelectorAll('.event-chip').forEach((chip) => {
    chip.addEventListener('click', () => toggleEvent(chip));
  });
  document.querySelectorAll('.event-g-input').forEach((el) => {
    el.addEventListener('input', updateCateringPreview);
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doCalc(); });
  });

  // ── Meal styles ──
  document.querySelectorAll('[data-meal]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-meal]').forEach((x) => x.classList.toggle('quick-active', x === b));
    if (b.dataset.example !== '') $('per-guest').value = Number(b.dataset.example).toLocaleString('en-IN');
    else $('per-guest').focus();
    updateCateringPreview();
  }));
  $('per-guest').addEventListener('input', updateCateringPreview);

  function cateringNumbers() {
    const main = sanitizeGuests($('guests').value);
    const sel = selectedEvents();
    let guestNights = 0;
    if (sel.length === 0) {
      guestNights = main;
    } else {
      guestNights = sel.reduce((s, id) => {
        const raw = document.querySelector(`[data-event-g="${id}"]`);
        const g = raw && String(raw.value).trim() !== '' ? sanitizeGuests(raw.value) : main;
        return s + g;
      }, 0);
    }
    const per = parseAmount($('per-guest').value);
    const perGuest = per.value == null ? 0 : per.value;
    return { guestNights, perGuest };
  }

  function updateCateringPreview() {
    const { guestNights, perGuest } = cateringNumbers();
    const el = $('catering-preview');
    if (!el) return;
    if (guestNights > 0 && perGuest > 0) {
      el.textContent = `${formatNumberIN(guestNights)} guests × ${formatNPR(perGuest)} = ${formatNPR(guestNights * perGuest)}`;
    } else {
      el.textContent = 'Enter guests and cost per guest to preview';
    }
  }

  // ── Venue mode ──
  document.querySelectorAll('[data-vmode]').forEach((b) => b.addEventListener('click', () => {
    venueMode = b.dataset.vmode;
    document.querySelectorAll('[data-vmode]').forEach((x) => x.classList.toggle('unit-active', x === b));
    $('venue-total-wrap').classList.toggle('hidden', venueMode !== 'total');
    $('venue-perevent-wrap').classList.toggle('hidden', venueMode !== 'per-event');
  }));

  // ── Buffer ──
  document.querySelectorAll('[data-buffer]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-buffer]').forEach((x) => x.classList.toggle('quick-active', x === b));
    const v = b.dataset.buffer;
    bufferChoice = v === 'custom' ? 'custom' : Number(v);
    const custom = bufferChoice === 'custom';
    $('buffer-custom-wrap').classList.toggle('hidden', !custom);
    $('buffer-custom-wrap').classList.toggle('items-center', custom);
    if (!custom) $('buffer-percent').value = String(bufferChoice);
  }));
  $('buffer-toggle').addEventListener('change', () => {
    $('buffer-controls').style.opacity = $('buffer-toggle').checked ? '1' : '0.45';
  });

  // ── Include / exclude ──
  document.querySelectorAll('.inc-box').forEach((cb) => cb.addEventListener('change', () => {
    const note = document.querySelector(`[data-excluded-note="${cb.dataset.key}"]`);
    if (note) note.classList.toggle('hidden', cb.checked);
  }));

  // ── Budget-first allocation ──
  function setExpense(key, amount) {
    const input = $(`exp-${key}`);
    if (input) input.value = Math.round(amount).toLocaleString('en-IN');
    const inc = $(`inc-${key}`);
    if (inc && !inc.checked) {
      inc.checked = true;
      const note = document.querySelector(`[data-excluded-note="${key}"]`);
      if (note) note.classList.add('hidden');
    }
  }

  $('alloc-generate').addEventListener('click', () => {
    const err = $('err-alloc');
    err.classList.add('hidden');
    const { value, error } = parseAmount($('alloc-budget').value);
    if (error || value == null || value <= 0) {
      err.textContent = error || 'Enter your total budget — a number above zero.';
      err.classList.remove('hidden');
      return;
    }
    let rows;
    try {
      rows = suggestBudgetAllocation(value);
    } catch (e) {
      err.textContent = e.message;
      err.classList.remove('hidden');
      return;
    }
    const guests = sanitizeGuests($('guests').value) || 0;
    const byId = Object.fromEntries(rows.map((r) => [r.id, r]));
    // Map allocation rows onto real inputs (all editable afterwards).
    if (guests > 0) $('per-guest').value = Math.round(byId.catering.amount / guests).toLocaleString('en-IN');
    document.querySelectorAll('[data-meal]').forEach((x) => x.classList.toggle('quick-active', x.dataset.meal === 'custom'));
    if (venueMode === 'total') $('venue-total').value = Math.round(byId.venue.amount).toLocaleString('en-IN');
    else $('venue-perevent').value = Math.round(byId.venue.amount).toLocaleString('en-IN');
    setExpense('decoration', byId.decoration.amount);
    setExpense('jewellery', byId.jewellery.amount);
    setExpense('bridalClothing', byId.clothing.amount * 0.7);
    setExpense('groomClothing', byId.clothing.amount * 0.3);
    setExpense('photography', byId.photography.amount);
    setExpense('makeup', byId.makeup.amount);
    setExpense('coupleTransport', byId.transport.amount);
    setExpense('miscellaneous', byId.other.amount);
    $('target-budget').value = Math.round(value).toLocaleString('en-IN');
    $('alloc-table').innerHTML = rows.map((r) =>
      `<div class="alloc-row"><span style="color:var(--nk-text-secondary);">${r.label} (${r.percent}%)</span><strong style="color:var(--nk-text);">${formatNPR(r.amount)}</strong></div>`
    ).join('');
    $('alloc-table').classList.remove('hidden');
    updateCateringPreview();
    doCalc();
  });

  // ── Collect + calculate ──
  let lastResult = null;
  let lastSummary = '';

  function collectInput() {
    const main = $('guests').value;
    const mainGuests = sanitizeGuests(main);
    const events = selectedEvents().map((id) => {
      const raw = document.querySelector(`[data-event-g="${id}"]`);
      const g = raw && String(raw.value).trim() !== '' ? raw.value : main;
      return { id, guests: g };
    });
    const expenses = {};
    for (const key of EXP_KEYS) {
      const input = $(`exp-${key}`);
      expenses[key] = input ? input.value : '';
    }
    const excluded = [...document.querySelectorAll('.inc-box')]
      .filter((cb) => !cb.checked)
      .map((cb) => cb.dataset.key);
    const bufferPct = bufferChoice === 'custom'
      ? parseFloat(String($('buffer-percent').value).replace(/,/g, '')) || 0
      : Number(bufferChoice);
    return {
      guests: main,
      events,
      cateringPerGuest: $('per-guest').value,
      venue: {
        mode: venueMode,
        total: $('venue-total').value,
        perEvent: $('venue-perevent').value,
      },
      expenses,
      excluded,
      emergencyBuffer: { enabled: $('buffer-toggle').checked, percent: bufferPct },
      targetBudget: $('target-budget').value,
      meta: { mainGuests, province: $('province').value, city: $('city').value },
    };
  }

  function rowHTML(label, value, muted) {
    return `<div class="result-row"><span>${label}</span><span class="${muted ? 'rv-muted' : 'rv'}">${value}</span></div>`;
  }

  function doCalc() {
    const input = collectInput();
    const r = calculateWeddingBudget(input);
    lastResult = { input, r };
    render(input, r);
  }

  function render(input, r) {
    $('res-empty').classList.add('hidden');
    $('res-body').classList.remove('hidden');

    $('res-total').textContent = formatNPR(r.total);
    $('res-total-2').textContent = formatNPR(r.total);
    const parts = [];
    if (input.meta.city) parts.push(input.meta.city);
    if (r.guestDivisor > 0) parts.push(`${formatNumberIN(r.guestDivisor)} guests`);
    $('res-subline').textContent = parts.join(' · ') || 'Your wedding estimate';

    $('res-perguest').textContent = r.guestDivisor > 0 ? formatNPR(r.costPerGuest) : '—';
    $('res-count').textContent = r.categoryBreakdown.length > 0 ? String(r.categoryBreakdown.length) : '—';

    $('res-rows').innerHTML = r.categoryBreakdown.length > 0
      ? r.categoryBreakdown.map((b) => rowHTML(b.name, formatNPR(b.amount), false)).join('')
      : rowHTML('No expenses entered yet', 'Enter amounts on the left', true);

    const bufRow = $('res-buffer-row');
    if (r.emergencyBuffer > 0) {
      bufRow.classList.remove('hidden');
      $('res-buffer').textContent = `${formatNPR(r.emergencyBuffer)} (${r.bufferPercent}%)`;
    } else {
      bufRow.classList.add('hidden');
    }

    // Budget status — clear text, not only color.
    const box = $('res-budget-box');
    if (r.budgetDifference) {
      box.classList.remove('hidden');
      const d = r.budgetDifference;
      const status = d.status === 'over'
        ? `<div class="kv-row"><span>Over budget</span><strong style="color:#DC2626;">${formatNPR(d.difference)}</strong></div>`
        : d.status === 'under'
          ? `<div class="kv-row"><span>Under budget</span><strong style="color:#059669;">${formatNPR(Math.abs(d.difference))}</strong></div>`
          : `<div class="kv-row"><span>On budget</span><strong>Exactly on target</strong></div>`;
      $('budget-rows').innerHTML =
        `<div class="kv-row"><span>Your budget</span><strong>${formatNPR(d.budget)}</strong></div>` +
        `<div class="kv-row"><span>Estimated cost</span><strong>${formatNPR(d.estimated)}</strong></div>` +
        status;
    } else {
      box.classList.add('hidden');
    }

    // Biggest expenses — simple horizontal breakdown.
    const max = r.topExpenses.length > 0 ? r.topExpenses[0].amount : 0;
    $('res-top').innerHTML = r.topExpenses.length > 0
      ? r.topExpenses.map((b, i) => {
          const pct = max > 0 ? Math.max(4, Math.round((b.amount / max) * 100)) : 0;
          return `<div><div class="result-row" style="padding-bottom:0;"><span>${i + 1}. ${b.name}</span><span class="rv">${formatNPR(b.amount)}</span></div><div class="top-bar"><div class="top-fill" style="width:${pct}%;"></div></div></div>`;
        }).join('')
      : rowHTML('Nothing to rank yet', 'Enter amounts on the left', true);

    // Savings suggestions — mathematical observations only.
    const tips = [];
    if (r.cateringGuests > 50 && r.cateringCost > 0) {
      const per = r.cateringGuests > 0 ? r.cateringCost / r.cateringGuests : 0;
      if (per > 0) {
        tips.push(`You have ${formatNumberIN(r.cateringGuests)} guest-meals planned. Reducing the guest count by 50 could reduce catering costs by approximately <strong>${formatNPR(50 * per)}</strong>.`);
      }
    }
    const jew = r.categoryBreakdown.find((b) => b.id === 'jewellery');
    if (jew && jew.amount > 0) {
      const lead = r.topExpenses[0] && r.topExpenses[0].id === 'jewellery'
        ? 'Your jewellery budget is one of your largest expenses. '
        : 'Your jewellery budget is a large part of this plan. ';
      tips.push(`${lead}Reducing this category by 10% would save approximately <strong>${formatNPR(jew.amount * 0.1)}</strong>.`);
    }
    const big = r.topExpenses[0];
    if (big && big.id !== 'jewellery' && big.amount > 0) {
      tips.push(`Your largest expense is <strong>${big.name} (${formatNPR(big.amount)})</strong>. Reducing it by 10% would save approximately <strong>${formatNPR(big.amount * 0.1)}</strong>.`);
    }
    const tipsWrap = $('res-tips-wrap');
    if (tips.length > 0) {
      tipsWrap.classList.remove('hidden');
      $('res-tips').innerHTML = tips.slice(0, 3).map((t) => `<div class="tip-line">${t}</div>`).join('');
    } else {
      tipsWrap.classList.add('hidden');
    }

    const warnBox = $('res-warnings');
    warnBox.innerHTML = '';
    warnBox.classList.toggle('hidden', r.warnings.length === 0);
    r.warnings.forEach((w) => {
      const d = document.createElement('div');
      d.className = 'warn-line';
      d.textContent = w;
      warnBox.appendChild(d);
    });

    buildSummary(input, r);
    document.querySelector('#result-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function eventLabel(id) {
    const map = { engagement: 'Engagement', mehendi: 'Mehendi', sangeet: 'Sangeet', wedding: 'Wedding ceremony', reception: 'Reception', other: 'Other' };
    return map[id] || id;
  }

  function buildSummary(input, r) {
    const lines = ['SolutionsNepal — Wedding Budget'];
    lines.push(`Guests: ${input.meta.mainGuests > 0 ? formatNumberIN(input.meta.mainGuests) : '—'}`);
    if (input.meta.city || input.meta.province) lines.push(`Location: ${[input.meta.city, input.meta.province].filter(Boolean).join(', ')}`);
    if (input.events.length > 0) {
      lines.push(`Events: ${input.events.map((e) => `${eventLabel(e.id)} (${formatNumberIN(sanitizeGuests(e.guests))})`).join(' + ')}`);
    }
    lines.push(`Estimated total: ${formatNPR(r.total)}`);
    if (r.guestDivisor > 0) lines.push(`Cost per guest: ${formatNPR(r.costPerGuest)}`);
    lines.push('Category breakdown:');
    r.categoryBreakdown.forEach((b) => lines.push(`- ${b.name}: ${formatNPR(b.amount)}`));
    if (r.emergencyBuffer > 0) lines.push(`Emergency buffer (${r.bufferPercent}%): ${formatNPR(r.emergencyBuffer)}`);
    if (r.budgetDifference) {
      const d = r.budgetDifference;
      lines.push(`Budget: ${formatNPR(d.budget)} — ${d.status === 'over' ? `Over budget by ${formatNPR(d.difference)}` : d.status === 'under' ? `Under budget by ${formatNPR(Math.abs(d.difference))}` : 'Exactly on budget'}`);
    }
    lastSummary = lines.join('\n');
  }

  $('calc-btn').addEventListener('click', doCalc);
  ['guests', 'per-guest', 'venue-total', 'venue-perevent', 'target-budget', 'alloc-budget'].forEach((id) => {
    const el = $(id);
    if (el) el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doCalc(); });
  });
  document.querySelectorAll('.exp-input').forEach((el) => {
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doCalc(); });
  });

  // ── Print / copy ──
  $('print-btn').addEventListener('click', () => window.print());
  $('copy-btn').addEventListener('click', async () => {
    const btn = $('copy-btn');
    try {
      await navigator.clipboard.writeText(lastSummary || 'SolutionsNepal — Wedding Budget');
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.innerHTML = 'Copy summary'; }, 2000);
    } catch { /* clipboard unavailable */ }
  });

  // ── Reset / save (localStorage only — never sent to a server) ──
  function snapshot() {
    const snap = { mode, venueMode, bufferChoice };
    ['province', 'city', 'guests', 'per-guest', 'venue-total', 'venue-perevent', 'buffer-percent', 'target-budget', 'alloc-budget'].forEach((id) => {
      const el = $(id);
      snap[id] = el ? el.value : '';
    });
    snap.bufferOn = $('buffer-toggle').checked;
    snap.events = [...document.querySelectorAll('.event-chip')].map((c) => ({
      id: c.dataset.event,
      on: c.classList.contains('chip-active'),
      guests: (document.querySelector(`[data-event-g="${c.dataset.event}"]`) || {}).value || '',
    }));
    snap.meal = (document.querySelector('[data-meal].quick-active') || {}).dataset?.meal || 'custom';
    snap.expenses = {};
    snap.included = {};
    for (const key of EXP_KEYS) {
      const input = $(`exp-${key}`);
      const inc = $(`inc-${key}`);
      snap.expenses[key] = input ? input.value : '';
      snap.included[key] = inc ? inc.checked : true;
    }
    return snap;
  }

  function restore(snap) {
    if (!snap || typeof snap !== 'object') return false;
    setMode(snap.mode === 'budget' ? 'budget' : 'estimate');
    const setVal = (id, v) => { const el = $(id); if (el && v !== undefined) el.value = v; };
    ['province', 'city', 'guests', 'per-guest', 'venue-total', 'venue-perevent', 'buffer-percent', 'target-budget', 'alloc-budget'].forEach((id) => setVal(id, snap[id]));
    if (snap.venueMode) {
      venueMode = snap.venueMode;
      document.querySelectorAll('[data-vmode]').forEach((x) => x.classList.toggle('unit-active', x.dataset.vmode === venueMode));
      $('venue-total-wrap').classList.toggle('hidden', venueMode !== 'total');
      $('venue-perevent-wrap').classList.toggle('hidden', venueMode !== 'per-event');
    }
    if (snap.bufferChoice !== undefined) {
      bufferChoice = snap.bufferChoice;
      document.querySelectorAll('[data-buffer]').forEach((x) => x.classList.toggle('quick-active', String(x.dataset.buffer) === String(bufferChoice)));
      const custom = bufferChoice === 'custom';
      $('buffer-custom-wrap').classList.toggle('hidden', !custom);
    }
    if (snap.bufferOn !== undefined) {
      $('buffer-toggle').checked = !!snap.bufferOn;
      $('buffer-controls').style.opacity = snap.bufferOn ? '1' : '0.45';
    }
    if (Array.isArray(snap.events)) {
      snap.events.forEach((e) => {
        const chip = document.querySelector(`.event-chip[data-event="${e.id}"]`);
        if (chip) {
          chip.classList.toggle('chip-active', !!e.on);
          chip.setAttribute('aria-checked', String(!!e.on));
        }
        const row = document.querySelector(`[data-erow="${e.id}"]`);
        if (row) row.classList.toggle('hidden', !e.on);
        const g = document.querySelector(`[data-event-g="${e.id}"]`);
        if (g && e.guests !== undefined) g.value = e.guests;
      });
    }
    if (snap.meal) {
      document.querySelectorAll('[data-meal]').forEach((x) => x.classList.toggle('quick-active', x.dataset.meal === snap.meal));
    }
    for (const key of EXP_KEYS) {
      if (snap.expenses && snap.expenses[key] !== undefined) {
        const input = $(`exp-${key}`);
        if (input) input.value = snap.expenses[key];
      }
      if (snap.included && snap.included[key] !== undefined) {
        const inc = $(`inc-${key}`);
        if (inc) inc.checked = !!snap.included[key];
        const note = document.querySelector(`[data-excluded-note="${key}"]`);
        if (note) note.classList.toggle('hidden', !!snap.included[key]);
      }
    }
    return true;
  }

  $('reset-btn').addEventListener('click', () => {
    try { localStorage.removeItem(STORAGE_KEY); } catch { /* private mode */ }
    setMode('estimate');
    $('province').value = '';
    $('city').value = '';
    $('guests').value = '300';
    $('per-guest').value = '2,000';
    $('venue-total').value = '';
    $('venue-perevent').value = '';
    $('target-budget').value = '';
    $('alloc-budget').value = '';
    $('alloc-table').classList.add('hidden');
    $('alloc-table').innerHTML = '';
    $('buffer-toggle').checked = true;
    $('buffer-controls').style.opacity = '1';
    bufferChoice = 5;
    $('buffer-percent').value = '5';
    document.querySelectorAll('[data-buffer]').forEach((x) => x.classList.toggle('quick-active', x.dataset.buffer === '5'));
    $('buffer-custom-wrap').classList.add('hidden');
    venueMode = 'total';
    document.querySelectorAll('[data-vmode]').forEach((x) => x.classList.toggle('unit-active', x.dataset.vmode === 'total'));
    $('venue-total-wrap').classList.remove('hidden');
    $('venue-perevent-wrap').classList.add('hidden');
    document.querySelectorAll('.event-chip').forEach((chip) => {
      const on = chip.dataset.event === 'wedding';
      chip.classList.toggle('chip-active', on);
      chip.setAttribute('aria-checked', String(on));
      const row = document.querySelector(`[data-erow="${chip.dataset.event}"]`);
      if (row) row.classList.toggle('hidden', !on);
    });
    document.querySelectorAll('.event-g-input').forEach((el) => { el.value = ''; });
    document.querySelectorAll('[data-meal]').forEach((x) => x.classList.toggle('quick-active', x.dataset.meal === 'standard'));
    document.querySelectorAll('[data-guests]').forEach((x) => x.classList.toggle('quick-active', x.dataset.guests === '300'));
    for (const key of EXP_KEYS) {
      const input = $(`exp-${key}`);
      if (input) input.value = '';
      const inc = $(`inc-${key}`);
      if (inc) inc.checked = true;
      const note = document.querySelector(`[data-excluded-note="${key}"]`);
      if (note) note.classList.add('hidden');
    }
    $('res-body').classList.add('hidden');
    $('res-empty').classList.remove('hidden');
    lastResult = null;
    updateCateringPreview();
  });

  $('save-btn').addEventListener('click', () => {
    const btn = $('save-btn');
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot()));
      btn.textContent = 'Saved!';
      setTimeout(() => { btn.innerHTML = 'Save this budget'; }, 2000);
    } catch {
      btn.textContent = 'Could not save';
      setTimeout(() => { btn.innerHTML = 'Save this budget'; }, 2000);
    }
  });

  // ── Init: restore saved budget, then preview ──
  (function init() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) restore(JSON.parse(raw));
    } catch { /* corrupted or unavailable storage — start fresh */ }
    updateCateringPreview();
  })();
</script>
