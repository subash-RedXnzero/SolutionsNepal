    transition: all 150ms ease; font-family: var(--font-sans);
  }
  .event-chip:hover { border-color: var(--nk-border-strong); color: var(--nk-text); }
  .event-chip.chip-active { border-color: var(--nk-accent); background-color: var(--nk-accent-subtle); color: var(--nk-accent); font-weight: 600; }
  .event-g-row { display: flex; flex-direction: column; gap: 2px; }
  .event-g-row .nk-input { padding: 6px 10px; font-size: 12.5px; }
  .exp-group { border: 1px solid var(--nk-border); border-radius: var(--radius-lg); overflow: hidden; }
