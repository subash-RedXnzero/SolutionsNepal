---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../components/ui/RelatedTools.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import {
  MapPin, Users, Utensils, Building2, Gem, Camera, Music, Mail, Car,
  BedDouble, Wallet, Calculator, Printer, Copy, RotateCcw, Save,
  PiggyBank, ShieldCheck, Heart, Hand, Sparkles, PartyPopper, Plus,
  Shirt, User, Star,
} from '@lucide/astro';
import {
  PROVINCES,
  CITIES,
  WEDDING_EVENTS,
  WEDDING_EXPENSE_GROUPS,
  MEAL_STYLES,
  GUEST_PRESETS,
  BUFFER_PRESETS,
  BUDGET_ALLOCATION,
  WEDDING_DEFAULTS,
} from '../../data/wedding-budget.js';

const title = 'Wedding Budget Calculator Nepal | SolutionsNepal';
const description = 'Plan your wedding budget in Nepal. Estimate food, venue, jewellery, decoration, photography, clothing and other wedding expenses.';

const faqItems = [
  {
    q: 'How much does a wedding cost in Nepal?',
    a: 'There is no single fixed cost for a wedding in Nepal (नेपालमा विवाह खर्च / बिहे खर्च). Guest count, venue, food menu, jewellery, decoration and the number of events can significantly affect the total. Enter your own guest count and quoted prices above to build a realistic budget for your situation.',
  },
  {
    q: 'What is the biggest wedding expense?',
    a: 'It varies from wedding to wedding, but food and catering, the venue, jewellery and decoration can each account for a large portion of the total depending on guest count and personal choices. After calculating, check the “Biggest expenses” section to see your own top three.',
  },
  {
    q: 'How much does food cost per person?',
    a: 'Per-plate catering prices vary widely by menu, venue package and city, so enter the actual quoted price from your caterer or venue in the “Cost per guest” field. The calculator multiplies it by your guest count — nothing is assumed.',
  },
  {
    q: 'Does this include jewellery?',
    a: 'Only if you enter a jewellery budget. Jewellery is kept separate because it can dominate the total. Enter your expected jewellery budget rather than trying to estimate it automatically.',
  },
  {
    q: 'Can I calculate a wedding under Rs. 10 lakh?',
    a: 'Yes. Choose “Plan within my budget”, enter Rs. 10,00,000 (or any amount), and SolutionsNepal will create a suggested allocation across food, venue, decoration, clothing and other expenses. Every amount can then be edited.',
  },
  {
    q: 'Can I plan a wedding for Rs. 20 lakh?',
    a: 'Yes. Enter Rs. 20,00,000 as your total budget and let SolutionsNepal create a suggested allocation that you can adjust. Compare it against your own quoted costs to see whether the plan fits.',
  },
];

const EVENT_ICONS = { Heart, Hand, Music, Sparkles, PartyPopper, Plus };
const GROUP_ICONS = {
  Bride: Shirt, Groom: User, Ceremony: Sparkles, Photography: Camera,
  Entertainment: Music, Invitations: Mail, Transportation: Car,
  Accommodation: BedDouble, Other: Wallet,
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Wedding Budget Calculator Nepal',
      description: 'Plan your wedding budget in Nepal. Estimate food, venue, jewellery, decoration, photography, clothing and other wedding expenses.',
      url: 'https://solutionsnepal.com/nepal/wedding-budget-calculator',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ]}
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 py-4 sm:py-5 wb-wrap">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Wedding Budget Calculator' },
    ]} />

    <div class="mb-4">
      <span class="wb-kicker"><Heart size={12} /> Wedding planner · Nepal</span>
      <h1 class="text-[22px] sm:text-[26px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color:var(--nk-text);">Wedding Budget Calculator Nepal</h1>
      <p class="text-[13px] leading-relaxed" style="color:var(--nk-text-secondary);">Plan and estimate your wedding expenses in Nepal.</p>
      <p class="text-[12px] leading-relaxed mt-0.5" style="color:var(--nk-text-tertiary);">Enter your guest count, events, and expected expenses to build a realistic wedding budget.</p>
    </div>

    <!-- ═══ MODE SELECT ═══ -->
    <div class="seg-wrap mb-3" role="radiogroup" aria-label="Calculator mode">
      <button type="button" class="seg-btn seg-active" data-mode="estimate" role="radio" aria-checked="true">
        <Calculator size={15} /><span><strong>Estimate cost</strong><small>From guests &amp; expenses</small></span>
      </button>
      <button type="button" class="seg-btn" data-mode="budget" role="radio" aria-checked="false">
        <PiggyBank size={15} /><span><strong>Plan in budget</strong><small>Split a fixed budget</small></span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_400px] gap-5 items-start">

      <!-- ═══ LEFT: INPUTS ═══ -->
      <div class="nk-card p-4 space-y-4" id="input-card">

        <!-- Budget-first panel -->
        <div id="budget-panel" class="hidden rounded-lg border p-3" style="border-color:var(--nk-border);background-color:var(--nk-hover);">
          <p class="text-[13px] font-semibold mb-1" style="color:var(--nk-text);">What&rsquo;s your total wedding budget?</p>
          <div class="flex flex-col sm:flex-row gap-2">
            <div class="relative flex-1">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="alloc-budget" type="text" inputmode="numeric" autocomplete="off" placeholder={`Example: ${WEDDING_DEFAULTS.totalBudget.toLocaleString('en-IN')}`} class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
            </div>
            <button type="button" id="alloc-generate" class="nk-btn nk-btn-primary nk-btn-sm whitespace-nowrap">Generate suggested allocation</button>
          </div>
          <p class="text-[11px] mt-1.5 leading-relaxed" style="color:var(--nk-text-tertiary);">Suggested budget allocation — not an official price recommendation. Every amount below can be edited.</p>
          <div id="alloc-table" class="hidden mt-2 text-[12px] tabular-nums"></div>
          <p id="err-alloc" class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert"></p>
        </div>

        <!-- Basics · Location + Guests -->
        <section class="duo">
          <div>
            <p class="sec-head"><span class="sec-icon"><MapPin size={14} /></span> Location</p>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="province" class="sr-only">Province</label>
                <select id="province" class="nk-input text-[13px]">
                  <option value="">Province</option>
                  {PROVINCES.map((p) => (<option value={p.id}>{p.name}</option>))}
                </select>
              </div>
              <div>
                <label for="city" class="sr-only">City / district</label>
                <select id="city" class="nk-input text-[13px]">
                  <option value="">City</option>
                  {CITIES.map((c) => (<option value={c}>{c}</option>))}
                </select>
              </div>
            </div>
            <p class="text-[10.5px] mt-1 leading-relaxed" style="color:var(--nk-text-tertiary);">Reference only — enter your own quoted prices.</p>
          </div>
          <div>
            <p class="sec-head"><span class="sec-icon"><Users size={14} /></span> Guests</p>
            <input id="guests" type="text" inputmode="numeric" autocomplete="off" value={String(WEDDING_DEFAULTS.guests)} class="nk-input guest-big text-[17px] font-semibold tabular-nums" aria-label="Number of guests" />
            <div class="flex flex-wrap gap-1.5 mt-1.5">
              {GUEST_PRESETS.map((g) => (
                <button type="button" class="quick-btn" data-guests={g}>{g.toLocaleString('en-IN')}</button>
              ))}
            </div>
          </div>
        </section>

        <!-- Events -->
        <section>
          <p class="sec-head"><span class="sec-icon"><PartyPopper size={14} /></span> Events <span class="sub">— catering &amp; venue scale with guest count</span></p>
          <div class="flex flex-wrap gap-1.5" id="event-chips">
            {WEDDING_EVENTS.map((e) => {
              const Icon = EVENT_ICONS[e.icon] || Plus;
              const selected = e.id === 'wedding';
              return (
                <button type="button" class={`event-chip${selected ? ' chip-active' : ''}`} data-event={e.id} role="checkbox" aria-checked={selected ? 'true' : 'false'}>
                  <Icon size={13} /> {e.label}
                </button>
              );
            })}
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-2" id="event-g-list">
            {WEDDING_EVENTS.map((e) => (
              <div class={e.id === 'wedding' ? 'event-g-row' : 'event-g-row hidden'} data-erow={e.id}>
                <label class="text-[10.5px]" style="color:var(--nk-text-tertiary);" for={`event-g-${e.id}`}>{e.label} guests</label>
                <input id={`event-g-${e.id}`} type="text" inputmode="numeric" autocomplete="off" placeholder="Same as main" class="nk-input text-[13px] tabular-nums event-g-input" data-event-g={e.id} />
              </div>
            ))}
          </div>
        </section>

        <!-- Food + Venue -->
        <section class="duo">
          <div>
            <p class="sec-head"><span class="sec-icon"><Utensils size={14} /></span> Food <span class="sub">per guest</span></p>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="per-guest" type="text" inputmode="decimal" autocomplete="off" value={String(WEDDING_DEFAULTS.cateringPerGuest)} class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
            </div>
            <p class="text-[10.5px] mt-1" style="color:var(--nk-text-tertiary);"><span class="example-badge">Example</span> overwrite with your caterer&rsquo;s quote.</p>
            <div class="flex flex-wrap gap-1.5 mt-1.5" id="meal-row">
              {MEAL_STYLES.map((m, i) => (
                <button type="button" class={`quick-btn${i === 1 ? ' quick-active' : ''}`} data-meal={m.id} data-example={m.examplePerGuest ?? ''}>{m.label}</button>
              ))}
            </div>
            <p class="text-[12px] tabular-nums mt-1.5" style="color:var(--nk-text-secondary);">Catering: <strong id="catering-preview" style="color:var(--nk-text);">—</strong></p>
          </div>
          <div>
            <p class="sec-head"><span class="sec-icon"><Building2 size={14} /></span> Venue</p>
            <div class="flex gap-1.5 mb-2">
              <button type="button" class="unit-btn unit-active" data-vmode="total">Total</button>
              <button type="button" class="unit-btn" data-vmode="per-event">Per event</button>
            </div>
            <div id="venue-total-wrap" class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="venue-total" type="text" inputmode="numeric" autocomplete="off" placeholder="Enter your expected cost" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
            </div>
            <div id="venue-perevent-wrap" class="hidden relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="venue-perevent" type="text" inputmode="numeric" autocomplete="off" placeholder="Cost per event" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
            </div>
          </div>
        </section>

        <!-- Major expenses -->
        <section>
          <p class="sec-head"><span class="sec-icon"><Wallet size={14} /></span> Expenses <span class="sub">— leave blank what doesn&rsquo;t apply</span></p>
          <div class="exp-grid" id="expense-groups">
            {WEDDING_EXPENSE_GROUPS.map((g) => {
              const GIcon = GROUP_ICONS[g.name] || Wallet;
              return (
                <details class="exp-group">
                  <summary class="exp-summary"><GIcon size={14} /><span>{g.name}</span></summary>
                  <div class="exp-body">
                    {g.fields.map((f) => (
                      <div class="exp-row" data-exp={f.key}>
                        <div class="flex items-center justify-between gap-2 mb-1">
                          <label for={`exp-${f.key}`} class="text-[12px] font-medium" style="color:var(--nk-text);">{f.label}</label>
                          <label class="inc-check"><input type="checkbox" class="inc-box" id={`inc-${f.key}`} data-key={f.key} checked /> Include</label>
                        </div>
                        <div class="relative">
                          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
                          <input id={`exp-${f.key}`} type="text" inputmode="decimal" autocomplete="off" placeholder="Enter your expected cost" class="nk-input text-[14px] tabular-nums exp-input" style="padding-left:3rem;" data-key={f.key} />
                        </div>
                        <p class="hidden text-[11px] mt-1" style="color:var(--nk-text-tertiary);" data-excluded-note={f.key}>Not included in total</p>
                      </div>
                    ))}
                  </div>
                </details>
              );
            })}
          </div>
        </section>

        <!-- Jewellery + Buffer + Target -->
        <section class="trio">
          <div>
            <p class="sec-head"><span class="sec-icon"><Gem size={14} /></span> Jewellery <span class="opt-badge">Optional</span></p>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="exp-jewellery" type="text" inputmode="decimal" autocomplete="off" placeholder="Expected budget" class="nk-input text-[14px] tabular-nums exp-input" style="padding-left:3rem;" data-key="jewellery" />
            </div>
            <label class="inc-check mt-1"><input type="checkbox" class="inc-box" id="inc-jewellery" data-key="jewellery" checked /> Include</label>
            <p class="hidden text-[11px] mt-1" style="color:var(--nk-text-tertiary);" data-excluded-note="jewellery">Not included in total</p>
          </div>
          <div>
            <p class="sec-head"><span class="sec-icon"><ShieldCheck size={14} /></span> Buffer</p>
            <div id="buffer-controls" class="flex flex-wrap items-center gap-1.5">
              {BUFFER_PRESETS.map((b) => (
                <button type="button" class={`quick-btn${b === WEDDING_DEFAULTS.bufferPercent ? ' quick-active' : ''}`} data-buffer={b}>{b}%</button>
              ))}
              <button type="button" class="quick-btn" data-buffer="custom">Custom</button>
              <span id="buffer-custom-wrap" class="hidden items-center gap-1">
                <input id="buffer-percent" type="text" inputmode="decimal" autocomplete="off" value={String(WEDDING_DEFAULTS.bufferPercent)} aria-label="Custom buffer percent" class="nk-input text-[13px] tabular-nums" style="width:64px;padding:6px 10px;" />
                <span class="text-[12px]" style="color:var(--nk-text-tertiary);">%</span>
              </span>
            </div>
            <label class="flex items-center gap-2 cursor-pointer mt-1.5">
              <input id="buffer-toggle" type="checkbox" checked style="width:14px;height:14px;accent-color:var(--nk-accent);" />
              <span class="text-[11px]" style="color:var(--nk-text-secondary);">Add on top of subtotal</span>
            </label>
          </div>
          <div>
            <label for="target-budget" class="sec-head"><span class="sec-icon"><PiggyBank size={14} /></span> Target <span class="sub">optional</span></label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
              <input id="target-budget" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 20,00,000" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
            </div>
            <p class="text-[10.5px] mt-1" style="color:var(--nk-text-tertiary);">Shows over / under after calculating.</p>
          </div>
        </section>

        <button type="button" id="calc-btn" class="nk-btn nk-btn-primary w-full">
          <Calculator size={15} /> Calculate wedding budget
        </button>
        <div class="flex gap-2">
          <button type="button" id="reset-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><RotateCcw size={13} /> Reset</button>
          <button type="button" id="save-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><Save size={13} /> Save this budget</button>
        </div>
        <p class="text-[11px] leading-relaxed" style="color:var(--nk-text-tertiary);">Your budget is stored only in your browser.</p>
      </div>

      <!-- ═══ RIGHT: RESULT ═══ -->
      <div class="md:sticky md:top-4">
        <div class="nk-card p-4" aria-live="polite" id="result-card">
          <p class="text-[11px] font-semibold uppercase tracking-wider mb-3" style="color:var(--nk-text-tertiary);">Your estimate</p>

          <div id="res-empty">
            <div class="rounded-xl px-4 py-6 text-center" style="background-color:var(--nk-accent-subtle);">
              <span class="res-empty-icon"><Calculator size={20} /></span>
              <p class="text-[10.5px] font-semibold uppercase tracking-wider mb-1" style="color:var(--nk-text-secondary);">Estimated wedding cost</p>
              <p class="text-[24px] font-bold tracking-tight" style="color:var(--nk-text-tertiary);">—</p>
              <p class="text-[11.5px] mt-1.5" style="color:var(--nk-text-secondary);">Enter your details and click <strong>Calculate wedding budget</strong>.</p>
            </div>
          </div>

          <div id="res-body" class="hidden">
            <div class="res-hero">
              <p class="res-hero-label">Estimated wedding cost</p>
              <p class="tabular-nums" id="res-total">—</p>
              <p class="res-hero-sub" id="res-subline"></p>
            </div>

            <div class="stat-duo">
              <div class="stat-tile"><span>Cost per guest</span><strong class="tabular-nums" id="res-perguest">—</strong></div>
              <div class="stat-tile"><span>Categories</span><strong class="tabular-nums" id="res-count">—</strong></div>
            </div>

            <p class="text-[11px] font-semibold uppercase tracking-wider mt-4 mb-1.5" style="color:var(--nk-text-tertiary);">Breakdown</p>
            <div id="res-rows"></div>
            <div id="res-buffer-row" class="hidden result-row"><span>Emergency buffer</span><span class="rv" id="res-buffer">—</span></div>
            <div class="flex items-center justify-between py-1.5 mt-1">
              <span class="text-[13px] font-semibold" style="color:var(--nk-text);">Estimated total</span>
              <strong class="text-[15px] font-bold tabular-nums" style="color:var(--nk-accent);" id="res-total-2">—</strong>
            </div>

            <div id="res-budget-box" class="hidden rounded-lg px-3 py-2.5 mt-2 text-[12.5px]" style="background-color:var(--nk-hover);border:1px solid var(--nk-border);">
              <p class="font-semibold mb-1" style="color:var(--nk-text);">Budget status</p>
              <div id="budget-rows" class="space-y-1 tabular-nums"></div>
            </div>

            <div id="res-top-wrap" class="mt-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--nk-text-tertiary);">Biggest expenses</p>
              <div id="res-top" class="space-y-1.5"></div>
            </div>

            <div id="res-tips-wrap" class="hidden mt-3">
              <p class="text-[11px] font-semibold uppercase tracking-wider mb-1.5" style="color:var(--nk-text-tertiary);">Ways to reduce the budget</p>
              <div id="res-tips" class="space-y-1.5"></div>
              <p class="text-[10.5px] mt-1.5 leading-relaxed" style="color:var(--nk-text-tertiary);">Mathematical observations based on your inputs — not financial advice.</p>
            </div>

            <div id="res-warnings" class="hidden mt-3 space-y-1.5"></div>

            <div class="px-0 py-3 flex gap-2 mt-1">
              <button id="print-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><Printer size={13} /> Print budget</button>
              <button id="copy-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><Copy size={13} /> Copy summary</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ EDUCATIONAL CONTENT ═══ -->
    <div class="mt-10 max-w-3xl space-y-8">
      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">How much does a wedding cost in Nepal?</h2>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">There is no single fixed wedding cost in Nepal. A small family ceremony and a large multi-event celebration can differ enormously, because guest count, venue, food menu, jewellery, decoration and the number of events all move the total. The practical approach is to collect your own quotes — catering per plate, venue, photographer, decorator — and add them up with a small emergency buffer, which is exactly what this calculator does.</p>
      </section>

      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">Frequently Asked Questions</h2>
        <div class="space-y-2">
          {faqItems.map((item) => (
            <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
              <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">{item.q}</summary>
              <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">{item.a}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Related Nepal calculators</h3>
        <ul class="text-sm leading-relaxed space-y-1" style="color:var(--nk-text-secondary);">
          <li>• <a class="underline hover:opacity-80" href="/nepal/tools/nepali-number-to-words" style="color:var(--nk-accent);">Number to Nepali Words</a> — write your wedding budget or cheque amounts in words</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/vat-calculator" style="color:var(--nk-accent);">VAT Calculator</a> — check whether vendor quotes include 13% VAT</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance" style="color:var(--nk-accent);">All finance tools</a></li>
        </ul>
      </section>
    </div>

    <Disclaimer variant="general" />
    <RelatedTools tools={[
      { title: 'Number to Nepali Words', description: 'Write amounts in words for cheques & bills', href: '/nepal/tools/nepali-number-to-words' },
      { title: 'VAT Calculator Nepal', description: 'Add or remove 13% VAT from vendor quotes', href: '/nepal/finance/vat-calculator' },
    ]} />
  </div>
</BaseLayout>

<style>
  .seg-wrap {
    display: flex; gap: 3px; padding: 3px;
    border: 1px solid var(--nk-border); border-radius: var(--radius-lg);
    background-color: var(--nk-hover);
  }
  .seg-btn {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: 7px 10px; border-radius: 9px; border: 1px solid transparent;
    background: transparent; color: var(--nk-text-secondary);
    cursor: pointer; font: inherit; text-align: left;
    transition: all 150ms ease;
  }
  .seg-btn span { display: flex; flex-direction: column; gap: 0; min-width: 0; }
  .seg-btn strong { font-size: 12.5px; font-weight: 600; line-height: 1.3; }
  .seg-btn small { font-size: 10.5px; line-height: 1.3; color: var(--nk-text-tertiary); }
  .seg-btn:hover { color: var(--nk-text); }
  .seg-btn.seg-active {
    background-color: var(--nk-surface); color: var(--nk-text);
