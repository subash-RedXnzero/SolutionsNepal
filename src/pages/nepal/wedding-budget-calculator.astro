  .exp-summary::-webkit-details-marker { display: none; }
  .exp-summary:hover { background-color: var(--nk-hover); }
  .exp-body { padding: 10px 11px 11px; display: grid; grid-template-columns: 1fr; gap: 10px; border-top: 1px solid var(--nk-border); }
  .exp-row .nk-input { padding-top: 7px; padding-bottom: 7px; }
  .inc-check {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; font-weight: 500; white-space: nowrap;
    color: var(--nk-text-secondary); cursor: pointer;
  }
  .inc-check input { width: 14px; height: 14px; accent-color: var(--nk-accent); cursor: pointer; }
  .example-badge {
