  .exp-group[open] .exp-summary::after { content: '−'; color: var(--nk-accent); }
  .exp-group { transition: border-color 150ms ease, box-shadow 150ms ease; }
  .exp-group:hover { border-color: var(--nk-border-strong); }
  .exp-group[open] { border-color: var(--nk-border-strong); box-shadow: var(--shadow-sm); }
  .event-chip.chip-active { box-shadow: 0 2px 10px -3px rgba(230,43,30,.45); }
  .quick-btn {
    font-size: 11px; font-weight: 600;
    padding: 0.3rem 0.7rem; border-radius: 9999px;
    border: 1px solid var(--nk-border);
    color: var(--nk-text-secondary); background: transparent;
    cursor: pointer; transition: all 150ms; font-family: var(--font-sans);
  }
  .quick-btn:hover, .quick-btn.quick-active { border-color: var(--nk-accent); color: var(--nk-accent); }
  .quick-btn.quick-active { background-color: var(--nk-accent-subtle); }
  .unit-btn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center;
    height: 28px; border-radius: var(--radius-md); font-size: 11.5px; font-weight: 500;
    border: 1px solid var(--nk-border); cursor: pointer; transition: all 0.1s ease;
    color: var(--nk-text-secondary); background: var(--nk-surface); font-family: var(--font-sans);
  }
  .unit-btn:hover { border-color: var(--nk-border-strong); color: var(--nk-text); }
  .unit-btn.unit-active { background: var(--nk-accent); border-color: var(--nk-accent); color: white; font-weight: 600; }
  .guest-big { min-height: 44px; }
  .event-chip {
    display: inline-flex; align-items: center; gap: 6px;
