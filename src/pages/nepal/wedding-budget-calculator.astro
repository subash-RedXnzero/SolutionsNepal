  .stat-tile span { display: block; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--nk-text-tertiary); }
  .stat-tile strong { font-size: 16px; font-weight: 700; color: var(--nk-text); }
  .res-empty-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 12px; margin-bottom: 8px;
    background-color: var(--nk-surface); color: var(--nk-accent); box-shadow: var(--shadow-sm);
  }
  .exp-summary::after {
    content: '+'; margin-left: auto; font-size: 14px; font-weight: 600;
    color: var(--nk-text-tertiary); line-height: 1;
