---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../components/ui/RelatedTools.astro';
import {
  Bike, Car, Fuel, Landmark, Wrench, ShieldCheck, Receipt, SquareParking,
  Wallet, Calculator, Copy, RotateCcw, Save, Gauge, Zap, Scale,
  PiggyBank, TrendingDown, CalendarDays,
} from '@lucide/astro';
import {
  VEHICLE_TYPES,
  FUEL_TYPES,
  PERIOD_OPTIONS,
  DEFAULT_PERIOD_YEARS,
  ANNUAL_COST_FIELDS,
  MONTHLY_COST_FIELDS,
  MAINTENANCE_FIELDS,
  EV_EFFICIENCY_EXAMPLE,
  OWNERSHIP_DATA_META,
  STORAGE_KEY,
} from '../../../data/vehicle/ownership-cost.js';
import { getFuelPriceAsync } from '../../../lib/nepal/fuel-price.js';
import Disclaimer from '../../../components/ui/Disclaimer.astro';

const title = 'Bike & Car Ownership Cost Calculator Nepal | SolutionsNepal';
const description = 'Calculate the real cost of owning a bike, scooter, or car in Nepal including fuel, EMI, tax, insurance, maintenance, parking and depreciation.';

// NOC reference prices at build time (button-filled only, never silent).
let fuelRef = { petrol: '', diesel: '', effectiveDate: '', isLive: false };
try {
  const d = await getFuelPriceAsync('kathmandu');
  fuelRef = {
    petrol: d?.petrol?.price ?? '',
    diesel: d?.diesel?.price ?? '',
    effectiveDate: d?.effectiveDate || '',
    isLive: !!d?.isLive,
  };
} catch { /* manual entry remains available */ }

const faqItems = [
  {
    q: 'How much does it cost to own a bike in Nepal?',
    a: 'It depends on your mileage, fuel price, loan, insurance, servicing and tax. Enter your own numbers above — most bikes cost a few thousand rupees per month in fuel plus periodic servicing, insurance and tax on top.',
  },
  {
    q: 'How much does it cost to own a car in Nepal?',
    a: 'Cars cost far more than bikes to run: lower mileage, higher insurance, servicing and tax. Fill in your monthly distance, mileage, EMI and annual costs to see your true monthly, yearly and 5-year figures.',
  },
  {
    q: 'What is included in vehicle ownership cost?',
    a: 'Fuel or charging, loan EMI, maintenance and repairs, insurance, vehicle tax, registration renewal, parking, tolls, washing, accessories and — separately — depreciation (loss in resale value).',
  },
  {
    q: 'How is cost per kilometre calculated?',
    a: 'Total ownership cost per km is your annual ownership cost divided by the kilometres you drive in a year (monthly distance × 12). Running cost per km counts fuel or charging alone.',
  },
  {
    q: 'Does vehicle tax count as an ownership cost?',
    a: 'Yes. Annual vehicle tax and registration renewal are real ownership costs — the calculator spreads them across 12 months so you see their monthly equivalent.',
  },
  {
    q: 'Should depreciation be included?',
    a: 'Depreciation is an estimated loss in value, not monthly cash spending, so it stays out of the headline monthly figure. Turn it on to see your 5-year cost including depreciation separately.',
  },
  {
    q: 'Does the calculator include EMI?',
    a: 'Yes, when you enable the loan section. It uses the standard reducing-balance EMI formula and only counts instalments inside your selected period — the loan never continues past its real duration.',
  },
  {
    q: 'Can I compare two vehicles?',
    a: 'Yes. Open “Compare two vehicles” below the calculator to see monthly, annual, per-km and 5-year costs for Vehicle A vs Vehicle B side by side — for example a bike vs a car.',
  },
];

const VTYPE_ICONS = { Bike, Car };
const FUEL_ICONS = { petrol: Fuel, diesel: Fuel, electric: Zap };
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Bike & Car Ownership Cost Calculator Nepal',
      description: 'Calculate the real cost of owning a bike, scooter, or car in Nepal including fuel, EMI, tax, insurance, maintenance, parking and depreciation.',
      url: 'https://solutionsnepal.com/nepal/vehicle/ownership-cost-calculator',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ]}
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 py-4 sm:py-5 oc-wrap">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Vehicle', href: '/nepal/vehicle' },
      { label: 'Ownership Cost' },
    ]} />

    <div class="mb-4">
      <span class="oc-kicker"><Gauge size={12} /> Vehicle costs · Nepal</span>
      <h1 class="text-[22px] sm:text-[26px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color:var(--nk-text);">Bike &amp; Car Ownership Cost Calculator</h1>
      <p class="text-[13px] leading-relaxed" style="color:var(--nk-text-secondary);">Fuel, EMI, tax, insurance and upkeep — your real monthly, yearly and 5-year cost.</p>
    </div>

    <!-- ═══ VEHICLE SELECT ═══ -->
    <div class="seg-wrap mb-3" role="radiogroup" aria-label="Vehicle type">
      {VEHICLE_TYPES.map((v, i) => {
        const Icon = VTYPE_ICONS[v.icon] || Car;
        return (
          <button type="button" class={`seg-btn${i === 0 ? ' seg-active' : ''}`} data-vtype={v.id} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
            <Icon size={16} /><span><strong>{v.label}</strong><small>{v.id === 'bike' ? '2-wheelers, scooters' : 'Cars, jeeps, SUVs'}</small></span>
          </button>
        );
      })}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-4 items-start">

      <!-- ═══ LEFT: INPUTS ═══ -->
      <div class="nk-card p-4 space-y-3" id="input-card">
        <div id="form-errors" class="hidden warn-line" role="alert"></div>

        <!-- Purchase + usage -->
        <section>
          <div class="duo">
            <div>
          <p class="sec-head"><span class="sec-icon"><Landmark size={14} /></span> Purchase</p>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="purchase" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Purchase price</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
                <input id="purchase" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 3,00,000" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
              </div>
            </div>
            <div>
              <label for="down" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Down payment</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
                <input id="down" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 1,00,000" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
              </div>
            </div>
          </div>
          <label class="flex items-center gap-2 cursor-pointer mt-2">
            <input id="noloan" type="checkbox" checked style="width:15px;height:15px;accent-color:var(--nk-accent);" />
            <span class="text-[12.5px]" style="color:var(--nk-text);">I bought this vehicle without a loan</span>
          </label>
          <div id="loan-grid" class="hidden mt-2 rounded-lg border p-3" style="border-color:var(--nk-border);background-color:var(--nk-hover);">
            <div class="grid grid-cols-1 gap-2">
              <div>
                <label for="loanAmount" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Loan amount</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
                  <input id="loanAmount" type="text" inputmode="numeric" autocomplete="off" placeholder="Auto from price − down" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
                </div>
                <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="loanAmount"></p>
              </div>
              <div>
                <label for="loanRate" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Interest % / year</label>
                <div class="relative">
                  <input id="loanRate" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 12" class="nk-input text-[14px] tabular-nums" style="padding-right:2rem;" />
                  <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">%</span>
                </div>
                <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="loanRate"></p>
              </div>
              <div>
                <label for="loanDur" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Duration</label>
                <div class="flex gap-1.5">
                  <input id="loanDur" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 5" class="nk-input text-[14px] tabular-nums" style="max-width:90px;" />
                  <button type="button" class="unit-btn unit-active" data-dunit="years">Yrs</button>
                  <button type="button" class="unit-btn" data-dunit="months">Mo</button>
                </div>
                <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="loanMonths"></p>
              </div>
            </div>
            <p class="text-[12px] tabular-nums mt-2" style="color:var(--nk-text-secondary);">EMI: <strong id="emi-preview" style="color:var(--nk-text);">—</strong></p>
          </div>
            </div>
            <div>
          <p class="sec-head"><span class="sec-icon"><Fuel size={14} /></span> Driving</p>
          <div class="duo">
            <div>
              <label for="monthlyKm" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Distance per month (km)</label>
              <input id="monthlyKm" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 600" class="nk-input text-[14px] tabular-nums" />
              <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="monthlyKm"></p>
            </div>
            <div>
              <p class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Fuel type</p>
              <div class="flex flex-wrap gap-1.5" role="radiogroup" aria-label="Fuel type">
                {FUEL_TYPES.map((f, i) => {
                  const Icon = FUEL_ICONS[f.id] || Fuel;
                  return (
                    <button type="button" class={`fuel-chip${i === 0 ? ' chip-active' : ''}`} data-fuel={f.id} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
                      <Icon size={13} /> {f.label}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
          <div class="duo mt-2">
            <div>
              <label for="efficiency" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);"><span id="eff-label">Mileage (km/l)</span></label>
              <input id="efficiency" type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 45" class="nk-input text-[14px] tabular-nums" />
              <p class="text-[10.5px] mt-1" style="color:var(--nk-text-tertiary);" id="eff-hint">Your own average.</p>
              <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="efficiency"></p>
            </div>
            <div>
              <label for="energyPrice" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);"><span id="price-label">Price per litre (Rs.)</span></label>
              <div class="flex flex-wrap gap-1.5">
                <input id="energyPrice" type="text" inputmode="decimal" autocomplete="off" placeholder="Your price" class="nk-input text-[14px] tabular-nums flex-1" />
                <button type="button" id="use-price" class="nk-btn nk-btn-secondary nk-btn-sm whitespace-nowrap">Use current Nepal price</button>
              </div>
              <p class="text-[10.5px] mt-1 leading-relaxed" style="color:var(--nk-text-tertiary);" id="price-note">Your price, or NOC reference:</p>
              <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="energyPrice"></p>
            </div>
          </div>
            </div>
          </div>
        </section>

        <!-- Annual + maintenance (collapsed — optional) -->
        <details class="exp-group">
          <summary class="exp-summary"><Receipt size={14} /><span>Yearly costs &amp; maintenance <span style="font-weight:400;color:var(--nk-text-tertiary);">— optional</span></span></summary>
          <div class="exp-body">
            <div>
          <p class="sec-head"><span class="sec-icon"><Receipt size={14} /></span> Yearly costs</p>
          <div class="grid grid-cols-1 min-[500px]:grid-cols-2 gap-2">
            {ANNUAL_COST_FIELDS.map((f) => (
              <div>
                <label for={`exp-${f.key}`} class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">{f.label} (Rs.)</label>
                <input id={`exp-${f.key}`} type="text" inputmode="numeric" autocomplete="off" placeholder="Optional" class="nk-input text-[14px] tabular-nums ann-input" data-key={f.key} />
              </div>
            ))}
          </div>
          <p class="text-[10.5px] mt-1.5" style="color:var(--nk-text-tertiary);">Rates: <a class="underline hover:opacity-80" href="/nepal/transport/vehicle-tax" style="color:var(--nk-accent);">Vehicle Tax calculator</a></p>
            </div>
            <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="sec-head" style="margin-bottom:0;"><span class="sec-icon"><Wrench size={14} /></span> Maintenance</p>
            <div class="flex gap-1.5" style="min-width:170px;max-width:220px;flex:1;">
              <button type="button" class="unit-btn unit-active" data-mmode="simple">Simple</button>
              <button type="button" class="unit-btn" data-mmode="detailed">Detailed</button>
            </div>
          </div>
          <div id="maint-simple-wrap" class="relative" style="max-width:320px;">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
            <input id="maintSimple" type="text" inputmode="numeric" autocomplete="off" placeholder="Maintenance per year" class="nk-input text-[14px] tabular-nums" style="padding-left:3rem;" />
          </div>
          <div id="maint-detail-wrap" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-2">
            {MAINTENANCE_FIELDS.map((f) => (
              <div>
                <label for={`m-${f.key}`} class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">{f.label} (Rs./yr)</label>
                <input id={`m-${f.key}`} type="text" inputmode="numeric" autocomplete="off" placeholder="Optional" class="nk-input text-[14px] tabular-nums maint-input" data-key={f.key} />
              </div>
            ))}
          </div>
            </div>
          </div>
        </details>

        <!-- Monthly + depreciation (collapsed — optional) -->
        <details class="exp-group">
          <summary class="exp-summary"><SquareParking size={14} /><span>Monthly extras &amp; depreciation <span style="font-weight:400;color:var(--nk-text-tertiary);">— optional</span></span></summary>
          <div class="exp-body">
            <div>
          <p class="sec-head"><span class="sec-icon"><SquareParking size={14} /></span> Monthly extras</p>
          <div class="grid grid-cols-1 min-[500px]:grid-cols-2 gap-2">
            {MONTHLY_COST_FIELDS.map((f) => (
              <div>
                <label for={`r-${f.key}`} class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">{f.label} (Rs.)</label>
                <input id={`r-${f.key}`} type="text" inputmode="numeric" autocomplete="off" placeholder="Optional" class="nk-input text-[14px] tabular-nums rec-input" data-key={f.key} />
              </div>
            ))}
          </div>
            </div>
            <div class="rounded-lg border p-3" style="border-color:var(--nk-border);align-self:start;">
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="sec-head" style="margin-bottom:0;"><span class="sec-icon"><TrendingDown size={14} /></span> Depreciation <span class="opt-badge">Optional</span></p>
            <label class="inc-check"><input type="checkbox" id="depToggle" /> Include</label>
          </div>
          <div id="dep-grid" class="hidden duo">
            <div>
              <label for="depPurchase" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Bought for (Rs.)</label>
              <input id="depPurchase" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 35,00,000" class="nk-input text-[14px] tabular-nums" />
              <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="purchasePrice"></p>
            </div>
            <div>
              <label for="depResale" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Resell for (Rs.)</label>
              <input id="depResale" type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 20,00,000" class="nk-input text-[14px] tabular-nums" />
              <p class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert" data-err="resaleValue"></p>
            </div>
          </div>
          <p class="text-[10.5px] mt-1.5 leading-relaxed" style="color:var(--nk-text-tertiary);">Value loss, not monthly cash spending.</p>
            </div>
          </div>
        </details>

        <button type="button" id="calc-btn" class="nk-btn nk-btn-primary w-full">
          <Calculator size={15} /> Calculate ownership cost
        </button>
        <div class="flex gap-2">
          <button type="button" id="reset-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><RotateCcw size={13} /> Reset</button>
          <button type="button" id="save-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1"><Save size={13} /> Save inputs</button>
        </div>
        <p class="text-[11px] leading-relaxed" style="color:var(--nk-text-tertiary);">Your inputs are stored only in your browser.</p>

        <!-- Compare -->
        <details class="exp-group">
          <summary class="exp-summary"><Scale size={14} /><span>Compare two vehicles <span style="font-weight:400;color:var(--nk-text-tertiary);">— optional</span></span></summary>
          <div class="exp-body">
            <p class="text-[11px] sm:col-span-2" style="color:var(--nk-text-tertiary);">Quick side-by-side using totals you already know — e.g. Bike vs Car. 5-year figures assume the same driving pattern you enter.</p>
            {['a', 'b'].map((side, si) => (
              <div class="rounded-lg border p-3 space-y-2" style="border-color:var(--nk-border);">
                <p class="text-[12.5px] font-semibold" style="color:var(--nk-text);">Vehicle {side.toUpperCase()}</p>
                <div>
                  <label for={`cmp-${side}-name`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Name</label>
                  <input id={`cmp-${side}-name`} type="text" autocomplete="off" value={si === 0 ? 'Bike' : 'Car'} class="nk-input text-[13px]" />
                </div>
                <div class="grid grid-cols-1 min-[500px]:grid-cols-2 gap-2">
                  <div>
                    <label for={`cmp-${side}-km`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">km / month</label>
                    <input id={`cmp-${side}-km`} type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 600" class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-fuel`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Fuel</label>
                    <select id={`cmp-${side}-fuel`} class="nk-input text-[13px]">
                      <option value="petrol">Petrol</option>
                      <option value="diesel">Diesel</option>
                      <option value="electric">Electric</option>
                    </select>
                  </div>
                  <div>
                    <label for={`cmp-${side}-eff`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Mileage / km·kWh</label>
                    <input id={`cmp-${side}-eff`} type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 45" class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-price`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Fuel Rs. / unit</label>
                    <input id={`cmp-${side}-price`} type="text" inputmode="decimal" autocomplete="off" placeholder="e.g. 199" class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-emi`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">EMI / month</label>
                    <input id={`cmp-${side}-emi`} type="text" inputmode="numeric" autocomplete="off" placeholder="0 if none" class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-annual`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Annual costs</label>
                    <input id={`cmp-${side}-annual`} type="text" inputmode="numeric" autocomplete="off" placeholder="Tax+ins+etc." class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-maint`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Maint. / year</label>
                    <input id={`cmp-${side}-maint`} type="text" inputmode="numeric" autocomplete="off" placeholder="e.g. 12000" class="nk-input text-[13px] tabular-nums" />
                  </div>
                  <div>
                    <label for={`cmp-${side}-monthly`} class="block text-[11px] font-medium mb-0.5" style="color:var(--nk-text-secondary);">Other / month</label>
                    <input id={`cmp-${side}-monthly`} type="text" inputmode="numeric" autocomplete="off" placeholder="Park, wash…" class="nk-input text-[13px] tabular-nums" />
                  </div>
                </div>
              </div>
            ))}
            <div class="sm:col-span-2">
              <button type="button" id="cmp-btn" class="nk-btn nk-btn-secondary nk-btn-sm w-full">Compare vehicles</button>
              <p id="err-cmp" class="hidden text-[11px] mt-1" style="color:#dc2626;" role="alert"></p>
              <div id="cmp-result" class="hidden mt-2"></div>
            </div>
          </div>
        </details>
      </div>

      <!-- ═══ RIGHT: RESULT ═══ -->
      <div class="lg:sticky lg:top-20">
        <div class="nk-card p-4" aria-live="polite" id="result-card">
          <div class="flex items-center justify-between gap-2 mb-3">
            <p class="text-[11px] font-semibold uppercase tracking-wider" style="color:var(--nk-text-tertiary);">Your cost</p>
            <div class="flex gap-1" role="radiogroup" aria-label="Ownership period">
              {PERIOD_OPTIONS.map((y) => (
                <button type="button" class={`per-btn${y === DEFAULT_PERIOD_YEARS ? ' per-active' : ''}`} data-years={y} role="radio" aria-checked={y === DEFAULT_PERIOD_YEARS ? 'true' : 'false'}>{y}Y</button>
              ))}
            </div>
          </div>

