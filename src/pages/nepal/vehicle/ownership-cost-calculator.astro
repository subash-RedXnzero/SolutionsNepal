<script>
  import {
    calculateOwnershipCost, calculateEMI, summarizeOwnership,
    formatNPR, formatNumberIN, parseAmount, sanitizeAmount,
  } from '../../../lib/calculators/ownership-cost.js';
  import {
    VEHICLE_TYPES, FUEL_TYPES, PERIOD_OPTIONS,
    STORAGE_KEY, EV_EFFICIENCY_EXAMPLE, OWNERSHIP_DATA_META,
  } from '../../../data/vehicle/ownership-cost.js';

  const $ = (id) => document.getElementById(id);
  const VTYPE_DEFAULTS = Object.fromEntries(VEHICLE_TYPES.map((v) => [v.id, v.examples]));

  let vehicleType = 'bike';
  let fuelType = 'petrol';
  let maintMode = 'simple';
  let durUnit = 'years';
  let periodYears = 5;
  let lastSummary = '';

  // ── Vehicle type ──
  document.querySelectorAll('.seg-btn[data-vtype]').forEach((b) => b.addEventListener('click', () => {
    vehicleType = b.dataset.vtype;
    document.querySelectorAll('.seg-btn[data-vtype]').forEach((x) => {
      const on = x === b;
      x.classList.toggle('seg-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    applyVehicleExamples();
    updateEmiPreview();
  }));

  function applyVehicleExamples() {
    const ex = VTYPE_DEFAULTS[vehicleType] || {};
    $('monthlyKm').placeholder = `e.g. ${formatNumberIN(ex.monthlyKm || 600)}`;
    $('purchase').placeholder = `e.g. ${formatNumberIN(ex.purchasePrice || 300000)}`;
    updateEfficiencyUI();
  }

  // ── Fuel type ──
  document.querySelectorAll('.fuel-chip[data-fuel]').forEach((b) => b.addEventListener('click', () => {
    fuelType = b.dataset.fuel;
    document.querySelectorAll('.fuel-chip[data-fuel]').forEach((x) => {
      const on = x === b;
      x.classList.toggle('chip-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    updateEfficiencyUI();
  }));

  function updateEfficiencyUI() {
    const electric = fuelType === 'electric';
    const ex = VTYPE_DEFAULTS[vehicleType] || {};
    $('eff-label').textContent = electric ? 'Use (km/kWh)' : 'Mileage (km/l)';
    $('efficiency').placeholder = electric ? `e.g. ${EV_EFFICIENCY_EXAMPLE}` : `e.g. ${ex.mileage || 45}`;
    $('eff-hint').textContent = electric
      ? `Example: ${EV_EFFICIENCY_EXAMPLE} km/kWh.`
      : `${ex.mileageHint || 'Example: 45 km/l.'}`;
    $('price-label').textContent = electric ? 'Price per kWh (Rs.)' : 'Price per litre (Rs.)';
    $('use-price').classList.toggle('hidden', electric);
    if (!electric) updatePriceNote(); else $('price-note').textContent = 'Your NEA rate per kWh.';
  }

  // ── NOC reference price (button-filled only, with disclosure) ──
  function fuelRef() {
    const el = $('fuel-ref');
    return {
      petrol: el?.dataset?.petrol || '',
      diesel: el?.dataset?.diesel || '',
      date: el?.dataset?.date || '',
      live: el?.dataset?.live === '1',
    };
  }
  function updatePriceNote() {
    const ref = fuelRef();
    const price = fuelType === 'diesel' ? ref.diesel : ref.petrol;
    $('price-note').textContent = price
      ? `NOC: Rs. ${price}/L${ref.date ? ` (${ref.date}` : ''}${ref.live ? ', live' : ''}${ref.date ? ')' : ''} — editable.`
      : 'Your price, or NOC reference:';
  }
  $('use-price').addEventListener('click', () => {
    const ref = fuelRef();
    const price = fuelType === 'diesel' ? ref.diesel : ref.petrol;
    if (price) {
      $('energyPrice').value = price;
      updatePriceNote();
    } else {
      $('price-note').textContent = 'Unavailable — enter manually.';
    }
  });

  // ── Loan ──
  $('noloan').addEventListener('change', () => {
    $('loan-grid').classList.toggle('hidden', $('noloan').checked);
    updateEmiPreview();
  });
  document.querySelectorAll('[data-dunit]').forEach((b) => b.addEventListener('click', () => {
    durUnit = b.dataset.dunit;
    document.querySelectorAll('[data-dunit]').forEach((x) => x.classList.toggle('unit-active', x === b));
    updateEmiPreview();
  }));
  ['purchase', 'down'].forEach((id) => $(id).addEventListener('input', () => {
    // Auto-fill loan amount from price − down, until the user types their own.
    if ($('loanAmount').value.trim() === '') {
      const p = parseAmount($('purchase').value).value;
      const d = parseAmount($('down').value).value || 0;
      if (p != null && p > d) $('loanAmount').value = formatNumberIN(p - d);
    }
    if ($('depPurchase').value.trim() === '') {
      const p = parseAmount($('purchase').value).value;
      if (p != null) $('depPurchase').value = formatNumberIN(p);
    }
    updateEmiPreview();
  }));
  ['loanAmount', 'loanRate', 'loanDur'].forEach((id) => $(id).addEventListener('input', updateEmiPreview));

  function loanMonths() {
    const n = parseFloat(String($('loanDur').value).replace(/,/g, ''));
    if (!Number.isFinite(n) || n <= 0) return 0;
    return Math.floor(durUnit === 'years' ? n * 12 : n);
  }
  function updateEmiPreview() {
    const el = $('emi-preview');
    if ($('noloan').checked) { el.textContent = 'No loan — skipped'; return; }
    const p = parseAmount($('loanAmount').value).value;
    const r = parseFloat(String($('loanRate').value).replace(/,/g, ''));
    const m = loanMonths();
    if (p == null || p <= 0 || !Number.isFinite(r) || m < 1) { el.textContent = 'Enter amount, rate and duration'; return; }
    el.textContent = `${formatNPR(calculateEMI(p, r, m).emi)} / month`;
  }

  // ── Maintenance mode ──
  document.querySelectorAll('[data-mmode]').forEach((b) => b.addEventListener('click', () => {
    maintMode = b.dataset.mmode;
    document.querySelectorAll('[data-mmode]').forEach((x) => x.classList.toggle('unit-active', x === b));
    $('maint-simple-wrap').classList.toggle('hidden', maintMode !== 'simple');
    $('maint-detail-wrap').classList.toggle('hidden', maintMode !== 'detailed');
  }));

  // ── Depreciation toggle ──
  $('depToggle').addEventListener('change', () => {
    $('dep-grid').classList.toggle('hidden', !$('depToggle').checked);
  });

  // ── Period ──
  document.querySelectorAll('.per-btn[data-years]').forEach((b) => b.addEventListener('click', () => {
    periodYears = Number(b.dataset.years);
    document.querySelectorAll('.per-btn[data-years]').forEach((x) => {
      const on = x === b;
      x.classList.toggle('per-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    if (!$('res-body').classList.contains('hidden')) doCalc();
  }));

  // ── Collect ──
  function collectInput() {
    const annual = {};
    document.querySelectorAll('.ann-input').forEach((el) => { annual[el.dataset.key] = el.value; });
    const detailed = {};
    document.querySelectorAll('.maint-input').forEach((el) => { detailed[el.dataset.key] = el.value; });
    const recurring = {};
    document.querySelectorAll('.rec-input').forEach((el) => { recurring[el.dataset.key] = el.value; });
    return {
      vehicleType,
      fuelType,
      monthlyKm: $('monthlyKm').value,
      efficiency: $('efficiency').value,
      energyPrice: $('energyPrice').value,
      loan: {
        enabled: !$('noloan').checked,
        amount: $('loanAmount').value,
        annualRatePct: $('loanRate').value,
        months: loanMonths(),
      },
      annual,
      maintenance: { mode: maintMode, simpleAnnual: $('maintSimple').value, detailed },
      recurring,
      depreciation: {
        enabled: $('depToggle').checked,
        purchasePrice: $('depPurchase').value,
        resaleValue: $('depResale').value,
      },
    };
  }

  // ── Validation display (inline, never alert) ──
  function showErrors(errors) {
    document.querySelectorAll('[data-err]').forEach((el) => el.classList.add('hidden'));
    const general = [];
    for (const [key, msg] of Object.entries(errors)) {
      const el = document.querySelector(`[data-err="${key}"]`);
      if (el) { el.textContent = msg; el.classList.remove('hidden'); }
      else general.push(msg);
    }
    const box = $('form-errors');
    if (general.length > 0) {
      box.innerHTML = general.map((m) => `<div>• ${m}</div>`).join('');
      box.classList.remove('hidden');
    } else {
      box.classList.add('hidden');
    }
    // Optional sections are collapsed — open any holding a visible error.
    document.querySelectorAll('#input-card details.exp-group').forEach((d) => {
      if (d.querySelector('[data-err]:not(.hidden)')) d.open = true;
    });
    return Object.keys(errors).length === 0;
  }

  function rowHTML(label, value) {
    return `<div class="result-row"><span>${label}</span><span class="rv">${value}</span></div>`;
  }
  function kvHTML(label, value) {
    return `<div class="kv-row"><span>${label}</span><strong>${value}</strong></div>`;
  }

  // ── Calculate + render ──
  function doCalc() {
    const input = collectInput();
    const r = calculateOwnershipCost(input, periodYears);
    if (!r.valid) {
      showErrors(r.errors);
      $('res-body').classList.add('hidden');
      $('res-empty').classList.remove('hidden');
      document.querySelector('#input-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    showErrors({});
    render(input, r);
  }

  function render(input, r) {
    $('res-empty').classList.add('hidden');
    $('res-body').classList.remove('hidden');

    const vlabel = vehicleType === 'bike' ? 'Motorcycle / Scooter' : 'Car / Jeep';
    const flabel = fuelType === 'electric' ? 'Electric' : fuelType === 'diesel' ? 'Diesel' : 'Petrol';
    $('res-total').textContent = formatNPR(r.monthlyCost);
    $('res-subline').textContent = `${vlabel} · ${flabel} · ${formatNumberIN(r.monthlyKm)} km/month`;
    $('stat-year').textContent = formatNPR(r.annualCost);
    $('stat-perkm').textContent = `Rs. ${r.costPerKm.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`;
    $('stat-period-label').textContent = `${r.period.years}-year total`;
    $('stat-period').textContent = formatNPR(r.period.totalCost);
    $('stat-run').textContent = `Rs. ${r.runningCostPerKm.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`;

    const depRow = $('dep-hero-row');
    if (r.depreciation > 0) {
      depRow.classList.remove('hidden');
      $('dep-hero-label').textContent = `${r.period.years}-year incl. depreciation`;
      $('dep-hero-val').textContent = formatNPR(r.totalCostIncludingDepreciation);
    } else {
      depRow.classList.add('hidden');
    }

    const max = r.breakdown.length > 0 ? r.breakdown[0].monthly : 0;
    $('res-rows').innerHTML = r.breakdown.length > 0
      ? r.breakdown.map((b) => {
          const pct = max > 0 ? Math.max(4, Math.round((b.monthly / max) * 100)) : 0;
          return `<div><div class="result-row" style="padding-bottom:0;"><span>${b.name}</span><span class="rv">${formatNPR(b.monthly)}/mo · ${b.pct}%</span></div>` +
            `<div class="top-bar"><div class="top-fill" style="width:${pct}%;"></div></div>` +
            `<div class="text-[11px] pb-1" style="color:var(--nk-text-tertiary);">${formatNPR(b.annual)}/year</div></div>`;
        }).join('')
      : rowHTML('No costs entered yet', 'Enter amounts on the left');

    const loanBox = $('loan-box');
    if (r.loan.enabled && r.emi.emi > 0) {
      loanBox.classList.remove('hidden');
      $('loan-rows').innerHTML =
        kvHTML('Monthly EMI', formatNPR(r.emi.emi)) +
        kvHTML('Principal', formatNPR(r.emi.principal)) +
        kvHTML('Total interest', formatNPR(r.emi.totalInterest)) +
        kvHTML('Total payment', formatNPR(r.emi.totalPayment)) +
        kvHTML(`Paid in ${r.period.years} yrs (${r.period.loanMonthsPaid} mo)`, formatNPR(r.period.loanPaid));
    } else {
      loanBox.classList.add('hidden');
    }

    const depBox = $('dep-box');
    if (r.depreciation > 0) {
      depBox.classList.remove('hidden');
      const buy = sanitizeAmount(input.depreciation.purchasePrice);
      $('dep-rows').innerHTML =
        kvHTML('Purchase price', formatNPR(buy)) +
        kvHTML('Resale value', formatNPR(sanitizeAmount(input.depreciation.resaleValue))) +
        kvHTML('Depreciation', formatNPR(r.depreciation));
    } else {
      depBox.classList.add('hidden');
    }

    const warnBox = $('res-warnings');
    warnBox.innerHTML = '';
    warnBox.classList.toggle('hidden', r.warnings.length === 0);
    r.warnings.forEach((w) => {
      const d = document.createElement('div');
      d.className = 'warn-line';
      d.textContent = w;
      warnBox.appendChild(d);
    });

    buildSummary(input, r);
    document.querySelector('#result-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function buildSummary(input, r) {
    const lines = ['SolutionsNepal — Vehicle Ownership Cost'];
    lines.push(`Vehicle: ${vehicleType === 'bike' ? 'Motorcycle / Scooter' : 'Car / Jeep'} (${r.fuelType})`);
    lines.push(`Driving: ${formatNumberIN(r.monthlyKm)} km/month`);
    lines.push(`Monthly: ${formatNPR(r.monthlyCost)}`);
    lines.push(`Yearly: ${formatNPR(r.annualCost)}`);
    lines.push(`${r.period.years}-year total: ${formatNPR(r.period.totalCost)}`);
    lines.push(`Cost per km: Rs. ${r.costPerKm} (running: Rs. ${r.runningCostPerKm})`);
    lines.push('Breakdown (monthly):');
    r.breakdown.forEach((b) => lines.push(`- ${b.name}: ${formatNPR(b.monthly)} (${b.pct}%)`));
    if (r.loan.enabled) lines.push(`Loan: EMI ${formatNPR(r.emi.emi)} × ${r.emi.months} mo, interest ${formatNPR(r.emi.totalInterest)}`);
    if (r.depreciation > 0) lines.push(`Depreciation: ${formatNPR(r.depreciation)} → ${r.period.years}-yr incl. dep: ${formatNPR(r.totalCostIncludingDepreciation)}`);
    lastSummary = lines.join('\n');
  }

  $('calc-btn').addEventListener('click', doCalc);
  ['monthlyKm', 'efficiency', 'energyPrice', 'loanAmount', 'loanRate', 'loanDur', 'depPurchase', 'depResale'].forEach((id) => {
    const el = $(id);
    if (el) el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doCalc(); });
  });

  $('copy-btn').addEventListener('click', async () => {
    const btn = $('copy-btn');
    try {
      await navigator.clipboard.writeText(lastSummary || 'SolutionsNepal — Vehicle Ownership Cost');
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.innerHTML = 'Copy summary'; }, 2000);
    } catch { /* clipboard unavailable */ }
  });

  // ── Compare A vs B ──
  function collectSide(side) {
    const v = (id) => $(`cmp-${side}-${id}`).value;
    return {
      name: v('name') || (side === 'a' ? 'Vehicle A' : 'Vehicle B'),
      fuelType: $(`cmp-${side}-fuel`).value,
      monthlyKm: v('km'),
      efficiency: v('eff'),
      energyPrice: v('price'),
      loan: { enabled: false, amount: 0, annualRatePct: 0, months: 0 },
      annual: { otherAnnual: v('annual') },
      maintenance: { mode: 'simple', simpleAnnual: v('maint') },
      // EMI entered directly counts as a monthly cash cost here.
      recurring: { otherMonthly: String((parseAmount(v('emi')).value || 0) + (parseAmount(v('monthly')).value || 0)) },
      depreciation: { enabled: false },
    };
  }
  $('cmp-btn').addEventListener('click', () => {
    const err = $('err-cmp');
    err.classList.add('hidden');
    const box = $('cmp-result');
    const a = summarizeOwnership(collectSide('a'));
    const b = summarizeOwnership(collectSide('b'));
    if (!a.valid || !b.valid) {
      const msgs = [...Object.values(a.errors || {}), ...Object.values(b.errors || {})];
      err.textContent = msgs[0] || 'Enter distance, efficiency and price for both vehicles.';
      err.classList.remove('hidden');
      box.classList.add('hidden');
      return;
    }
    const nameA = $('cmp-a-name').value || 'Vehicle A';
    const nameB = $('cmp-b-name').value || 'Vehicle B';
    const rows = [
      ['Monthly cost', a.monthly, b.monthly, 'low'],
      ['Annual cost', a.annual, b.annual, 'low'],
      ['Cost per km', a.perKm, b.perKm, 'low'],
      ['5-year cost', a.fiveYear, b.fiveYear, 'low'],
    ];
    const fmt = (k, v) => (k === 'Cost per km' ? `Rs. ${v.toLocaleString('en-IN', { maximumFractionDigits: 2 })}` : formatNPR(v));
    box.innerHTML = `<table class="cmp-table"><thead><tr><th></th><th>${nameA}</th><th>${nameB}</th></tr></thead><tbody>` +
      rows.map(([k, va, vb]) => {
        const aWin = va < vb; const bWin = vb < va;
        return `<tr><td style="color:var(--nk-text-secondary);">${k}</td><td class="${aWin ? 'win' : ''}">${fmt(k, va)}</td><td class="${bWin ? 'win' : ''}">${fmt(k, vb)}</td></tr>`;
      }).join('') + '</tbody></table>';
    box.classList.remove('hidden');
  });

  // ── Reset / save (localStorage only) ──
  function snapshot() {
    const snap = { vehicleType, fuelType, maintMode, durUnit, periodYears };
    ['purchase', 'down', 'loanAmount', 'loanRate', 'loanDur', 'monthlyKm', 'efficiency', 'energyPrice', 'maintSimple', 'depPurchase', 'depResale'].forEach((id) => {
      snap[id] = $(id) ? $(id).value : '';
    });
    snap.noloan = $('noloan').checked;
    snap.depOn = $('depToggle').checked;
    snap.annual = {}; snap.detailed = {}; snap.recurring = {};
    document.querySelectorAll('.ann-input').forEach((el) => { snap.annual[el.dataset.key] = el.value; });
    document.querySelectorAll('.maint-input').forEach((el) => { snap.detailed[el.dataset.key] = el.value; });
    document.querySelectorAll('.rec-input').forEach((el) => { snap.recurring[el.dataset.key] = el.value; });
    return snap;
  }
  function restore(snap) {
    if (!snap || typeof snap !== 'object') return false;
    const setVal = (id, v) => { const el = $(id); if (el && v !== undefined) el.value = v; };
    ['purchase', 'down', 'loanAmount', 'loanRate', 'loanDur', 'monthlyKm', 'efficiency', 'energyPrice', 'maintSimple', 'depPurchase', 'depResale'].forEach((id) => setVal(id, snap[id]));
    if (snap.vehicleType) {
      vehicleType = snap.vehicleType;
      document.querySelectorAll('.seg-btn[data-vtype]').forEach((x) => {
        const on = x.dataset.vtype === vehicleType;
        x.classList.toggle('seg-active', on);
        x.setAttribute('aria-checked', String(on));
      });
    }
    if (snap.fuelType) {
      fuelType = snap.fuelType;
      document.querySelectorAll('.fuel-chip[data-fuel]').forEach((x) => {
        const on = x.dataset.fuel === fuelType;
        x.classList.toggle('chip-active', on);
        x.setAttribute('aria-checked', String(on));
      });
    }
    if (snap.maintMode) {
      maintMode = snap.maintMode;
      document.querySelectorAll('[data-mmode]').forEach((x) => x.classList.toggle('unit-active', x.dataset.mmode === maintMode));
      $('maint-simple-wrap').classList.toggle('hidden', maintMode !== 'simple');
      $('maint-detail-wrap').classList.toggle('hidden', maintMode !== 'detailed');
    }
    if (snap.durUnit) {
      durUnit = snap.durUnit;
      document.querySelectorAll('[data-dunit]').forEach((x) => x.classList.toggle('unit-active', x.dataset.dunit === durUnit));
    }
    if (snap.periodYears) {
      periodYears = Number(snap.periodYears);
      document.querySelectorAll('.per-btn[data-years]').forEach((x) => {
        const on = Number(x.dataset.years) === periodYears;
        x.classList.toggle('per-active', on);
        x.setAttribute('aria-checked', String(on));
      });
    }
    if (snap.noloan !== undefined) {
      $('noloan').checked = !!snap.noloan;
      $('loan-grid').classList.toggle('hidden', !!snap.noloan);
    }
    if (snap.depOn !== undefined) {
      $('depToggle').checked = !!snap.depOn;
      $('dep-grid').classList.toggle('hidden', !snap.depOn);
    }
    for (const [cls, obj] of [['ann-input', snap.annual], ['maint-input', snap.detailed], ['rec-input', snap.recurring]]) {
      if (obj) document.querySelectorAll(`.${cls}`).forEach((el) => { if (obj[el.dataset.key] !== undefined) el.value = obj[el.dataset.key]; });
    }
    return true;
  }

  $('reset-btn').addEventListener('click', () => {
    try { localStorage.removeItem(STORAGE_KEY); } catch { /* private mode */ }
    vehicleType = 'bike'; fuelType = 'petrol'; maintMode = 'simple'; durUnit = 'years'; periodYears = 5;
    document.querySelectorAll('.seg-btn[data-vtype]').forEach((x) => {
      const on = x.dataset.vtype === 'bike';
      x.classList.toggle('seg-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    document.querySelectorAll('.fuel-chip[data-fuel]').forEach((x) => {
      const on = x.dataset.fuel === 'petrol';
      x.classList.toggle('chip-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    document.querySelectorAll('[data-mmode]').forEach((x) => x.classList.toggle('unit-active', x.dataset.mmode === 'simple'));
    document.querySelectorAll('[data-dunit]').forEach((x) => x.classList.toggle('unit-active', x.dataset.dunit === 'years'));
    document.querySelectorAll('.per-btn[data-years]').forEach((x) => {
      const on = Number(x.dataset.years) === 5;
      x.classList.toggle('per-active', on);
      x.setAttribute('aria-checked', String(on));
    });
    ['purchase', 'down', 'loanAmount', 'loanRate', 'loanDur', 'monthlyKm', 'efficiency', 'energyPrice', 'maintSimple', 'depPurchase', 'depResale'].forEach((id) => { $(id).value = ''; });
    document.querySelectorAll('.ann-input,.maint-input,.rec-input').forEach((el) => { el.value = ''; });
    $('noloan').checked = true;
    $('loan-grid').classList.add('hidden');
    $('depToggle').checked = false;
    $('dep-grid').classList.add('hidden');
    $('maint-simple-wrap').classList.remove('hidden');
    $('maint-detail-wrap').classList.add('hidden');
    $('cmp-result').classList.add('hidden');
    $('res-body').classList.add('hidden');
    $('res-empty').classList.remove('hidden');
    showErrors({});
    applyVehicleExamples();
    updateEmiPreview();
  });

  $('save-btn').addEventListener('click', () => {
    const btn = $('save-btn');
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot()));
      btn.textContent = 'Saved!';
      setTimeout(() => { btn.innerHTML = 'Save inputs'; }, 2000);
    } catch {
      btn.textContent = 'Could not save';
      setTimeout(() => { btn.innerHTML = 'Save inputs'; }, 2000);
    }
  });

  // ── Init ──
  (function init() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) restore(JSON.parse(raw));
    } catch { /* corrupted storage — start fresh */ }
    applyVehicleExamples();
    updateEfficiencyUI();
    updateEmiPreview();
  })();
</script>
