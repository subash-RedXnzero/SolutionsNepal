---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import NepaliNumberConverter from '../../../components/tools/NepaliNumberConverter.astro';
import Disclaimer from '../../../components/ui/Disclaimer.astro';

const title = 'Number to Nepali Words | SolutionsNepal';
const description = 'Convert numbers to Nepali words instantly: 1,00,000 → एक लाख, 1,00,00,000 → एक करोड. Accurate Devanagari number wording for any value, up to neel.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-[1000px] px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Tools', href: '/nepal' },
      { label: 'Number to Nepali Words' },
    ]} />

    <div class="mb-5">
      <h1 class="text-[22px] sm:text-[28px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color:var(--nk-text);">Numbers in Nepali Words (अंक → शब्द)</h1>
      <p class="text-[13px] leading-relaxed" style="color:var(--nk-text-secondary);">Type any number and read it correctly in Devanagari — from एक all the way to नील.</p>
    </div>

    <NepaliNumberConverter initialInput="100000" />

    <div class="mt-10 max-w-3xl space-y-8">
      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">How Nepali number words work</h2>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          Nepali has unique words for every number 0–99 (एक, दुई … उनान्सय), then combines them with scale
          words: सय (hundred), हजार (thousand), लाख (lakh), करोड (crore), अर्ब (arab), खर्ब (kharab) and नील.
          So 2,34,567 is read as दुई लाख चौंतीस हजार पाँच सय सत्ताइस — the same rhythm as the comma grouping.
          This converter applies those combinations grammatically rather than translating digit-by-digit.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Scale reference</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {[
            ['1,000', 'एक हजार'],
            ['10,000', 'दस हजार'],
            ['1,00,000', 'एक लाख'],
            ['10,00,000', 'दस लाख'],
            ['1,00,00,000', 'एक करोड'],
            ['1,00,00,00,000', 'एक अर्ब'],
          ].map(([num, np]) => (
            <div class="rounded-lg border px-3 py-2.5" style="border-color:var(--nk-border);background-color:var(--nk-bg);">
              <span class="block text-[12.5px] font-bold" style="color:var(--nk-text);">{num}</span>
              <span class="block text-[11.5px] mt-0.5" lang="ne" style="color:var(--nk-text-secondary);">{np}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Devanagari digits</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          The Digits tab shows both forms side by side — 12,50,000 and १२,५०,०००. You can also paste
          Devanagari digits into the input; they are recognized automatically.
        </p>
      </section>

      <p class="text-sm" style="color:var(--nk-text-secondary);">
        Related: <a class="underline hover:opacity-80" href="/nepal/tools/nepali-number-to-words" style="color:var(--nk-accent);">main converter</a> ·
        <a class="underline hover:opacity-80" href="/nepal/tools/nepali-number-converter" style="color:var(--nk-accent);">Nepali number converter</a>.
      </p>
    </div>
  </div>
  <Disclaimer variant="general" />
</BaseLayout>
