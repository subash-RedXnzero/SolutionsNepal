---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../components/ui/RelatedTools.astro';
import NepaliNumberConverter from '../../../components/tools/NepaliNumberConverter.astro';
import { convertAll } from '../../../lib/calculators/nepali-numbers.js';
import Disclaimer from '../../../components/ui/Disclaimer.astro';

const title = 'Nepali Number to Words — Rupees | SolutionsNepal';
const description = 'Convert numbers into Nepali words, Nepali digits and rupees in words. Perfect for cheques, bills, agreements, invoices and documents.';

// Examples generated by the real engine at build time — never hard-coded.
const EXAMPLES = [1000, 10000, 100000, 1250000, 12500000].map((n) => {
  const r = convertAll(String(n), { mode: 'number' });
  return { formatted: r.formattedAscii, nepaliDigits: r.currencyNepali.replace('रु. ', ''), npWords: r.nepaliWords };
});

const faqItems = [
  {
    q: 'How do I write numbers in Nepali words?',
    a: 'Type any number above and the Nepali wording appears instantly — for example 1,000 becomes एक हजार and 12,50,000 becomes बाह्र लाख पचास हजार. The tool uses the Nepal/Indian numbering system (Thousand · Lakh · Crore), never the Western million/billion system.',
  },
  {
    q: 'How do I write Rs. 1,25,000 in words?',
    a: 'Enter 1,25,000 (or 125000) above in Currency mode: the Nepali output is रुपैयाँ एक लाख पच्चीस हजार मात्र and the English output is Rupees One Lakh Twenty-Five Thousand Only.',
  },
  {
    q: 'How do I write cheque amounts in Nepali?',
    a: 'Enter your amount, keep Cheque mode on, and open the Cheque tab — you get both रुपैयाँ … मात्र and "Rupees … Only", ready to copy straight onto a cheque, invoice or agreement.',
  },
  {
    q: 'What is 1 crore in Nepali?',
    a: '1 crore = 1,00,00,000 (एक करोड). It equals ten million in the Western system. The scale order in Nepal is: हजार (thousand), लाख (lakh = 100 thousand), करोड (crore = 100 lakh), then अर्ब and खर्ब.',
  },
  {
    q: 'How do I convert Nepali digits to English numbers?',
    a: 'Paste Devanagari digits like १२५०००० directly into the input box — they are normalized automatically. The Digits tab then shows both forms: 12,50,000 and १२,५०,०००.',
  },
  {
    q: 'How do I write 12,50,000 in words?',
    a: 'In Nepali: बाह्र लाख पचास हजार. In English: Twelve Lakh Fifty Thousand. For cheques: रुपैयाँ बाह्र लाख पचास हजार मात्र / Rupees Twelve Lakh Fifty Thousand Only.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Nepali Number to Words Converter',
      description: 'Convert numbers into Nepali words, Nepali digits and rupees in words for cheques, bills and documents.',
      url: 'https://solutionsnepal.com/nepal/tools/nepali-number-to-words',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ]}
>
  <div class="mx-auto max-w-[1000px] px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Tools', href: '/nepal' },
      { label: 'Number to Words' },
    ]} />

    <div class="mb-5">
      <h1 class="text-[22px] sm:text-[28px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color:var(--nk-text);">Nepali Number to Words Converter</h1>
      <p class="text-[13px] leading-relaxed" style="color:var(--nk-text-secondary);">Convert numbers into Nepali words, rupees-in-words and cheque-ready text — instant, accurate and offline in your browser.</p>
    </div>

    <NepaliNumberConverter />

    <!-- Examples -->
    <div class="nk-card p-5 mt-5">
      <p class="text-[13px] font-semibold mb-3" style="color:var(--nk-text);">Examples</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
        {EXAMPLES.map((ex) => (
          <button
            class="example-card text-left rounded-lg border p-3 transition-all hover:-translate-y-px"
            style="border-color:var(--nk-border);background-color:var(--nk-bg);"
            data-value={ex.formatted.replace(/,/g, '')}
          >
            <span class="block text-[13px] font-bold tracking-wide" style="color:var(--nk-text);">{ex.formatted}</span>
            <span class="block text-[11.5px] mt-1 leading-snug" lang="ne" style="color:var(--nk-text-secondary);">{ex.npWords}</span>
          </button>
        ))}
      </div>
      <p class="mt-2 text-[10.5px]" style="color:var(--nk-text-tertiary);">Tap any example to load it into the converter.</p>
    </div>

    <!-- SEO content -->
    <div class="mt-10 max-w-3xl space-y-8">
      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">The Nepal number system</h2>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          Nepal counts in thousands, lakhs and crores rather than millions: one लाख (lakh) is 1,00,000
          and one करोड (crore) is 1,00,00,000. Commas follow the same rhythm — the first three digits,
          then pairs: 12,50,000 reads as twelve lakh fifty thousand. This tool formats, digit-converts and
          word-converts every value strictly in that system, so documents stay consistent with how amounts
          are actually written on Nepali cheques, invoices and legal papers.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Built for cheques and official documents</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          Banks require cheque amounts written in words to end with मात्र (or "Only" in English) so nothing
          can be appended after them. Cheque mode handles this automatically and gives you both languages.
          Decimal amounts are treated as paisa — Rs. 1,250.50 becomes रुपैयाँ एक हजार दुई सय पचास र पचास पैसा मात्र.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Private and offline</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          All conversion runs locally in your browser using a deterministic word-mapping engine — no external
          translation service ever sees your numbers.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">How Nepali number words work</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">
          Nepali has unique words for every number 0–99 (एक, दुई … उनान्सय), then combines them with scale
          words: सय (hundred), हजार (thousand), लाख (lakh), करोड (crore), अर्ब (arab), खर्ब (kharab) and नील.
          So 2,34,567 is read as दुई लाख चौंतीस हजार पाँच सय सत्ताइस — the same rhythm as the comma grouping.
          This converter applies those combinations grammatically rather than translating digit-by-digit, so
          values stay correct all the way up to नील rather than stopping at lakh or crore.
        </p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Scale reference</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {[
            ['1,000', 'एक हजार'],
            ['10,000', 'दस हजार'],
            ['1,00,000', 'एक लाख'],
            ['10,00,000', 'दस लाख'],
            ['1,00,00,000', 'एक करोड'],
            ['1,00,00,00,000', 'एक अर्ब'],
          ].map(([num, np]) => (
            <div class="rounded-lg border px-3 py-2.5" style="border-color:var(--nk-border);background-color:var(--nk-bg);">
              <span class="block text-[12.5px] font-bold" style="color:var(--nk-text);">{num}</span>
              <span class="block text-[11.5px] mt-0.5" lang="ne" style="color:var(--nk-text-secondary);">{np}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">Frequently Asked Questions</h2>
        <div class="space-y-2">
          {faqItems.map((item) => (
            <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
              <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">{item.q}</summary>
              <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">{item.a}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Related tools</h3>
        <ul class="text-sm leading-relaxed space-y-1" style="color:var(--nk-text-secondary);">
          <li>• <a class="underline hover:opacity-80" href="/nepal/tools/rupees-to-words" style="color:var(--nk-accent);">Rupees to Words</a> — focused currency-wording view</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/tools/cheque-amount-in-words" style="color:var(--nk-accent);">Cheque Amount in Words</a></li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/tools/nepali-number-converter" style="color:var(--nk-accent);">Nepali Number Converter</a> — Devanagari digits, lakh/crore grouping and words</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/vat-calculator" style="color:var(--nk-accent);">VAT Calculator</a> — add or remove 13% VAT</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/sip-calculator" style="color:var(--nk-accent);">SIP Calculator</a> — project investment growth</li>
        </ul>
      </section>
    </div>

    <Disclaimer variant="general" />
    <RelatedTools tools={[
      { title: 'VAT Calculator', description: 'Add or remove 13% VAT instantly', href: '/nepal/finance/vat-calculator' },
      { title: 'SIP Calculator', description: 'Calculate SIP returns & investment growth', href: '/nepal/finance/sip-calculator' },
    ]} />
  </div>
</BaseLayout>

<script>
  // Example cards load their value into the converter input.
  document.querySelectorAll<HTMLElement>('.example-card').forEach((card) =>
    card.addEventListener('click', () => {
      const input = document.getElementById('nnw-input') as HTMLInputElement | null;
      if (!input) return;
      input.value = card.dataset.value || '';
      input.dispatchEvent(new Event('input'));
      input.focus();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
</script>
