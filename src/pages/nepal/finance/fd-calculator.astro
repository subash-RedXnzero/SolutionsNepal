---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../components/ui/RelatedTools.astro';

const title = 'FD Calculator Nepal – Fixed Deposit Maturity & Interest | SolutionsNepal';
const description = 'Calculate fixed deposit returns in Nepal. Estimate FD maturity value, interest and after-tax payout with quarterly, monthly or annual compounding.';

const faqItems = [
  {
    q: 'What is a fixed deposit (FD)?',
    a: 'A fixed deposit is a lump sum you lock with a bank or financial institution for a fixed term — 3 months, 1 year, 5 years — at an agreed interest rate. In return for locking your money, the bank pays a higher rate than a savings account. At maturity you get your principal back plus interest.',
  },
  {
    q: 'How is FD interest calculated in Nepal?',
    a: 'This calculator uses the standard compound-interest formula: A = P × (1 + r/n)^(n×t), where P is your deposit, r is the annual rate, n is the number of compounding periods per year and t is the tenure in years. Most Nepali banks compound FD interest quarterly, which is the default here — change it to match your bank\'s terms.',
  },
  {
    q: 'What FD interest rates do Nepali banks offer?',
    a: 'Rates differ by bank, tenure and depositor type, and banks revise their published rates regularly — sometimes monthly. Always enter your own bank\'s current published rate for the exact tenure you plan. This calculator never assumes a rate for you.',
  },
  {
    q: 'Is there tax on FD interest in Nepal?',
    a: 'Yes — banks withhold tax on the interest (commonly 5% for individual depositors) before payout, so the amount you actually receive is slightly less than this calculator\'s gross figure. Tax rules can change, so confirm the current rate with your bank.',
  },
  {
    q: 'Can I break a fixed deposit early?',
    a: 'Usually yes, but banks typically pay a reduced rate or charge a penalty for premature withdrawal, as per their published terms. If you might need the money early, check your bank\'s premature-closure rule before opening the FD.',
  },
  {
    q: 'Is an FD better than a savings account?',
    a: 'For money you will not need during the term, an FD almost always earns more because the rate is higher and locked in. A savings account earns less but lets you withdraw anytime. Many people keep emergency money in savings and goal-based money (a year or more away) in FDs.',
  },
  {
    q: 'What tenure should I choose for my FD?',
    a: 'Match the tenure to when you need the money — a fee due in 1 year suits a 1-year FD. Longer tenures often carry higher rates, but locking money you will need early triggers penalties. Splitting a large sum across multiple tenures (laddering) keeps some money maturing sooner.',
  },
  {
    q: 'Can I share my FD calculation with someone?',
    a: 'Yes — every input is mirrored in the page address, so just use the "Copy result link" button and send it on Viber, Messenger or Facebook. Whoever opens the link sees the calculator with your exact inputs and result. Nothing is uploaded or stored anywhere.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'FD Calculator Nepal',
      description: 'Calculate fixed deposit maturity value, interest and after-tax payout in Nepal with quarterly, monthly or annual compounding.',
      url: 'https://solutionsnepal.com/nepal/finance/fd-calculator',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ]}
>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 py-6 sm:py-8">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Finance', href: '/nepal/finance' },
      { label: 'FD Calculator' },
    ]} />

    <div class="mb-5">
      <h1 class="text-[22px] sm:text-[28px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color:var(--nk-text);">FD Calculator Nepal</h1>
      <p class="text-[13px] leading-relaxed" style="color:var(--nk-text-secondary);">Estimate your fixed deposit maturity value, interest earned and after-tax payout — with the compounding your bank actually uses.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_380px] gap-5 items-start">

      <!-- ═══ LEFT: INPUTS ═══ -->
      <div class="nk-card p-5 space-y-4">
        <div>
          <label for="fd-principal" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Principal amount</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">Rs.</span>
            <input inputmode="decimal" id="fd-principal" type="number" min="0" step="10000" placeholder="e.g. 500000" class="nk-input" style="padding-left:3rem;" />
          </div>
          <p class="field-error hidden text-[11px] mt-1" style="color:#dc2626;"></p>
        </div>

        <div>
          <label for="fd-rate" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Interest rate (%)</label>
          <div class="relative">
            <input inputmode="decimal" id="fd-rate" type="number" min="0" max="100" step="0.05" placeholder="e.g. 8" class="nk-input" style="padding-right:2.2rem;" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[12px]" style="color:var(--nk-text-tertiary);">%</span>
          </div>
          <p class="field-error hidden text-[11px] mt-1" style="color:#dc2626;"></p>
        </div>

        <div>
          <label for="fd-tenure" class="block text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Tenure (years)</label>
          <input inputmode="decimal" id="fd-tenure" type="number" min="0.25" max="30" step="1" placeholder="e.g. 2" class="nk-input" />
          <p class="field-error hidden text-[11px] mt-1" style="color:#dc2626;"></p>
        </div>

        <p class="text-[11px] leading-relaxed" style="color:var(--nk-text-tertiary);">Calculated with quarterly compounding — what most Nepali banks use. Your bank deducts tax on the interest before payout.</p>

        <button id="calc-btn" class="nk-btn nk-btn-primary w-full py-2.5">Calculate</button>
      </div>

      <!-- ═══ RIGHT: RESULT ═══ -->
      <div class="md:sticky md:top-4 space-y-4">
        <div class="nk-card p-5" id="result-card" style="display:none;">
          <div class="rounded-xl py-5 px-4 text-center mb-3" style="background-color:var(--nk-accent-subtle);">
            <p class="text-[12px] font-medium mb-1" style="color:var(--nk-text-secondary);">Total amount</p>
            <p class="text-[28px] sm:text-[32px] font-bold tracking-tight leading-none" style="color:var(--nk-accent);" id="out-total">—</p>
          </div>

          <div class="flex items-center justify-between text-[14px] py-2" style="border-top:1px solid var(--nk-border);">
            <span style="color:var(--nk-text-secondary);">Principal amount</span>
            <strong class="font-semibold" style="color:var(--nk-text);" id="out-principal">—</strong>
          </div>
          <div class="flex items-center justify-between text-[14px] py-2" style="border-top:1px solid var(--nk-border);border-bottom:1px solid var(--nk-border);">
            <span style="color:var(--nk-text-secondary);">Interest amount</span>
            <strong class="font-semibold" style="color:var(--nk-accent);" id="out-interest">—</strong>
          </div>

          <div class="flex items-center justify-center py-4">
            <svg id="fd-donut" viewBox="0 0 140 140" width="170" height="170" role="img" aria-label="Principal versus interest chart">
              <circle cx="70" cy="70" r="54" fill="none" stroke="var(--nk-border)" stroke-width="20" />
              <circle id="fd-donut-arc" cx="70" cy="70" r="54" fill="none" stroke="var(--nk-accent)" stroke-width="20" stroke-linecap="round" transform="rotate(-90 70 70)" stroke-dasharray="0 339.292" />
            </svg>
          </div>
          <div class="flex items-center justify-center gap-5 text-[12px] pb-1" style="color:var(--nk-text-secondary);">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm inline-block" style="background-color:var(--nk-border);"></span>Principal</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background-color:var(--nk-accent);"></span>Interest</span>
          </div>

          <button id="copy-link-btn" class="nk-btn nk-btn-ghost w-full py-2 mt-2 text-[12.5px]">Copy result link</button>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="mt-5 rounded-lg border px-4 py-3 text-[11.5px] leading-relaxed" style="border-color:var(--nk-border);background-color:var(--nk-bg);color:var(--nk-text-secondary);">
      ⚠️ <strong style="color:var(--nk-text);">Disclaimer:</strong> This calculator provides an estimate using the rate and compounding you enter. Actual FD payouts depend on your bank's published rate, tenure slabs, premature-withdrawal rules and current tax deduction. Confirm all figures with your bank before depositing.
    </div>

    <!-- SEO content -->
    <div class="mt-10 max-w-3xl space-y-8">
      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">What is a fixed deposit?</h2>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">A fixed deposit (FD) means handing a lump sum to a bank for a fixed period — say Rs. 5 lakh for 1 year — at a rate agreed upfront. Because the bank knows it can use your money for the whole term, it pays more than a savings account. At the end of the term (maturity), you receive your deposit back with interest. It is one of the simplest, lowest-risk places to park goal-based savings in Nepal.</p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">How is FD maturity calculated?</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Banks compound FD interest, usually every quarter: each period's interest is added to the balance, and the next period earns interest on the bigger amount. The formula is <code class="text-[12px] px-1 rounded" style="background-color:var(--nk-bg);">A = P × (1 + r/n)^(n×t)</code> — for example Rs. 1,00,000 at 8% compounded quarterly for 1 year grows to about Rs. 1,08,243, slightly more than the Rs. 1,08,000 annual compounding would give. Small frequency differences compound into real money over multi-year deposits.</p>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">FD vs savings account vs SIP</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Use a savings account for emergency money you may need any day, an FD for money with a known future date (fees, a down payment, a planned purchase), and market-linked options like SIPs only for long-term goals where you accept fluctuation. They complement each other — most savers use all three for different jobs.</p>
      </section>

      <section>
        <h2 class="text-base font-bold mb-2" style="color:var(--nk-text);">Frequently Asked Questions</h2>
        <div class="space-y-2">
          {faqItems.map((item) => (
            <details class="rounded-lg border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
              <summary class="px-4 py-2.5 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">{item.q}</summary>
              <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">{item.a}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section>
        <h3 class="text-sm font-semibold mb-2" style="color:var(--nk-text);">Related finance tools</h3>
        <ul class="text-sm leading-relaxed space-y-1" style="color:var(--nk-text-secondary);">
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/sip-calculator" style="color:var(--nk-accent);">SIP Calculator</a> — compare market-linked investing against your FD return</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/emi-calculator" style="color:var(--nk-accent);">EMI Calculator</a> — plan loan repayments alongside your savings</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance/salary-checker" style="color:var(--nk-accent);">Salary Calculator</a> — find out how much of your pay you can set aside</li>
          <li>• <a class="underline hover:opacity-80" href="/nepal/finance" style="color:var(--nk-accent);">All finance tools</a> — tax, rent, overtime and more</li>
        </ul>
      </section>
    </div>

    <RelatedTools tools={[
      { title: 'SIP Calculator', description: 'Project monthly & step-up SIP growth', href: '/nepal/finance/sip-calculator' },
      { title: 'EMI Calculator', description: 'Calculate home & car loan EMIs', href: '/nepal/finance/emi-calculator' },
    ]} />
  </div>
</BaseLayout>

<script>
  import {
    calcFd,
    formatNPR,
    validateField,
  } from '../../../lib/calculators/fd.js';
  import {
    readSharedParams,
    syncUrl,
    copyLink,
  } from '../../../lib/share-params.js';

  const $ = (id) => document.getElementById(id);

  // Shareable result links: param → input id. Restored on load,
  // mirrored to the address bar on every change. Fixed quarterly
  // compounding (what most Nepali banks use) — no option needed.
  const FD_PARAMS = {
    p: 'fd-principal',
    rate: 'fd-rate',
    tenure: 'fd-tenure',
  };
  const DONUT_C = 2 * Math.PI * 54;

  function showError(input, msg) {
    const err = input.closest('div')?.parentElement?.querySelector('.field-error')
      ?? input.parentElement?.parentElement?.querySelector('.field-error');
    if (err) {
      err.textContent = msg || '';
      err.classList.toggle('hidden', !msg);
    }
    input.style.borderColor = msg ? '#dc2626' : '';
  }

  function readPrincipal() {
    const input = $('fd-principal');
    const res = validateField(input.value, { label: 'a principal amount greater than Rs. 0', min: 0, max: 1e10 });
    showError(input, res.ok ? null : res.error);
    return res;
  }

  function readTenure() {
    const input = $('fd-tenure');
    const raw = typeof input.value === 'string' ? input.value.trim() : input.value;
    if (raw === '' || raw === null || raw === undefined) {
      showError(input, 'Enter a tenure greater than 0.');
      return { ok: false };
    }
    const num = Number(raw);
    if (!Number.isFinite(num) || num <= 0) {
      showError(input, 'Enter a tenure greater than 0.');
      return { ok: false };
    }
    if (num > 30) {
      showError(input, 'Tenure is too large (max 30 years).');
      return { ok: false };
    }
    showError(input, null);
    return { ok: true, value: num };
  }

  function readRate() {
    const input = $('fd-rate');
    const raw = typeof input.value === 'string' ? input.value.trim() : input.value;
    if (raw === '' || raw === null || raw === undefined) {
      showError(input, 'Enter an interest rate.');
      return { ok: false };
    }
    const num = Number(raw);
    if (!Number.isFinite(num) || num < 0 || num > 100) {
      showError(input, 'Enter a rate between 0% and 100%.');
      return { ok: false };
    }
    showError(input, null);
    return { ok: true, value: num };
  }

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(e => e.classList.add('hidden'));
  }

  function setResultVisible(v) {
    $('result-card').style.display = v ? '' : 'none';
  }

  function invalidate() {
    setResultVisible(false);
  }

  function recalc() {
    clearErrors();
    const p = readPrincipal();
    const t = readTenure();
    const r = readRate();
    if (!p.ok || !t.ok || !r.ok) return invalidate();
    syncUrl(FD_PARAMS);

    const { maturity, interest } = calcFd(p.value, r.value, t.value, 'quarterly');

    $('out-total').textContent = formatNPR(maturity);
    $('out-principal').textContent = formatNPR(p.value);
    $('out-interest').textContent = formatNPR(interest);

    const frac = maturity > 0 ? Math.min(1, Math.max(0, interest / maturity)) : 0;
    $('fd-donut-arc').setAttribute('stroke-dasharray', `${(frac * DONUT_C).toFixed(3)} ${DONUT_C.toFixed(3)}`);
    setResultVisible(true);
  }

  $('calc-btn').addEventListener('click', () => {
    recalc();
    if ($('result-card').style.display !== 'none') {
      $('result-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
  ['fd-principal', 'fd-tenure', 'fd-rate'].forEach(id => {
    $(id).addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); $('calc-btn').click(); }
    });
  });

  $('copy-link-btn').addEventListener('click', async () => {
    const btn = $('copy-link-btn');
    const original = btn.textContent;
    syncUrl(FD_PARAMS);
    const ok = await copyLink();
    btn.textContent = ok ? 'Link copied ✓' : 'Copy failed — copy the address bar URL';
    setTimeout(() => { btn.textContent = original; }, 2200);
  });

  readSharedParams(FD_PARAMS, location.search);
  recalc();
</script>
