  <script type="application/json" id="foreign-job-fx-data" set:html={JSON.stringify({ currencyOptions, forexMeta })} />
  <script>
    import { calculateSavings, compareOffers, formatNumber, formatNPR, buildShareText } from '../../../../lib/calculators/foreign-job-savings.js';
    import { COUNTRIES, getCountryById, savingsBand } from '../../../../data/foreign-job-savings.js';

    const { currencyOptions, forexMeta } = JSON.parse(document.getElementById('foreign-job-fx-data').textContent);

    const $ = (s) => document.querySelector(s);
    const $$ = (s) => Array.from(document.querySelectorAll(s));

    const countrySelect = document.getElementById('country-select');
    const countrySearch = document.getElementById('country-search');
    const currencyHint = document.getElementById('currency-hint');
    const otherRow = document.getElementById('country-other-row');
    const otherCurrency = document.getElementById('other-currency');
    const otherCurrencyName = document.getElementById('other-currency-name');
    const rateCurrency = document.getElementById('rate-currency');
    const exchangeRateInput = document.getElementById('exchange-rate');
    const useLiveBtn = document.getElementById('use-live-rate');
    const rateMeta = document.getElementById('rate-meta');
    const rateUsedLine = document.getElementById('rate-used-line');

    const salaryEl = document.getElementById('salary');
    const overtimeEl = document.getElementById('overtime');
    const taxesEl = document.getElementById('taxes');
    const deductionsEl = document.getElementById('deductions');
    const expEls = $$('[data-exp]');
    const remitModeEls = $$('input[name="remit-mode"]');
    const remitAmountEl = document.getElementById('remit-amount');
    const remitFixedRow = document.getElementById('remit-fixed-row');
    const remitAllHint = document.getElementById('remit-all-hint');
    const remitFeeEl = document.getElementById('remit-fee');

    const hiddenCostsSection = document.getElementById('hidden-costs');
    const hiddenToggle = document.getElementById('hidden-toggle');
    const hiddenIcon = document.getElementById('hidden-icon');

    const modeSimpleBtn = document.getElementById('mode-simple');
    const modeAdvancedBtn = document.getElementById('mode-advanced');

    const takehomePreview = document.getElementById('takehome-preview');
    const expensesPreview = document.getElementById('expenses-preview');

    const overspendBanner = document.getElementById('overspend-banner');
    const sTakehome = document.getElementById('s-takehome');
    const sExpenses = document.getElementById('s-expenses');
    const sFee = document.getElementById('s-fee');
    const sMonthly = document.getElementById('s-monthly');
    const sMonthlyNpr = document.getElementById('s-monthly-npr');
    const sAnnual = document.getElementById('s-annual');
    const sAnnualNpr = document.getElementById('s-annual-npr');
    const sFirstYear = document.getElementById('s-firstyear');
    const sFirstYearNpr = document.getElementById('s-firstyear-npr');
    const sAfterFirst = document.getElementById('s-afterfirst');
    const savingsRateEl = document.getElementById('savings-rate');
    const savingsBandEl = document.getElementById('savings-band');
    const periodTable = document.getElementById('period-table');
    const periodNprNote = document.getElementById('period-npr-note');
    const sendMonth = document.getElementById('send-month');
    const sendYear = document.getElementById('send-year');
    const breakdownBars = document.getElementById('breakdown-bars');

    const shareBtn = document.getElementById('share-btn');
    const resetBtn = document.getElementById('reset-btn');
    const shareStatus = document.getElementById('share-status');

    let selectedCountryId = '';
    let selectedCurrency = '';
    let liveRateMap = new Map();
    let liveMeta = forexMeta;
    let advancedMode = false;

    // Build live rate map from server-provided currency options
    for (const c of currencyOptions) {
      if (c.sellPerUnit) liveRateMap.set(c.iso3, c.sellPerUnit);
    }

    function formatCurrencyValue(n, cur) {
      const c = cur || selectedCurrency || '';
      const v = formatNumber(n);
      return c ? `${v} ${c}` : v;
    }

    function getRemitMode() {
      const checked = document.querySelector('input[name="remit-mode"]:checked');
      return checked ? checked.value : 'fixed';
    }

    function updateSuffixes() {
      const cur = selectedCurrency || (selectedCountryId === 'other' ? (otherCurrency.value.trim().toUpperCase() || '') : '');
      const suffixes = ['suffix-salary', 'suffix-overtime', 'suffix-taxes', 'suffix-deductions', 'suffix-remit', 'suffix-fee'];
      for (const id of suffixes) {
        const el = document.getElementById(id);
        if (el) el.textContent = cur || '';
      }
      $$('[data-suffix]').forEach((el) => { el.textContent = cur || ''; });
      $$('[data-suffix-hidden]').forEach((el) => { el.textContent = cur || ''; });
      // Also reflect in rate currency select if Other
      if (selectedCountryId === 'other' && cur) {
        // Ensure custom currency appears as option
        let opt = Array.from(rateCurrency.options).find((o) => o.value === cur);
        if (!opt) {
          opt = document.createElement('option');
          opt.value = cur;
          opt.textContent = `${cur} · ${otherCurrencyName.value.trim() || cur}`;
          rateCurrency.appendChild(opt);
        }
      }
    }

    function setCountry(id, opts = {}) {
      selectedCountryId = id || '';
      const country = getCountryById(selectedCountryId);
      let cur = '';
      let hint = '';
      if (country && country.id !== 'other') {
        cur = country.currency || '';
        hint = country.currency ? `${country.flag} ${country.name} · ${country.currency} (${country.currencyName})` : '';
        otherRow.classList.add('hidden');
      } else if (country && country.id === 'other') {
        cur = otherCurrency.value.trim().toUpperCase();
        hint = cur ? `${cur} · ${otherCurrencyName.value.trim() || 'Custom currency'}` : 'Enter currency for Other.';
        otherRow.classList.remove('hidden');
      } else {
        otherRow.classList.add('hidden');
        hint = '';
      }
      selectedCurrency = cur;
      currencyHint.textContent = hint;
      // Sync rate currency selector
      if (cur) {
        const optExists = Array.from(rateCurrency.options).some((o) => o.value === cur);
        if (!optExists && cur) {
          const opt = document.createElement('option');
          opt.value = cur;
          opt.textContent = `${cur} · ${country ? country.currencyName : cur}`;
          rateCurrency.appendChild(opt);
        }
        if (!opts.keepRateCurrency) {
          // Prefer the country's currency for conversion
          rateCurrency.value = cur;
        }
      }
      updateSuffixes();
      // Try to prefill exchange rate from live map
      if (cur && liveRateMap.has(cur)) {
        const liveRate = liveRateMap.get(cur);
        // Only auto-fill if user hasn't typed a custom rate (or if forced)
        if (!exchangeRateInput.value || opts.forceRate) {
          exchangeRateInput.value = Number(liveRate).toFixed(2);
        }
        useLiveBtn.classList.remove('hidden');
        useLiveBtn.dataset.rate = String(liveRate);
        useLiveBtn.dataset.iso = cur;
        rateMeta.textContent = liveMeta && liveMeta.isLive
          ? `Live NRB rate available: 1 ${cur} = Rs. ${Number(liveRate).toFixed(2)} · ${liveMeta.publishedDate || ''}`.trim()
          : `Reference rate: 1 ${cur} = Rs. ${Number(liveRate).toFixed(2)} (mock)`;
      } else {
        useLiveBtn.classList.add('hidden');
        if (!cur) rateMeta.textContent = 'Select a country or enter a rate currency to see reference rates.';
        else rateMeta.textContent = `No reference rate for ${cur}. Enter today's rate from your provider.`;
      }
      updateModeVisibility();
      recalc();
    }

    function setAdvanced(on) {
      advancedMode = !!on;
      modeSimpleBtn.classList.toggle('mode-active', !advancedMode);
      modeAdvancedBtn.classList.toggle('mode-active', advancedMode);
      modeSimpleBtn.setAttribute('aria-pressed', String(!advancedMode));
      modeAdvancedBtn.setAttribute('aria-pressed', String(advancedMode));
      updateModeVisibility();
    }

    function updateModeVisibility() {
      $$('.adv-field').forEach((el) => {
        el.classList.toggle('hidden-adv', !advancedMode);
      });
      // Hidden costs section is advanced-only
      const hiddenSection = hiddenCostsSection.closest('section');
      if (hiddenSection) {
        hiddenSection.classList.toggle('hidden-adv', !advancedMode);
        // If switching to simple, collapse the inner panel
        if (!advancedMode) {
          hiddenCostsSection.classList.add('hidden');
          hiddenIcon.style.transform = '';
        }
      }
      // Job comparison is advanced
      const cmpSection = document.getElementById('compare-panel')?.closest('section');
      if (cmpSection) {
        cmpSection.classList.toggle('hidden-adv', !advancedMode);
      }
    }

    function collectInput() {
      const hidden = {};
      $$('[data-hidden]').forEach((el) => {
        hidden[el.dataset.hidden] = el.value;
      });
      const payload = {
        salary: salaryEl.value,
        overtime: overtimeEl.value,
        allowances: 0,
        taxes: taxesEl.value,
        deductions: deductionsEl.value,
        housing: document.getElementById('exp-housing')?.value || 0,
        food: document.getElementById('exp-food')?.value || 0,
        transportation: document.getElementById('exp-transportation')?.value || 0,
        phone: document.getElementById('exp-phone')?.value || 0,
        personal: document.getElementById('exp-personal')?.value || 0,
        other: document.getElementById('exp-other')?.value || 0,
        hiddenCosts: hidden,
        remittanceFee: remitFeeEl.value,
        exchangeRate: exchangeRateInput.value,
        remitMode: getRemitMode(),
        remitAmount: remitAmountEl.value,
      };
      return payload;
    }

    function collectOffer(prefix) {
      // prefix like 'cmp-a' or 'cmp-b' for comparison
      const salary = document.getElementById(`${prefix}-salary`)?.value || 0;
      const allowances = document.getElementById(`${prefix}-allowances`)?.value || 0;
      const taxes = document.getElementById(`${prefix}-taxes`)?.value || 0;
      const expenses = document.getElementById(`${prefix}-expenses`)?.value || 0;
      const fee = document.getElementById(`${prefix}-fee`)?.value || 0;
      const rate = document.getElementById(`${prefix}-rate`)?.value || 0;
      // Map single expenses bucket into totalExpenses approximation
      // For comparison we treat expenses as totalExpenses directly
      return {
        salary, overtime: allowances, taxes, deductions: 0,
        housing: expenses, food: 0, transportation: 0, phone: 0, personal: 0, other: 0,
        hiddenCosts: {},
        remittanceFee: fee,
        exchangeRate: rate,
      };
    }

    function recalc() {
      const input = collectInput();
      // Handle "send all remaining" remittance mode
      // In that mode, remitAmount is ignored; savings is takeHome - expenses - fee
      // and amount sent is implicitly monthlySavings + fee? Actually spec says
      // remittance amount is separate from savings; for "all remaining" we treat
      // remit amount as monthlySavings before fee? Keep simple: savings calc already
      // subtracts fee; remit amount display will mirror monthlySavings when in 'all' mode.
      const result = calculateSavings(input);
      const cur = selectedCurrency || '';
      const hasRate = result.exchangeRate > 0;

      // Previews
      takehomePreview.textContent = formatCurrencyValue(result.takeHome, cur);
      expensesPreview.textContent = formatCurrencyValue(result.totalExpenses, cur);

      // Overspend banner
      if (result.isOverspending) {
        overspendBanner.classList.remove('hidden');
        const nprPart = hasRate ? ` (about ${formatNPR(result.nprOverspend)})` : '';
        overspendBanner.textContent = `You are spending more than your estimated take home salary by ${formatCurrencyValue(result.overspendAmount, cur)} per month${nprPart}.`;
      } else {
        overspendBanner.classList.add('hidden');
        overspendBanner.textContent = '';
      }

      sTakehome.textContent = formatCurrencyValue(result.takeHome, cur);
      sExpenses.textContent = formatCurrencyValue(result.totalExpenses, cur);
      sFee.textContent = formatCurrencyValue(result.remittanceFee, cur);

      if (result.isOverspending) {
        sMonthly.textContent = `-${formatCurrencyValue(result.overspendAmount, cur)}`;
        sMonthly.style.color = '#dc2626';
      } else {
        sMonthly.textContent = formatCurrencyValue(result.monthlySavings, cur);
        sMonthly.style.color = 'var(--nk-text)';
      }
      sMonthlyNpr.textContent = hasRate ? (result.isOverspending ? `-${formatNPR(result.nprOverspend)}` : formatNPR(result.nprMonthlySavings)) : '';
      sAnnual.textContent = result.isOverspending ? `-${formatCurrencyValue(Math.abs(result.annualSavings), cur)}` : formatCurrencyValue(result.annualSavings, cur);
      sAnnualNpr.textContent = hasRate ? (result.isOverspending ? `-${formatNPR(Math.abs(result.nprAnnualSavings))}` : formatNPR(result.nprAnnualSavings)) : '';

      sFirstYear.textContent = formatCurrencyValue(result.firstYearNetSavings, cur);
      sFirstYearNpr.textContent = hasRate ? formatNPR(result.nprFirstYearNet) : '';
      sAfterFirst.textContent = `After the first year: about ${formatCurrencyValue(result.afterFirstYearAnnual, cur)}/year${hasRate ? ` (${formatNPR(result.nprAnnualSavings)}/year)` : ''} estimated.`;

      // Savings rate
      const rateVal = result.savingsRate;
      const band = savingsBand(rateVal);
      savingsRateEl.textContent = `${rateVal.toFixed(1)}%`;
      savingsBandEl.textContent = band.label;
      savingsBandEl.style.color = band.color;
      savingsBandEl.style.borderColor = band.color;
      savingsBandEl.style.background = `${band.color}12`;

      // Breakdown bars
      const grossForPct = result.grossIncome > 0 ? result.grossIncome : 1;
      // Use takeHome as denominator for living/fees? Spec says Salary 100%, living 40%, etc. Use grossIncome as 100%.
      const items = [
        { label: 'Salary', value: result.grossIncome, pct: 100, color: 'var(--nk-accent)' },
        { label: 'Living expenses', value: result.totalExpenses, pct: (result.totalExpenses / grossForPct) * 100, color: 'var(--nk-text-secondary)' },
        { label: 'Remittance fee', value: result.remittanceFee, pct: (result.remittanceFee / grossForPct) * 100, color: '#d97706' },
        { label: 'Remaining savings', value: Math.max(0, result.monthlySavings), pct: Math.max(0, (result.monthlySavings / grossForPct) * 100), color: '#16a34a' },
      ];
      breakdownBars.innerHTML = items.map((it) => `
        <div>
          <div class="flex justify-between text-[11.5px] mb-1"><span style="color: var(--nk-text-secondary);">${it.label}</span><span class="tabular-nums font-medium" style="color: var(--nk-text);">${formatCurrencyValue(it.value, cur)} · ${it.pct.toFixed(0)}%</span></div>
          <div class="break-bar" role="progressbar" aria-valuenow="${it.pct.toFixed(0)}" aria-valuemin="0" aria-valuemax="100" aria-label="${it.label} ${it.pct.toFixed(0)} percent"><div class="break-fill" style="width: ${Math.max(2, Math.min(100, it.pct)).toFixed(0)}%; background: ${it.color};"></div></div>
        </div>
      `).join('');

      // Period table
      const yearlyIncome = result.grossIncome * 12;
      const yearlyExpenses = result.totalExpenses * 12;
      const yearlyFees = result.remittanceFee * 12;
      const yearlySavings = result.monthlySavings * 12;
      periodTable.innerHTML = `
        <tr style="border-top: 1px solid var(--nk-border);">
          <td class="py-1.5 pr-2" style="color: var(--nk-text-secondary);">Monthly</td>
          <td class="text-right py-1.5 px-2 font-medium" style="color: var(--nk-text);">${formatCurrencyValue(result.grossIncome, cur)}</td>
          <td class="text-right py-1.5 px-2" style="color: var(--nk-text);">${formatCurrencyValue(result.totalExpenses, cur)}</td>
          <td class="text-right py-1.5 px-2" style="color: var(--nk-text);">${formatCurrencyValue(result.remittanceFee, cur)}</td>
          <td class="text-right py-1.5 pl-2 font-semibold" style="color: ${result.isOverspending ? '#dc2626' : 'var(--nk-text)'};">${result.isOverspending ? '-' : ''}${formatCurrencyValue(Math.abs(result.monthlySavings), cur)}</td>
        </tr>
        <tr style="border-top: 1px solid var(--nk-border);">
          <td class="py-1.5 pr-2" style="color: var(--nk-text-secondary);">Yearly</td>
          <td class="text-right py-1.5 px-2 font-medium" style="color: var(--nk-text);">${formatCurrencyValue(yearlyIncome, cur)}</td>
          <td class="text-right py-1.5 px-2" style="color: var(--nk-text);">${formatCurrencyValue(yearlyExpenses, cur)}</td>
          <td class="text-right py-1.5 px-2" style="color: var(--nk-text);">${formatCurrencyValue(yearlyFees, cur)}</td>
          <td class="text-right py-1.5 pl-2 font-semibold" style="color: ${result.isOverspending ? '#dc2626' : 'var(--nk-text)'};">${result.isOverspending ? '-' : ''}${formatCurrencyValue(Math.abs(yearlySavings), cur)}</td>
        </tr>
      `;
      periodNprNote.textContent = hasRate ? `In NPR: Monthly savings ${formatNPR(result.nprMonthlySavings)} · Yearly ${formatNPR(result.nprAnnualSavings)} at ${formatNumber(result.exchangeRate)} NPR per ${cur || 'unit'}.` : 'Enter an exchange rate to see NPR values.';

      // Money you could send home
      // If remit mode is fixed, amount sent is remitAmount; if all, it's monthlySavings
      const remitMode = getRemitMode();
      let nprRemitMonthly = 0;
      let remitForeignMonthly = 0;
      if (remitMode === 'fixed') {
        const amt = Number(String(remitAmountEl.value).replace(/,/g, '')) || 0;
        remitForeignMonthly = amt;
        nprRemitMonthly = hasRate ? Math.round(amt * result.exchangeRate) : 0;
      } else {
        remitForeignMonthly = Math.max(0, result.monthlySavings);
        nprRemitMonthly = hasRate ? result.nprMonthlySavings > 0 ? result.nprMonthlySavings : 0 : 0;
      }
      const nprRemitYearly = nprRemitMonthly * 12;
      const remitForeignYearly = remitForeignMonthly * 12;
      sendMonth.textContent = hasRate ? `${formatNPR(nprRemitMonthly)} / month` : (remitForeignMonthly ? `${formatCurrencyValue(remitForeignMonthly, cur)} / month` : '—');
      sendYear.textContent = hasRate ? `${formatNPR(nprRemitYearly)} / year` : (remitForeignYearly ? `${formatCurrencyValue(remitForeignYearly, cur)} / year` : '—');

      // Rate used line
      const rateCur = rateCurrency.value || cur || 'unit';
      if (hasRate) {
        const srcLabel = liveMeta && liveMeta.isLive ? 'Live NRB' : (liveRateMap.has(rateCur) ? 'Reference (NRB)' : 'Manual');
        const ts = liveMeta && liveMeta.publishedDate ? ` · ${liveMeta.publishedDate}` : '';
        rateUsedLine.textContent = `Exchange rate used: 1 ${rateCur} = Rs. ${Number(result.exchangeRate).toFixed(2)} · ${srcLabel}${ts}`;
      } else {
        rateUsedLine.textContent = '';
      }

      // Update comparison if open
      updateComparison();

      // Store for share
      window.__lastResult = result;
      window.__lastCountryName = (getCountryById(selectedCountryId) || {}).name || '';
      window.__lastCurrency = cur;
    }

    function updateComparison() {
      const panel = document.getElementById('compare-result');
      const aCountry = document.getElementById('cmp-a-country')?.value || '';
      const bCountry = document.getElementById('cmp-b-country')?.value || '';
      // Only compute if at least one comparison field has values
      const aHas = ['cmp-a-salary','cmp-a-expenses','cmp-a-rate'].some((id) => document.getElementById(id)?.value);
      if (!aHas && !document.getElementById('cmp-b-salary')?.value) {
        panel.classList.add('hidden');
        panel.innerHTML = '';
        return;
      }
      const aInput = collectOffer('cmp-a');
      const bInput = collectOffer('cmp-b');
      const cmp = compareOffers(aInput, bInput);
      const aCur = (getCountryById(aCountry)?.currency) || '';
      const bCur = (getCountryById(bCountry)?.currency) || '';
      panel.classList.remove('hidden');
      panel.innerHTML = `
        <div class="grid grid-cols-2 gap-3 text-[12.5px]">
          <div>
            <p class="font-semibold mb-1" style="color: var(--nk-text);">Job A</p>
            <p>Take home: <strong class="tabular-nums">${formatCurrencyValue(cmp.a.takeHome, aCur)}</strong></p>
            <p>Expenses: <span class="tabular-nums">${formatCurrencyValue(cmp.a.totalExpenses, aCur)}</span></p>
            <p>Monthly savings: <strong class="tabular-nums">${formatCurrencyValue(cmp.a.monthlySavings, aCur)}</strong></p>
            <p>Annual: <span class="tabular-nums">${formatCurrencyValue(cmp.a.annualSavings, aCur)}</span></p>
            <p>NPR/month: <span class="tabular-nums">${cmp.a.exchangeRate ? formatNPR(cmp.a.nprMonthlySavings) : '—'}</span></p>
          </div>
          <div>
            <p class="font-semibold mb-1" style="color: var(--nk-text);">Job B</p>
            <p>Take home: <strong class="tabular-nums">${formatCurrencyValue(cmp.b.takeHome, bCur)}</strong></p>
            <p>Expenses: <span class="tabular-nums">${formatCurrencyValue(cmp.b.totalExpenses, bCur)}</span></p>
            <p>Monthly savings: <strong class="tabular-nums">${formatCurrencyValue(cmp.b.monthlySavings, bCur)}</strong></p>
            <p>Annual: <span class="tabular-nums">${formatCurrencyValue(cmp.b.annualSavings, bCur)}</span></p>
            <p>NPR/month: <span class="tabular-nums">${cmp.b.exchangeRate ? formatNPR(cmp.b.nprMonthlySavings) : '—'}</span></p>
          </div>
        </div>
        ${cmp.winner ? `<p class="mt-2 font-semibold" style="color: var(--nk-accent);">Job ${cmp.winner} saves approximately ${formatNPR(cmp.diffMonthlyAbs)} more per month.</p>` : '<p class="mt-2" style="color: var(--nk-text-tertiary);">Enter rates to compare in NPR.</p>'}
      `;
    }

    // Country filtering
    const countryFilter = (q) => {
      const query = String(q || '').trim().toLowerCase();
      const filtered = COUNTRIES.filter((c) => {
        if (!query) return true;
        return `${c.name} ${c.currency} ${c.iso3}`.toLowerCase().includes(query);
      });
      countrySelect.innerHTML = '<option value="">Select a country</option>' + filtered.map((c) => `<option value="${c.id}">${c.flag} ${c.name} ${c.currency ? `· ${c.currency}` : ''}</option>`).join('');
      if (filtered.length === 1) {
        countrySelect.value = filtered[0].id;
        setCountry(filtered[0].id);
      }
    };

    countrySearch.addEventListener('input', () => countryFilter(countrySearch.value));
    document.getElementById('popular-countries')?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-country]');
      if (!btn) return;
      $$('.pop-country').forEach((b) => b.classList.remove('pop-active'));
      btn.classList.add('pop-active');
      countrySelect.value = btn.dataset.country;
      countrySearch.value = '';
      setCountry(btn.dataset.country);
    });
    countrySelect.addEventListener('change', () => setCountry(countrySelect.value));
    otherCurrency.addEventListener('input', () => {
      otherCurrency.value = otherCurrency.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 5);
      setCountry('other', { keepRateCurrency: true });
    });
    otherCurrencyName.addEventListener('input', () => {
      // No calc needed, just suffix update
      updateSuffixes();
    });

    // Currency for rate
    rateCurrency.addEventListener('change', () => {
      const iso = rateCurrency.value;
      if (liveRateMap.has(iso) && !exchangeRateInput.value) {
        exchangeRateInput.value = Number(liveRateMap.get(iso)).toFixed(2);
      }
      recalc();
    });
    useLiveBtn.addEventListener('click', () => {
      const rate = useLiveBtn.dataset.rate;
      if (rate) {
        exchangeRateInput.value = Number(rate).toFixed(2);
        const iso = useLiveBtn.dataset.iso;
        if (iso) rateCurrency.value = iso;
        recalc();
      }
    });

    // Inputs live recalc
    const liveInputs = [
      salaryEl, overtimeEl, taxesEl, deductionsEl,
      ...expEls,
      remitAmountEl, remitFeeEl, exchangeRateInput,
      ...$$('[data-hidden]'),
    ];
    liveInputs.forEach((el) => {
      if (!el) return;
      el.addEventListener('input', recalc);
      el.addEventListener('change', recalc);
    });
    remitModeEls.forEach((el) => el.addEventListener('change', () => {
      const mode = getRemitMode();
      if (mode === 'fixed') {
        remitFixedRow.classList.remove('hidden');
        remitAllHint.classList.add('hidden');
      } else {
        remitFixedRow.classList.add('hidden');
        remitAllHint.classList.remove('hidden');
      }
      recalc();
    }));

    // Hidden costs toggle
    hiddenToggle.addEventListener('click', () => {
      const isHidden = hiddenCostsSection.classList.contains('hidden');
      hiddenCostsSection.classList.toggle('hidden', !isHidden);
      hiddenIcon.style.transform = isHidden ? 'rotate(45deg)' : '';
    });

    // Compare toggle
    document.getElementById('compare-toggle')?.addEventListener('click', () => {
      const panel = document.getElementById('compare-panel');
      const icon = document.getElementById('compare-icon');
      const isHidden = panel.classList.contains('hidden');
      panel.classList.toggle('hidden', !isHidden);
      icon.style.transform = isHidden ? 'rotate(45deg)' : '';
      if (isHidden) updateComparison();
    });
    // Comparison live inputs
    $$('#compare-panel input, #compare-panel select').forEach((el) => {
      el.addEventListener('input', updateComparison);
      el.addEventListener('change', updateComparison);
    });

    // Mode toggle
    modeSimpleBtn.addEventListener('click', () => setAdvanced(false));
    modeAdvancedBtn.addEventListener('click', () => setAdvanced(true));

    // Reset
    resetBtn.addEventListener('click', () => {
      salaryEl.value = '';
      overtimeEl.value = '';
      taxesEl.value = '';
      deductionsEl.value = '';
      expEls.forEach((el) => el.value = '');
      $$('[data-hidden]').forEach((el) => el.value = '');
      remitAmountEl.value = '';
      remitFeeEl.value = '';
      exchangeRateInput.value = '';
      // Keep country but reset gem? No, keep country
      shareStatus.classList.add('hidden');
      shareStatus.textContent = '';
      recalc();
    });

    // Share
    shareBtn.addEventListener('click', async () => {
      const input = collectInput();
      const result = window.__lastResult || calculateSavings(input);
      const text = buildShareText(input, result, window.__lastCountryName || '', window.__lastCurrency || '');
      try {
        if (navigator.share) {
          await navigator.share({ title: 'Foreign Job Savings Estimate', text });
          shareStatus.textContent = 'Shared.';
        } else if (navigator.clipboard) {
          await navigator.clipboard.writeText(text);
          shareStatus.textContent = 'Copied to clipboard.';
        } else {
          // Fallback
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          shareStatus.textContent = 'Copied to clipboard.';
        }
      } catch {
        shareStatus.textContent = 'Could not share. Copy manually.';
      }
      shareStatus.classList.remove('hidden');
      setTimeout(() => shareStatus.classList.add('hidden'), 3000);
    });

    // Init
    setCountry('');
    setAdvanced(false);
    recalc();
  </script>
</BaseLayout>
