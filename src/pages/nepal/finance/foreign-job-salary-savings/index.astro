---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../../components/ui/RelatedTools.astro';
import { Search, ArrowRight, Copy, RotateCcw, Share2, Info, TrendingUp, Wallet, Building2, Utensils, Bus, Smartphone, User, Plus, Receipt, Banknote, Plane, Clock, MapPin, Calculator, Scale } from '@lucide/astro';
import { getAllCurrenciesAsync, getForexMetaAsync } from '../../../../lib/nepal/forex.js';
import { COUNTRIES, POPULAR_COUNTRIES, OTHER_CURRENCIES, EXPENSE_DEFS, HIDDEN_COST_KEYS, SAVINGS_BANDS, getCountryById, getCurrencyForCountry, savingsBand } from '../../../../data/foreign-job-savings.js';

const title = 'Foreign Job Salary & Real Savings Calculator Nepal | SolutionsNepal';
const description = 'See how much you could actually save, send to Nepal, and keep after monthly expenses. Foreign job salary and real savings calculator for Nepali workers.';

// Build currency option list server-side, then enrich with live NRB rates where available.
const allCurrenciesForPage = await (async () => {
  let live = [];
  let meta = null;
  try {
    live = await getAllCurrenciesAsync();
    meta = await getForexMetaAsync();
  } catch {}
  const liveMap = new Map(live.map((c) => [c.iso3, c]));
  const merged = [
    ...COUNTRIES.filter((c) => c.iso3).map((c) => {
      const lv = liveMap.get(c.iso3);
      return {
        iso3: c.iso3, name: c.currencyName, flag: c.flag,
        buy: lv ? lv.buy : null, sell: lv ? lv.sell : null,
        sellPerUnit: lv ? lv.sellPerUnit : null,
      };
    }),
    ...OTHER_CURRENCIES.map((c) => {
      const lv = liveMap.get(c.iso3);
      return {
        iso3: c.iso3, name: c.name, flag: c.flag,
        buy: lv ? lv.buy : null, sell: lv ? lv.sell : null,
        sellPerUnit: lv ? lv.sellPerUnit : null,
      };
    }),
  ].filter((v, i, a) => a.findIndex((x) => x.iso3 === v.iso3) === i);
  return { merged, meta };
})();
const currencyOptions = allCurrenciesForPage.merged;
const forexMeta = allCurrenciesForPage.meta;

const faqItems = [
  { q: 'How much can I save working abroad?', a: 'Enter your gross salary, deductions, living expenses, remittance fee and exchange rate. The calculator shows take home, total expenses, monthly savings, annual savings and first year net savings after one time migration costs.' },
  { q: 'How do I calculate my salary after expenses?', a: 'Add salary, overtime and allowances to get gross income. Subtract taxes and deductions for take home. Subtract housing, food, transport, phone, personal and other expenses plus remittance fee. The remainder is your estimated monthly savings.' },
  { q: 'Should I compare foreign jobs by salary or savings?', a: 'Compare by estimated net savings, not just headline salary. A higher salary can leave less savings if living costs, deductions, fees or migration costs are higher.' },
  { q: 'Does the calculator include remittance fees?', a: 'Yes. Add your transfer fee and the calculator subtracts it from savings. It also shows exchange rate used, source and time so you know what rate produced the NPR figure.' },
  { q: 'Can I calculate savings in Nepali rupees?', a: 'Yes. Enter an exchange rate (or use a live rate when available) and the calculator shows NPR monthly, yearly and first year net savings.' },
  { q: 'Can I compare two foreign job offers?', a: 'Yes. Use Compare Two Job Offers to enter the same fields for Job A and Job B side by side and see which offer leaves greater estimated savings.' },
  { q: 'Are exchange rates live?', a: 'When live NRB data is available the page can prefill the rate and shows source and time. If live data is unavailable, you enter the rate manually. Stale rates are never presented as live.' },
  { q: 'Does this calculator include recruitment costs?', a: 'Yes, as an optional one time cost. It reduces first year net savings so you can see whether a higher salary offer still wins after migration costs.' },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Foreign Job Salary & Real Savings Calculator Nepal',
      description: 'Estimate take home salary, living expenses, remittance costs and real savings for Nepali workers abroad, with NPR conversion.',
      url: 'https://solutionsnepal.com/nepal/finance/foreign-job-salary-savings',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ]}
>
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6 py-4 sm:py-5">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Finance', href: '/nepal/finance' },
      { label: 'Foreign Job Salary & Real Savings' },
    ]} />

    <div class="mb-4">
      <h1 class="text-[22px] sm:text-[28px] font-bold tracking-[-0.025em] leading-[1.15] mb-1" style="color: var(--nk-text);">
        Foreign Job Salary &amp; Real Savings Calculator
      </h1>
      <p class="text-[13px] leading-relaxed" style="color: var(--nk-text-secondary);">
        See how much you could actually save, send to Nepal, and keep after your monthly expenses.
      </p>
      <p class="text-[12px] leading-relaxed mt-1 flex items-center gap-1.5" style="color: var(--nk-text-tertiary);">
        <Info size={13} /> Calculate your estimated take home salary, monthly expenses, remittance amount, and yearly savings.
      </p>
    </div>

    <!-- Mode toggle -->
    <div class="flex items-center gap-2 mb-3">
      <button type="button" id="mode-simple" class="mode-btn mode-active" aria-pressed="true">Simple</button>
      <button type="button" id="mode-advanced" class="mode-btn" aria-pressed="false">Advanced</button>
      <span class="text-[11.5px] ml-1" style="color: var(--nk-text-tertiary);">Simple shows only the essentials.</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-4 items-start">

      <!-- LEFT: INPUTS -->
      <div class="space-y-4 min-w-0">

        <!-- Step 1: Country -->
        <section class="nk-card p-4">
          <h2 class="text-[13px] font-semibold uppercase tracking-wider mb-2 flex items-center gap-1.5" style="color: var(--nk-text);">
            <MapPin size={14} /> Choose country
          </h2>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--nk-text-tertiary);"><Search size={14} /></span>
            <input id="country-search" type="text" placeholder="Search country" autocomplete="off" class="nk-input text-[14px]" style="padding-left: 2.25rem;" />
          </div>
          <div class="flex flex-wrap gap-1.5 mt-2" id="popular-countries">
            {POPULAR_COUNTRIES.map((c) => (
              <button type="button" class="pop-country" data-country={c.id}>{c.flag} {c.name}</button>
            ))}
          </div>
          <div class="relative mt-2">
            <select id="country-select" class="nk-input text-[14px]">
              <option value="">Select a country</option>
              {COUNTRIES.map((c) => (
                <option value={c.id}>{c.flag} {c.name} {c.currency ? `· ${c.currency}` : ''}</option>
              ))}
            </select>
          </div>
          <div id="country-other-row" class="hidden mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label for="other-currency" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Currency code</label>
              <input id="other-currency" type="text" placeholder="e.g. NOK" maxlength="5" class="nk-input text-[14px] uppercase" />
            </div>
            <div>
              <label for="other-currency-name" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Currency name</label>
              <input id="other-currency-name" type="text" placeholder="e.g. Norwegian Krone" class="nk-input text-[14px]" />
            </div>
          </div>
          <p id="currency-hint" class="text-[11.5px] mt-1.5" style="color: var(--nk-text-tertiary);"></p>
        </section>

        <!-- Step 2: Salary -->
        <section class="nk-card p-4">
          <h2 class="text-[13px] font-semibold uppercase tracking-wider mb-2 flex items-center gap-1.5" style="color: var(--nk-text);">
            <Banknote size={14} /> Salary
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="salary" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Monthly gross salary</label>
              <div class="relative">
                <input id="salary" type="text" inputmode="decimal" placeholder="3,000" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" id="suffix-salary"></span>
              </div>
            </div>
            <div>
              <label for="overtime" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Overtime / allowances <span class="text-[11px]" style="color: var(--nk-text-tertiary);">optional</span></label>
              <div class="relative">
                <input id="overtime" type="text" inputmode="decimal" placeholder="500" class="nk-input text-[14px] tabular-nums pr-16 adv-field" />
                <span class="field-suffix" id="suffix-overtime"></span>
              </div>
            </div>
            <div class="adv-field">
              <label for="taxes" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Tax / mandatory deductions</label>
              <div class="relative">
                <input id="taxes" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" id="suffix-taxes"></span>
              </div>
            </div>
            <div class="adv-field">
              <label for="deductions" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Other deductions</label>
              <div class="relative">
                <input id="deductions" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" id="suffix-deductions"></span>
              </div>
            </div>
          </div>
          <div class="mt-3 p-2.5 rounded-lg flex items-center justify-between" style="background: var(--nk-hover); border: 1px solid var(--nk-border);">
            <span class="text-[12px] font-medium" style="color: var(--nk-text-secondary);">Estimated take home salary</span>
            <span class="text-[14px] font-bold tabular-nums" style="color: var(--nk-text);" id="takehome-preview">—</span>
          </div>
          <p class="text-[11px] mt-1" style="color: var(--nk-text-tertiary);">Estimates only. Employer deductions vary by country and contract.</p>
        </section>

        <!-- Step 3: Monthly expenses -->
        <section class="nk-card p-4">
          <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="text-[13px] font-semibold uppercase tracking-wider flex items-center gap-1.5" style="color: var(--nk-text);">
              <Receipt size={14} /> Monthly expenses
            </h2>
            <span class="text-[11px]" style="color: var(--nk-text-tertiary);">Leave at zero if not applicable</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="expense-grid">
            <div>
              <label for="exp-housing" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Housing</label>
              <div class="relative">
                <input id="exp-housing" data-exp="housing" type="text" inputmode="decimal" placeholder="500" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="housing"></span>
              </div>
            </div>
            <div>
              <label for="exp-food" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Food</label>
              <div class="relative">
                <input id="exp-food" data-exp="food" type="text" inputmode="decimal" placeholder="400" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="food"></span>
              </div>
            </div>
            <div>
              <label for="exp-transportation" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Transportation</label>
              <div class="relative">
                <input id="exp-transportation" data-exp="transportation" type="text" inputmode="decimal" placeholder="150" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="transportation"></span>
              </div>
            </div>
            <div>
              <label for="exp-phone" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Phone / Internet</label>
              <div class="relative">
                <input id="exp-phone" data-exp="phone" type="text" inputmode="decimal" placeholder="50" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="phone"></span>
              </div>
            </div>
            <div>
              <label for="exp-personal" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Personal expenses</label>
              <div class="relative">
                <input id="exp-personal" data-exp="personal" type="text" inputmode="decimal" placeholder="200" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="personal"></span>
              </div>
            </div>
            <div>
              <label for="exp-other" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Other</label>
              <div class="relative">
                <input id="exp-other" data-exp="other" type="text" inputmode="decimal" placeholder="100" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix="other"></span>
              </div>
            </div>
          </div>
          <div class="mt-3 p-2.5 rounded-lg flex items-center justify-between" style="background: var(--nk-hover); border: 1px solid var(--nk-border);">
            <span class="text-[12px] font-medium" style="color: var(--nk-text-secondary);">Total monthly expenses</span>
            <span class="text-[14px] font-bold tabular-nums" style="color: var(--nk-text);" id="expenses-preview">—</span>
          </div>
        </section>

        <!-- Step 4: Remittance -->
        <section class="nk-card p-4">
          <h2 class="text-[13px] font-semibold uppercase tracking-wider mb-2 flex items-center gap-1.5" style="color: var(--nk-text);">
            <Plane size={14} /> Remittance
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Amount sent to Nepal</label>
              <div class="flex items-center gap-2 mb-1.5">
                <label class="flex items-center gap-1.5 text-[12px]" style="color: var(--nk-text);">
                  <input type="radio" name="remit-mode" value="fixed" checked /> Fixed amount
                </label>
                <label class="flex items-center gap-1.5 text-[12px]" style="color: var(--nk-text);">
                  <input type="radio" name="remit-mode" value="all" /> Send all remaining savings
                </label>
              </div>
              <div class="relative" id="remit-fixed-row">
                <input id="remit-amount" type="text" inputmode="decimal" placeholder="1,000" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" id="suffix-remit"></span>
              </div>
              <p class="text-[11px] mt-1 hidden" id="remit-all-hint" style="color: var(--nk-text-tertiary);">Remittance = monthly savings before fee. Shown after calculation.</p>
            </div>
            <div>
              <label for="remit-fee" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Transfer fee</label>
              <div class="relative">
                <input id="remit-fee" type="text" inputmode="decimal" placeholder="20" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" id="suffix-fee"></span>
              </div>
            </div>
          </div>
          <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="exchange-rate" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Exchange rate <span class="text-[11px]" style="color: var(--nk-text-tertiary);">foreign → NPR</span></label>
              <div class="relative">
                <input id="exchange-rate" type="text" inputmode="decimal" placeholder="Enter today's rate" class="nk-input text-[14px] tabular-nums" />
              </div>
              <p class="text-[11px] mt-1" style="color: var(--nk-text-tertiary);" id="rate-meta">Enter today's rate from your remittance provider.</p>
            </div>
            <div>
              <label for="rate-currency" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Rate currency</label>
              <select id="rate-currency" class="nk-input text-[14px]">
                <option value="">Select currency</option>
                {currencyOptions.map((c) => (
                  <option value={c.iso3}>{c.flag} {c.iso3} · {c.name}</option>
                ))}
              </select>
              <button type="button" id="use-live-rate" class="hidden mt-1.5 text-[12px] font-medium underline" style="color: var(--nk-accent);">Use live NRB rate</button>
            </div>
          </div>
          <p class="text-[11px] mt-2" id="rate-used-line" style="color: var(--nk-text-tertiary);"></p>
        </section>

        <!-- Hidden costs (advanced) -->
        <section class="nk-card p-4 adv-field">
          <button type="button" id="hidden-toggle" class="w-full flex items-center justify-between text-left">
            <span class="text-[13px] font-semibold flex items-center gap-1.5" style="color: var(--nk-text);">
              <Plus size={14} class="transition-transform" id="hidden-icon" /> Add other costs
            </span>
            <span class="text-[11px]" style="color: var(--nk-text-tertiary);">Optional</span>
          </button>
          <div id="hidden-costs" class="hidden mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="hc-recruitment" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Recruitment / agency cost <span class="text-[11px]" style="color: var(--nk-text-tertiary);">one time</span></label>
              <div class="relative">
                <input id="hc-recruitment" data-hidden="recruitment" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="recruitment"></span>
              </div>
            </div>
            <div>
              <label for="hc-accommodationDeposit" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Accommodation deposit <span class="text-[11px]" style="color: var(--nk-text-tertiary);">one time</span></label>
              <div class="relative">
                <input id="hc-accommodationDeposit" data-hidden="accommodationDeposit" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="accommodationDeposit"></span>
              </div>
            </div>
            <div>
              <label for="hc-foodDeposit" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Food deposit <span class="text-[11px]" style="color: var(--nk-text-tertiary);">one time</span></label>
              <div class="relative">
                <input id="hc-foodDeposit" data-hidden="foodDeposit" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="foodDeposit"></span>
              </div>
            </div>
            <div>
              <label for="hc-insurance" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Insurance</label>
              <div class="relative">
                <input id="hc-insurance" data-hidden="insurance" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="insurance"></span>
              </div>
            </div>
            <div>
              <label for="hc-medical" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Medical expenses</label>
              <div class="relative">
                <input id="hc-medical" data-hidden="medical" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="medical"></span>
              </div>
            </div>
            <div>
              <label for="hc-loanRepayment" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Loan repayment</label>
              <div class="relative">
                <input id="hc-loanRepayment" data-hidden="loanRepayment" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="loanRepayment"></span>
              </div>
            </div>
            <div>
              <label for="hc-localTransport" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Local transportation</label>
              <div class="relative">
                <input id="hc-localTransport" data-hidden="localTransport" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="localTransport"></span>
              </div>
            </div>
            <div>
              <label for="hc-phoneInternet" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Phone / internet</label>
              <div class="relative">
                <input id="hc-phoneInternet" data-hidden="phoneInternet" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="phoneInternet"></span>
              </div>
            </div>
            <div>
              <label for="hc-otherRecurring" class="block text-[12px] font-medium mb-1" style="color: var(--nk-text-secondary);">Other recurring costs</label>
              <div class="relative">
                <input id="hc-otherRecurring" data-hidden="otherRecurring" type="text" inputmode="decimal" placeholder="0" class="nk-input text-[14px] tabular-nums pr-16" />
                <span class="field-suffix" data-suffix-hidden="otherRecurring"></span>
              </div>
            </div>
          </div>
        </section>

        <div class="flex flex-wrap gap-2">
          <button type="button" id="reset-btn" class="nk-btn nk-btn-secondary nk-btn-sm"><RotateCcw size={14} /> Reset calculator</button>
          <button type="button" id="share-btn" class="nk-btn nk-btn-secondary nk-btn-sm"><Share2 size={14} /> Share results</button>
        </div>
        <p id="share-status" class="hidden text-[11.5px]" style="color: var(--nk-text-tertiary);" role="status"></p>

        <!-- Job comparison -->
        <section class="nk-card p-4">
          <button type="button" id="compare-toggle" class="w-full flex items-center justify-between text-left">
            <span class="text-[13px] font-semibold flex items-center gap-1.5" style="color: var(--nk-text);">
              <Scale size={14} class="transition-transform" id="compare-icon" /> Compare two job offers
            </span>
            <span class="text-[11px]" style="color: var(--nk-text-tertiary);">Advanced</span>
          </button>
          <div id="compare-panel" class="hidden mt-3 space-y-3">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div class="space-y-2 p-3 rounded-lg" style="border: 1px solid var(--nk-border); background: var(--nk-surface);">
                <p class="text-[12px] font-semibold" style="color: var(--nk-text);">Job A</p>
                <div>
                  <label for="cmp-a-country" class="block text-[11px] font-medium mb-1" style="color: var(--nk-text-secondary);">Country</label>
                  <select id="cmp-a-country" class="nk-input text-[13px]">
                    <option value="">Select</option>
                    {COUNTRIES.filter((c) => c.id !== 'other').map((c) => <option value={c.id}>{c.name}</option>)}
