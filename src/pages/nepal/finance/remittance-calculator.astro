---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../components/ui/RelatedTools.astro';

const relatedTools = [
  {title:'VAT Calculator',description:'Add 13% VAT to any price instantly',href:'/nepal/finance/vat-calculator'},
  {title:'Salary Calculator',description:'Calculate take-home salary',href:'/nepal/finance/salary-checker'},
  {title:'EMI Calculator',description:'Calculate monthly loan EMI',href:'/nepal/finance/emi-calculator'},
];

const faqItems = [
  {q:'What is the current USD to NPR rate?',a:'The exchange rate changes daily based on Nepal Rastra Bank (NRB) official reference rates. This calculator fetches the latest available NRB buy rate automatically. The rate shown is the NRB reference rate, not the rate offered by any specific bank or remittance provider.'},
  {q:'How does the Nepal Remittance Calculator work?',a:'Enter an amount in any foreign currency. The calculator multiplies it by the latest NRB official reference buying rate to show the estimated NPR amount. The result is an estimate — actual remittance amounts may vary.'},
  {q:'Does it use Nepal Rastra Bank rates?',a:'Yes. This calculator fetches exchange rates directly from the official Nepal Rastra Bank (NRB) API. NRB publishes official reference foreign exchange rates for major currencies.'},
  {q:'Why is the remittance amount different from the NRB rate?',a:'NRB rates are reference rates. Banks, remittance companies, wallets, and payment providers may apply their own exchange rates, spreads, and fees. Your actual remittance payout may differ from the NRB reference conversion.'},
  {q:'What is the NRB buying rate?',a:'The NRB buying rate is the rate at which the Nepal Rastra Bank buys foreign currency. For remittance conversions (foreign currency → NPR), the buying rate is the relevant reference rate.'},
  {q:'What is the NRB selling rate?',a:'The NRB selling rate is the rate at which the Nepal Rastra Bank sells foreign currency. It is used when converting NPR to foreign currency, not for remittance receiving.'},
  {q:'Why are JPY and KRW quoted using different units?',a:'NRB quotes some currencies like Japanese Yen (JPY) and Korean Won (KRW) per 10 or 100 units rather than per single unit. This calculator normalizes the rate so you see the per-unit rate automatically.'},
  {q:'Why does the INR rate use 100 units?',a:'NRB quotes the Indian Rupee (INR) rate per 100 INR. This calculator normalizes it to show the per-1-INR rate. For example, if NRB quotes 160.00 per 100 INR, the per-unit rate is 1.60 NPR.'},
  {q:'Are NRB rates updated every day?',a:'NRB publishes reference rates on business days. On weekends, public holidays, and bank holidays, there may be no new rate. The calculator automatically falls back to the most recent available rate.'},
];
---

<BaseLayout>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 py-8 sm:py-12">
    <Breadcrumbs items={[{label:"Nepal",href:"/nepal"},{label:"Finance",href:"/nepal/finance"},{label:"Remittance Calculator"}]} />

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight" style="color:var(--nk-text);">Nepal Remittance Calculator</h1>
      <p class="mt-1.5 text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Estimate how much your foreign currency is worth in Nepal using the latest NRB reference rate.</p>
    </div>

    <!-- Loading State -->
    <div id="loading-state" class="rounded-xl border p-8 text-center" style="background-color:var(--nk-surface);border-color:var(--nk-border);">
      <div class="inline-block w-6 h-6 border-2 rounded-full animate-spin mb-3" style="border-color:var(--nk-border);border-top-color:var(--nk-accent);"></div>
      <p class="text-sm" style="color:var(--nk-text-secondary);">Loading latest NRB rates…</p>
    </div>

    <!-- Error State -->
    <div id="error-state" class="hidden rounded-xl border p-6 text-center" style="background-color:var(--nk-surface);border-color:var(--nk-border);">
      <p class="text-sm font-medium mb-2" style="color:#DC2626;">Exchange rates are temporarily unavailable.</p>
      <p class="text-xs mb-3" style="color:var(--nk-text-secondary);">Please check your connection and try again.</p>
      <button id="retry-btn" class="px-4 py-2 text-xs font-semibold rounded-lg" style="background-color:var(--nk-accent);color:white;">Try Again</button>
    </div>

    <!-- Calculator -->
    <div id="calculator" class="hidden">

      <!-- Two-column layout on desktop: Input + Result -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">

        <!-- Input Card (left, narrower) -->
        <div class="md:col-span-2 rounded-xl border p-5 space-y-4" style="background-color:var(--nk-surface);border-color:var(--nk-border);">

          <!-- Amount -->
          <div>
            <label for="amount-input" class="block text-[10px] font-bold uppercase tracking-widest mb-1.5" style="color:var(--nk-text-secondary);">Amount you're sending</label>
            <div class="relative">
              <span id="amount-symbol" class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-semibold" style="color:var(--nk-text-secondary);">$</span>
              <input id="amount-input" type="text" inputmode="decimal" placeholder="1,000" class="w-full pl-10 pr-3 py-3 rounded-lg border text-xl font-bold tracking-tight" style="background-color:var(--nk-bg);border-color:var(--nk-border);color:var(--nk-text);" />
            </div>
          </div>

          <!-- Quick amounts -->
          <div id="quick-amounts" class="flex flex-wrap gap-1.5"></div>

          <!-- Currency -->
          <div>
            <label for="currency-search" class="block text-[10px] font-bold uppercase tracking-widest mb-1.5" style="color:var(--nk-text-secondary);">Currency</label>
            <div class="relative" id="currency-wrapper">
              <input id="currency-search" type="text" placeholder="Search currency…" autocomplete="off" class="w-full px-3 py-2.5 rounded-lg border text-sm font-medium" style="background-color:var(--nk-bg);border-color:var(--nk-border);color:var(--nk-text);" />
              <div id="currency-dropdown" class="hidden absolute z-30 mt-1 w-full rounded-lg border shadow-lg max-h-60 overflow-y-auto" style="background-color:var(--nk-surface);border-color:var(--nk-border);"></div>
            </div>
          </div>

          <!-- Transfer Fee -->
          <div>
            <label for="fee-input" class="block text-[10px] font-bold uppercase tracking-widest mb-1.5" style="color:var(--nk-text-secondary);">Transfer fee</label>
            <input id="fee-input" type="text" inputmode="decimal" placeholder="0" class="w-full px-3 py-2.5 rounded-lg border text-sm font-medium" style="background-color:var(--nk-bg);border-color:var(--nk-border);color:var(--nk-text);" />
            <p class="text-[10px] mt-1" style="color:var(--nk-text-secondary);">Fee charged by your service provider (optional)</p>
            <div class="flex rounded-lg border mt-2 overflow-hidden" style="border-color:var(--nk-border);">
              <button id="fee-foreign" class="fee-type-btn flex-1 py-1.5 text-[11px] font-semibold" style="background-color:var(--nk-accent);color:white;">Foreign currency</button>
              <button id="fee-npr" class="fee-type-btn flex-1 py-1.5 text-[11px] font-semibold" style="background-color:var(--nk-bg);color:var(--nk-text);">NPR</button>
            </div>
          </div>
        </div>

        <!-- Result Card (right, wider, more prominent) -->
        <div class="md:col-span-3 rounded-xl border p-6 flex flex-col justify-center" style="background-color:var(--nk-surface);border-color:var(--nk-border);">

          <!-- Visual flow -->
          <div class="text-center">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] mb-2" style="color:var(--nk-text-secondary);">You could receive approximately</p>
            <p id="result-npr" class="text-[34px] sm:text-6xl font-bold tracking-tighter leading-none mb-3" style="color:var(--nk-accent);">—</p>
            <p id="result-subtitle" class="text-xs" style="color:var(--nk-text-secondary);"></p>
          </div>

          <!-- Rate line -->
          <div class="mt-4 pt-4 text-center" style="border-top:1px solid var(--nk-border);">
            <p class="text-[10px] font-bold uppercase tracking-widest mb-1" style="color:var(--nk-text-secondary);">Today's exchange rate</p>
            <p id="rate-line" class="text-sm font-semibold" style="color:var(--nk-text);"></p>
            <p class="text-[10px] mt-0.5" style="color:var(--nk-text-secondary);">NRB reference buying rate</p>
          </div>

          <!-- Fee line -->
          <div id="fee-line-wrap" class="hidden mt-3 pt-3 text-center" style="border-top:1px solid var(--nk-border);">
            <p class="text-[10px]" style="color:var(--nk-text-secondary);">Transfer fee: <span id="fee-line" class="font-medium" style="color:var(--nk-text);"></span></p>
          </div>

          <!-- Copy -->
          <div class="mt-4 flex justify-center">
            <button id="copy-btn" class="text-[11px] font-medium px-4 py-2 rounded-lg border transition-colors" style="border-color:var(--nk-border);color:var(--nk-text-secondary);">Copy result</button>
          </div>
        </div>
      </div>

      <!-- Rate date + disclaimer -->
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2">
        <p id="rate-date" class="text-[10px]" style="color:var(--nk-text-secondary);"></p>
        <p class="text-[10px]" style="color:var(--nk-text-secondary);">Actual payout may vary by your bank or remittance provider.</p>
      </div>

      <!-- NRB Rate Table -->
      <div class="mt-10">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-base font-bold" style="color:var(--nk-text);">NRB Reference Rates</h2>
          <button id="toggle-rates" class="text-[10px] font-semibold px-2 py-1 rounded" style="color:var(--nk-accent);">Show all</button>
        </div>
        <div id="rate-table-desktop" class="hidden rounded-xl border overflow-hidden" style="border-color:var(--nk-border);">
          <table class="w-full text-xs" style="color:var(--nk-text);">
            <thead>
              <tr style="background-color:var(--nk-bg);">
                <th class="text-left px-3 py-2 font-semibold">Currency</th>
                <th class="text-right px-3 py-2 font-semibold">Unit</th>
                <th class="text-right px-3 py-2 font-semibold">Buy</th>
                <th class="text-right px-3 py-2 font-semibold">Sell</th>
              </tr>
            </thead>
            <tbody id="rate-table-body"></tbody>
          </table>
        </div>
        <div id="rate-table-mobile" class="space-y-1.5"></div>
        <p id="rate-table-date" class="text-[10px] mt-2" style="color:var(--nk-text-secondary);"></p>
      </div>

      <!-- Content -->
      <div class="mt-10 space-y-6">
        <h2 class="text-lg font-bold" style="color:var(--nk-text);">How does the Nepal Remittance Calculator work?</h2>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Enter an amount in any foreign currency. The calculator multiplies it by the latest <strong style="color:var(--nk-text);">NRB official reference buying rate</strong> to show the estimated NPR amount. The result is an estimate — actual remittance amounts may vary depending on your provider.</p>

        <h3 class="text-sm font-semibold" style="color:var(--nk-text);">What is the NRB exchange rate?</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">The Nepal Rastra Bank (NRB) publishes official reference foreign exchange rates for major currencies on business days. These are reference rates used by the central bank, not the exact rates offered by any specific bank or remittance company.</p>

        <h3 class="text-sm font-semibold" style="color:var(--nk-text);">Does the NRB rate equal the amount I receive?</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);"><strong style="color:var(--nk-text);">No.</strong> Banks, remittance companies, wallets, and payment providers may apply their own exchange rates, spreads, and fees. Your actual remittance payout may differ from the NRB reference conversion shown here.</p>

        <h3 class="text-sm font-semibold" style="color:var(--nk-text);">Why is my actual remittance amount different?</h3>
        <p class="text-sm leading-relaxed" style="color:var(--nk-text-secondary);">Possible reasons include: provider exchange-rate margin, transfer fee, service charge, receiving fee, promotional rate, or provider-specific pricing. Always check with your remittance provider for their exact rate.</p>
      </div>

      <!-- FAQ -->
      <div class="mt-10 space-y-3">
        <h2 class="text-lg font-bold" style="color:var(--nk-text);">Frequently Asked Questions</h2>
        <div class="space-y-2">
          {faqItems.map(item => (
            <details class="rounded-xl border" style="border-color:var(--nk-border);background-color:var(--nk-surface);">
              <summary class="px-4 py-3 text-sm font-medium cursor-pointer" style="color:var(--nk-text);">{item.q}</summary>
              <div class="px-4 pb-3 text-sm leading-relaxed" style="color:var(--nk-text-secondary);border-top:1px solid var(--nk-border);"><p class="pt-3">{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>

      <!-- Source -->
      <div class="mt-8 rounded-xl border px-4 py-3 text-[10px]" style="border-color:var(--nk-border);background-color:var(--nk-surface);color:var(--nk-text-secondary);">
        <p class="mb-1"><strong style="color:var(--nk-text);">Exchange Rate Source:</strong> <a href="https://www.nrb.org.np" target="_blank" rel="noopener" class="underline" style="color:var(--nk-accent);">Nepal Rastra Bank</a></p>
        <p><strong style="color:var(--nk-text);">Disclaimer:</strong> NRB reference rates. Actual remittance payout may differ.</p>
      </div>

      <RelatedTools tools={relatedTools} />
    </div>
  </div>
</BaseLayout>

<script>
  import { fetchNRBRates, convertToNPR, applyFee, formatDateLong, formatNPR, formatForeign, getCurrencySymbol } from "../../../lib/calculators/remittance.js";

  var ratesData = null;
  var selectedCurrency = "USD";
  var amount = "";
  var feeType = "foreign";
  var feeAmount = "";
  var showAll = false;

  var loadingEl = document.getElementById("loading-state");
  var errorEl = document.getElementById("error-state");
  var calcEl = document.getElementById("calculator");
  var searchInput = document.getElementById("currency-search");
  var dropdownEl = document.getElementById("currency-dropdown");
  var amountInput = document.getElementById("amount-input");
  var amountSymbol = document.getElementById("amount-symbol");
  var resultNPR = document.getElementById("result-npr");
  var resultSubtitle = document.getElementById("result-subtitle");
  var rateLine = document.getElementById("rate-line");
  var rateDate = document.getElementById("rate-date");

  var CURRENCY_META_REF = {
    AUD: { flag: "🇦🇺", name: "Australian Dollar" },
    BHD: { flag: "🇧🇭", name: "Bahraini Dinar" },
    CAD: { flag: "🇨🇦", name: "Canadian Dollar" },
    CHF: { flag: "🇨🇭", name: "Swiss Franc" },
    CNY: { flag: "🇨🇳", name: "Chinese Yuan" },
    DKK: { flag: "🇩🇰", name: "Danish Krone" },
    EUR: { flag: "🇪🇺", name: "Euro" },
    GBP: { flag: "🇬🇧", name: "British Pound" },
    HKD: { flag: "🇭🇰", name: "Hong Kong Dollar" },
    INR: { flag: "🇮🇳", name: "Indian Rupee" },
    JPY: { flag: "🇯🇵", name: "Japanese Yen" },
    KRW: { flag: "🇰🇷", name: "South Korean Won" },
    KWD: { flag: "🇰🇼", name: "Kuwaiti Dinar" },
    MYR: { flag: "🇲🇾", name: "Malaysian Ringgit" },
    OMR: { flag: "🇴🇲", name: "Omani Rial" },
    QAR: { flag: "🇶🇦", name: "Qatari Riyal" },
    SAR: { flag: "🇸🇦", name: "Saudi Riyal" },
    SEK: { flag: "🇸🇪", name: "Swedish Krona" },
    SGD: { flag: "🇸🇬", name: "Singapore Dollar" },
    THB: { flag: "🇹🇭", name: "Thai Baht" },
    USD: { flag: "🇺🇸", name: "U.S. Dollar" },
    AED: { flag: "🇦🇪", name: "UAE Dirham" },
  };

  async function init() {
    loadingEl.classList.remove("hidden");
    errorEl.classList.add("hidden");
    calcEl.classList.add("hidden");
    try {
      var cached = localStorage.getItem("nrb_rates");
      if (cached) {
        var c = JSON.parse(cached);
        if (Date.now() - c.timestamp < 3600000) {
          ratesData = c;
          onRatesLoaded();
          loadingEl.classList.add("hidden");
          calcEl.classList.remove("hidden");
          fetchFreshRates();
          return;
        }
      }
    } catch (e) {}
    await fetchFreshRates();
  }

  async function fetchFreshRates() {
    try {
      var result = await fetchNRBRates();
      if (result && result.rates && result.rates.length > 0) {
        ratesData = { rates: result.rates, date: result.date, timestamp: Date.now() };
        try { localStorage.setItem("nrb_rates", JSON.stringify(ratesData)); } catch (e) {}
        loadingEl.classList.add("hidden");
        errorEl.classList.add("hidden");
        calcEl.classList.remove("hidden");
        onRatesLoaded();
      } else {
        if (ratesData) { loadingEl.classList.add("hidden"); calcEl.classList.remove("hidden"); onRatesLoaded(); }
        else { loadingEl.classList.add("hidden"); errorEl.classList.remove("hidden"); }
      }
    } catch (e) {
      if (ratesData) { loadingEl.classList.add("hidden"); calcEl.classList.remove("hidden"); onRatesLoaded(); }
      else { loadingEl.classList.add("hidden"); errorEl.classList.remove("hidden"); }
    }
  }

  function onRatesLoaded() {
    populateCurrencyDropdown();
    updateCurrencyDisplay();
    renderQuickAmounts();
    renderRateTable();
    calculate();
  }

  function populateCurrencyDropdown() {
    dropdownEl.innerHTML = "";
    ratesData.rates.map(function (r) { return r.iso3; }).sort().forEach(function (iso) {
      var meta = CURRENCY_META_REF[iso] || {};
      var item = document.createElement("div");
      item.className = "px-3 py-2 cursor-pointer text-sm flex items-center gap-2 hover:opacity-80 transition-opacity";
      item.style.color = "var(--nk-text)";
      item.dataset.iso = iso;
      item.innerHTML = '<span>' + (meta.flag || "") + '</span><span class="font-medium">' + iso + '</span><span class="text-[10px]" style="color:var(--nk-text-secondary);">' + (meta.name || iso) + '</span>';
      item.addEventListener("click", function () {
        selectedCurrency = iso;
        searchInput.value = "";
        dropdownEl.classList.add("hidden");
        updateCurrencyDisplay();
        renderQuickAmounts();
        calculate();
      });
      dropdownEl.appendChild(item);
    });
  }

  function updateCurrencyDisplay() {
    var meta = CURRENCY_META_REF[selectedCurrency] || {};
    searchInput.placeholder = (meta.flag || "") + " " + selectedCurrency + " — " + (meta.name || selectedCurrency);
    amountSymbol.textContent = getCurrencySymbol(selectedCurrency);
  }

  searchInput.addEventListener("focus", function () {
    searchInput.value = "";
    dropdownEl.classList.remove("hidden");
    populateCurrencyDropdown();
  });

  searchInput.addEventListener("input", function () {
    var q = searchInput.value.toLowerCase().trim();
    dropdownEl.classList.remove("hidden");
    var items = dropdownEl.children;
    for (var i = 0; i < items.length; i++) {
      var iso = items[i].dataset.iso;
      var meta = CURRENCY_META_REF[iso] || {};
      items[i].style.display = ((iso + " " + (meta.name || "")).toLowerCase().indexOf(q) !== -1) ? "" : "none";
    }
  });

  document.addEventListener("click", function (e) {
    if (!document.getElementById("currency-wrapper").contains(e.target)) dropdownEl.classList.add("hidden");
  });

  amountInput.addEventListener("input", function () { amount = amountInput.value; calculate(); });

  function renderQuickAmounts() {
    var c = document.getElementById("quick-amounts");
    c.innerHTML = "";
    var sym = getCurrencySymbol(selectedCurrency);
    [100, 500, 1000, 5000, 10000].forEach(function (a) {
      var btn = document.createElement("button");
      btn.className = "px-3 py-1.5 text-[11px] font-medium rounded-lg border transition-colors";
      btn.style.borderColor = "var(--nk-border)";
      btn.style.color = "var(--nk-text-secondary)";
      btn.textContent = sym + a.toLocaleString();
      btn.addEventListener("click", function () { amountInput.value = a; amount = String(a); calculate(); });
      c.appendChild(btn);
    });
  }

  document.getElementById("fee-foreign").addEventListener("click", function () {
    feeType = "foreign";
    this.style.backgroundColor = "var(--nk-accent)";
    this.style.color = "white";
    document.getElementById("fee-npr").style.backgroundColor = "var(--nk-bg)";
    document.getElementById("fee-npr").style.color = "var(--nk-text)";
    calculate();
  });

  document.getElementById("fee-npr").addEventListener("click", function () {
    feeType = "npr";
    this.style.backgroundColor = "var(--nk-accent)";
    this.style.color = "white";
    document.getElementById("fee-foreign").style.backgroundColor = "var(--nk-bg)";
    document.getElementById("fee-foreign").style.color = "var(--nk-text)";
    calculate();
  });

  document.getElementById("fee-input").addEventListener("input", function () { feeAmount = this.value; calculate(); });

  function calculate() {
    if (!ratesData) return;
    var rate = ratesData.rates.find(function (r) { return r.iso3 === selectedCurrency; });
    if (!rate) { resultNPR.textContent = "—"; resultSubtitle.textContent = ""; rateLine.textContent = ""; return; }

    var amt = parseFloat(amount.replace(/,/g, ""));
    var feeEnabled = feeAmount && parseFloat(feeAmount.replace(/,/g, "")) > 0;
    var fee = feeEnabled ? parseFloat(feeAmount.replace(/,/g, "")) : 0;

    if (isNaN(amt) || amt <= 0) {
      resultNPR.textContent = "—";
      resultSubtitle.textContent = "";
      rateLine.textContent = "1 " + selectedCurrency + " = " + formatNPR(rate.normalizedBuy);
      rateDate.textContent = "Updated " + formatDateLong(ratesData.date);
      document.getElementById("fee-line-wrap").classList.add("hidden");
      return;
    }

    var npr = convertToNPR(amt, rate.normalizedBuy);
    if (npr === null) { resultNPR.textContent = "—"; return; }

    if (feeEnabled) {
      var feeResult = applyFee(npr, amt, fee, feeType, rate.normalizedBuy);
      npr = feeResult.netNPR;
      document.getElementById("fee-line-wrap").classList.remove("hidden");
      document.getElementById("fee-line").textContent = feeType === "foreign"
        ? selectedCurrency + " " + formatForeign(fee) + " (≈ " + formatNPR(feeResult.feeNPR) + ")"
        : formatNPR(fee);
    } else {
      document.getElementById("fee-line-wrap").classList.add("hidden");
    }

    resultNPR.textContent = formatNPR(npr);
    resultSubtitle.textContent = formatForeign(amt) + " " + selectedCurrency + " × " + formatNPR(rate.normalizedBuy);
    rateLine.textContent = "1 " + selectedCurrency + " = " + formatNPR(rate.normalizedBuy);
    rateDate.textContent = "Updated " + formatDateLong(ratesData.date);
  }

  function renderRateTable() {
    if (!ratesData) return;
    var tbody = document.getElementById("rate-table-body");
    var mob = document.getElementById("rate-table-mobile");
    tbody.innerHTML = "";
    mob.innerHTML = "";
    var rates = ratesData.rates.slice().sort(function (a, b) { return a.iso3.localeCompare(b.iso3); });
    var display = showAll ? rates : rates.slice(0, 8);

    display.forEach(function (r) {
      var meta = CURRENCY_META_REF[r.iso3] || {};
      var tr = document.createElement("tr");
      tr.style.borderTop = "1px solid var(--nk-border)";
      tr.innerHTML =
        '<td class="px-3 py-2 font-medium">' + (meta.flag || "") + ' ' + r.iso3 + ' <span class="text-[10px]" style="color:var(--nk-text-secondary);">' + (meta.name || r.iso3) + '</span></td>' +
        '<td class="text-right px-3 py-2" style="color:var(--nk-text-secondary);">' + r.unit + '</td>' +
        '<td class="text-right px-3 py-2 font-medium">' + r.buy.toFixed(2) + '</td>' +
        '<td class="text-right px-3 py-2 font-medium">' + (r.sell !== null ? r.sell.toFixed(2) : "—") + '</td>';
      tbody.appendChild(tr);

      var card = document.createElement("div");
      card.className = "rounded-lg px-3 py-2 flex items-center justify-between";
      card.style.backgroundColor = "var(--nk-surface)";
      card.style.border = "1px solid var(--nk-border)";
      card.innerHTML =
        '<div><span class="text-xs font-semibold">' + (meta.flag || "") + ' ' + r.iso3 + '</span><span class="text-[10px] ml-1" style="color:var(--nk-text-secondary);">' + (meta.name || r.iso3) + '</span></div>' +
        '<div class="text-right"><span class="text-[10px]" style="color:var(--nk-text-secondary);">Buy </span><span class="text-xs font-bold">' + r.buy.toFixed(2) + '</span>' +
        (r.sell !== null ? '<span class="text-[10px] ml-2" style="color:var(--nk-text-secondary);">Sell </span><span class="text-xs font-bold">' + r.sell.toFixed(2) + '</span>' : '') + '</div>';
      mob.appendChild(card);
    });

    document.getElementById("rate-table-date").textContent = "Rates as of " + formatDateLong(ratesData.date);
    document.getElementById("toggle-rates").textContent = showAll ? "Show less" : "Show all (" + rates.length + ")";
  }

  document.getElementById("toggle-rates").addEventListener("click", function () { showAll = !showAll; renderRateTable(); });

  document.getElementById("copy-btn").addEventListener("click", async function () {
    if (!ratesData) return;
    var rate = ratesData.rates.find(function (r) { return r.iso3 === selectedCurrency; });
    if (!rate) return;
    var amt = parseFloat(amount.replace(/,/g, "")) || 0;
    var npr = convertToNPR(amt, rate.normalizedBuy);
    if (npr === null) return;
    var text = selectedCurrency + " " + formatForeign(amt) + " ≈ NPR " + npr.toLocaleString("en-NP", {minimumFractionDigits:2, maximumFractionDigits:2}) +
      "\nNRB reference rate:\n1 " + selectedCurrency + " = NPR " + rate.normalizedBuy.toFixed(4) +
      "\nRate date: " + formatDateLong(ratesData.date);
    try { await navigator.clipboard.writeText(text); } catch (e) {}
  });

  document.getElementById("retry-btn").addEventListener("click", function () {
    localStorage.removeItem("nrb_rates");
    ratesData = null;
    init();
  });

  init();
</script>
