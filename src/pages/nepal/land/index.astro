---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/cards/ToolCard.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Sidebar from '../../../components/navigation/Sidebar.astro';
import CategoryChips from '../../../components/navigation/CategoryChips.astro';
import { getToolsByCategory } from '../../../data/tools.js';

const tools = getToolsByCategory('land');
const currentPath = Astro.url.pathname;
---

<BaseLayout
  title="Nepal Land & Property Converters — Ropani, Aana, Paisa"
  description="Convert Nepali land units: Ropani, Aana, Paisa, Daam, and square feet. Free online converters."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <Breadcrumbs items={[
      { label: 'Nepal', href: '/nepal' },
      { label: 'Land & Property' },
    ]} />

    <div class="flex gap-10">
      <Sidebar currentPath={currentPath} />

      <div class="flex-1 min-w-0">
        <div class="mb-8">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight" style="color: var(--nk-text);">Land & Property</h1>
          <p class="mt-2 text-base" style="color: var(--nk-text-secondary);">
            Convert Nepali land measurement units.
          </p>
        </div>

        <CategoryChips currentId="land" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {tools.map(tool => (
            <ToolCard title={tool.title} description={tool.description} href={tool.href} />
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
