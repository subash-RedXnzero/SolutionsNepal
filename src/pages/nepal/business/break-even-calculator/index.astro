---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import RelatedTools from '../../../../components/ui/RelatedTools.astro';
import { Store, UtensilsCrossed, ShoppingCart, Briefcase, Factory, Laptop, Shapes, Calculator } from '@lucide/astro';
import Disclaimer from '../../../../components/ui/Disclaimer.astro';

const title = 'Break-Even Calculator Nepal 2026 | SolutionsNepal';
const description = 'Calculate your business break-even point in Nepal. Find required sales, break-even revenue, profit, margin of safety and target sales using Rs.';
const canonical = 'https://solutionsnepal.com/nepal/business/break-even-calculator';

const bizTypes = [
  { id:'retail', label:'Retail Shop', icon: Store },
  { id:'restaurant', label:'Restaurant / Cafe', icon: UtensilsCrossed },
  { id:'ecommerce', label:'E-commerce', icon: ShoppingCart },
  { id:'service', label:'Service Business', icon: Briefcase },
  { id:'manufacturing', label:'Manufacturing', icon: Factory },
  { id:'freelance', label:'Freelance', icon: Laptop },
  { id:'other', label:'Other', icon: Shapes },
];

const faq = [
  { q:'What is a break-even point?', a:'The break-even point is where your total revenue exactly covers your total costs — you make no profit and no loss. Selling more than this earns profit; selling less means a loss.' },
  { q:'How do I calculate break-even sales?', a:'Break-Even Units = Total Monthly Fixed Costs ÷ (Selling Price per Unit − Variable Cost per Unit). Multiply by your selling price to get break-even revenue. This calculator does it instantly and shows margin, profit and target-profit sales too.' },
  { q:'What is fixed cost?', a:'Costs that stay the same each month regardless of sales — like rent, salaries, internet, electricity, insurance, loan payments, marketing and accounting fees.' },
  { q:'What is variable cost?', a:'Costs that change with each unit sold — like materials, packaging, delivery, payment processing or commission. If you sell nothing, you pay no variable cost.' },
  { q:'What is contribution margin?', a:'Selling price minus variable cost. It is the amount each sale contributes to covering fixed costs and then profit. Ratio = contribution ÷ selling price. Example: Rs 1,000 − Rs 400 = Rs 600 (60%).' },
  { q:'How can a small business reduce its break-even point?', a:'Raise selling price (if market allows), lower variable cost per unit, or reduce monthly fixed costs like rent or subscriptions. Even a small drop in variable cost can cut break-even units noticeably.' },
  { q:'Can I use this calculator for a restaurant?', a:'Yes. Enter average selling price per dish or per customer, variable cost per serve (ingredients + packaging), monthly fixed costs (rent, staff, utilities), and expected covers. It works for any shop, cafe, restaurant or cloud kitchen.' },
  { q:'Can I use this calculator for a service business?', a:'Yes. Think in “projects” or “clients” — selling price per project, variable cost per project (subcontractors, tools), fixed costs per month, and expected projects. The math is identical for freelance or agency work.' },
];
---

<BaseLayout title={title} description={description} canonical={canonical}
  jsonLd={[
    { '@type':'WebApplication', '@context':'https://schema.org', name:'Business Break-Even Calculator Nepal', description, url:canonical, applicationCategory:'FinanceApplication', operatingSystem:'Web', offers:{'@type':'Offer', price:'0', priceCurrency:'NPR'} },
    { '@type':'FAQPage', '@context':'https://schema.org', mainEntity: faq.map(f=>({ '@type':'Question', name:f.q, acceptedAnswer:{'@type':'Answer', text:f.a}})) }
  ]}>
  <div class="mx-auto max-w-[1560px] px-4 sm:px-6 py-2.5 sm:py-3 cm-wrap">
    <Breadcrumbs items={[{label:'Nepal', href:'/nepal'}, {label:'Business'}, {label:'Break-Even Calculator'}]} />

    <div class="mb-2.5 flex flex-wrap items-end justify-between gap-2">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold tracking-wide uppercase" style="background:var(--nk-accent-subtle); color:var(--nk-accent); border:1px solid var(--nk-accent-muted);">Nepal Business Utility • 2026 • Rs. only</div>
        <h1 class="text-[20px] sm:text-[24px] font-extrabold tracking-[-0.03em] leading-[1.05] mt-1" style="color:var(--nk-text);">Business Break-Even Calculator Nepal</h1>
        <p class="text-[12.5px] leading-[1.4] mt-0.5 max-w-[640px]" style="color:var(--nk-text-secondary);">Find out how much you need to sell to cover your costs and reach your break-even point.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.75fr_380px] xl:grid-cols-[1.9fr_400px] gap-4 items-start">

      <!-- LEFT -->
      <div class="space-y-2.5 min-w-0">
        <section class="nk-card top-accent p-3 sm:p-3.5" style="border-radius:14px;">
          <p class="sec-head"><span class="sec-icon">◈</span> Business type <span class="sub">— optional</span></p>
          <div class="flex flex-wrap gap-1.5" id="biz-chips">
            {bizTypes.map(b=>{
              const Icon=b.icon;
              return <button type="button" class="chip biz-chip" data-biz={b.id}><Icon size={13}/> {b.label}</button>
            })}
          </div>
          <div class="mt-3 pt-3" style="border-top:1px solid var(--nk-border);">
            <p class="sec-head"><span class="sec-icon">₨</span> Product / Service</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div class="cm-field"><label class="cm-label" for="sp">Selling price per unit</label><div class="cm-box"><span class="cm-prefix">Rs</span><input id="sp" type="text" inputmode="decimal" placeholder="e.g. 1,000" class="cm-input" /></div></div>
              <div class="cm-field"><label class="cm-label" for="vc">Cost of making one product</label><div class="cm-box"><span class="cm-prefix">Rs</span><input id="vc" type="text" inputmode="decimal" placeholder="e.g. 400" class="cm-input" /></div></div>
              <div class="cm-field"><label class="cm-label" for="exp">Expected monthly sales</label><div class="cm-box"><input id="exp" type="text" inputmode="numeric" placeholder="e.g. 300" class="cm-input" style="padding-left:10px;" /><span class="cm-suffix">units</span></div></div>
            </div>
            <p class="text-[10.5px] mt-1.5" style="color:var(--nk-text-tertiary);">Variable cost covers materials, packaging, delivery, commission per unit.</p>
          </div>
        </section>

        <section class="nk-card top-accent p-3 sm:p-3.5" style="border-radius:14px;">
          <p class="sec-head"><span class="sec-icon">⌂</span> Monthly Fixed Costs</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2" id="fixed-grid">
            <div class="cm-field"><label class="cm-label">Rent</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="rent" type="text" inputmode="decimal" placeholder="e.g. 30,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Employee salaries</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="salaries" type="text" inputmode="decimal" placeholder="e.g. 60,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Internet & phone</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="internet" type="text" placeholder="e.g. 2,500" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Electricity</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="electricity" type="text" placeholder="e.g. 8,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Insurance</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="insurance" type="text" placeholder="e.g. 3,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Loan / equipment</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="loan" type="text" placeholder="e.g. 15,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Marketing</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="marketing" type="text" placeholder="e.g. 7,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Accounting / fees</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="accounting" type="text" placeholder="e.g. 5,000" class="cm-input" /></div></div>
            <div class="cm-field"><label class="cm-label">Other fixed costs</label><div class="cm-box"><span class="cm-prefix">Rs</span><input data-fixed="other" type="text" placeholder="e.g. 10,000" class="cm-input" /></div></div>
          </div>
          <div id="custom-block" class="mt-3">
            <div class="flex items-center justify-between gap-3 mb-1.5">
              <p class="text-[11px] font-bold uppercase tracking-wider" style="color:var(--nk-text-tertiary); letter-spacing:0.06em;">Custom Expenses</p>
              <button type="button" id="add-expense" class="shrink-0 inline-flex items-center gap-1 text-[12px] font-semibold px-3.5 py-1.5 rounded-full border" style="border-color:var(--nk-border); background:var(--nk-surface); color:var(--nk-text);">+ Add expense</button>
            </div>
            <div id="quick-add" class="hidden">
              <div class="quick-add-row">
                <input id="qa-name" type="text" placeholder="e.g. Cleaning service" autocomplete="off" enterkeyhint="next" maxlength="40" aria-label="Expense name" />
                <div class="quick-amt"><span class="rs">Rs</span><input id="qa-amount" type="text" inputmode="numeric" placeholder="5,000" aria-label="Amount" /></div>
                <button type="button" id="qa-add" aria-label="Add expense" title="Add expense">+</button>
              </div>
              <p id="quick-error" class="hidden text-[11px] font-medium mt-1.5" style="color:#DC2626;" role="alert"></p>
            </div>
            <div id="custom-empty" class="rounded-xl px-3.5 py-2 text-center" style="border:1px dashed var(--nk-border-strong); background:var(--nk-surface);">
              <p class="text-[12px]" style="color:var(--nk-text-tertiary);"><strong style="color:var(--nk-text-secondary);">No custom expenses yet</strong> — add expenses that aren't listed above.</p>
            </div>
            <div id="custom-list"></div>
          </div>
          <div class="mt-3 pt-2.5 flex items-center justify-between" style="border-top:1px solid var(--nk-border);"><span class="text-[13px] font-bold" style="color:var(--nk-text);">Total fixed costs</span><strong id="fixed-total" class="text-[14px] font-extrabold tabular-nums" style="color:var(--nk-text);">Rs 0</strong></div>
        </section>

        <section class="nk-card top-accent p-3 sm:p-3.5" style="border-radius:14px;">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="flex items-center gap-2 cursor-pointer"><input id="vat-toggle" type="checkbox" style="width:15px; height:15px; accent-color:var(--nk-accent);" /> <span class="text-[12.5px] font-semibold" style="color:var(--nk-text);">Include VAT</span><span class="text-[10.5px] px-2 py-0.5 rounded-full" style="background:var(--nk-hover); border:1px solid var(--nk-border); color:var(--nk-text-tertiary);">optional</span></label>
              <div id="vat-row" class="hidden mt-2.5 grid grid-cols-2 gap-2.5">
                <div class="cm-field"><label class="cm-label">VAT rate</label><div class="cm-box"><input id="vat-rate" type="text" placeholder="13" class="cm-input" style="padding-left:10px;" /><span class="cm-suffix">%</span></div></div>
                <p class="text-[10.5px] leading-relaxed self-end" style="color:var(--nk-text-tertiary);">Price includes VAT. Not tax advice.</p>
              </div>
              <p id="vat-hint" class="text-[10.5px] mt-1.5" style="color:var(--nk-text-tertiary);">Model 13% VAT when relevant.</p>
            </div>
            <div>
              <p class="sec-head"><span class="sec-icon">◎</span> Target Profit <span class="sub">— optional</span></p>
              <div class="cm-field"><label class="cm-label" for="target">Monthly profit goal</label><div class="cm-box"><span class="cm-prefix">Rs</span><input id="target" type="text" inputmode="decimal" placeholder="e.g. 50,000" class="cm-input" /></div></div>
            </div>
          </div>
        </section>

        <div class="flex gap-2.5">
          <button type="button" id="calc-btn" class="nk-btn nk-btn-primary flex-1 py-2 text-[14px] font-bold" style="border-radius:12px;"><Calculator size={16}/> Calculate</button>
          <button type="button" id="reset-btn" class="nk-btn nk-btn-secondary px-6 py-2 text-[13px] font-semibold" style="border-radius:12px;">Reset</button>
        </div>
        <p id="calc-hint" class="hidden text-[11px] text-center font-medium" style="color:#DC2626;"></p>
      </div>

      <!-- RIGHT: sticky results -->
      <div class="lg:sticky lg:top-4 space-y-3">
        <div class="nk-card overflow-hidden" id="result-card" style="border-radius:16px;">
          <div id="res-empty" class="p-5 text-center">
            <div class="w-11 h-11 rounded-xl mx-auto flex items-center justify-center mb-2" style="background:var(--nk-accent-subtle); color:var(--nk-accent); border:1px solid var(--nk-accent-muted);"><Calculator size={18}/></div>
            <p class="text-[12px] font-bold uppercase tracking-wider" style="color:var(--nk-text-tertiary);">Your break-even point</p>
            <p class="text-[28px] font-extrabold leading-none mt-1" style="color:var(--nk-text-tertiary);">—</p>
            <p class="text-[11.5px] mt-2" style="color:var(--nk-text-secondary);">Enter selling price, variable cost and fixed costs, then click <strong>Calculate</strong>.</p>
          </div>
          <div id="res-body" class="hidden">
            <div class="px-4 pt-4 pb-3 text-center res-hero" style="border-bottom:1px solid var(--nk-border);">
              <p class="text-[10.5px] font-bold uppercase tracking-wider" style="color:var(--nk-text-tertiary);">Your Break-Even Point</p>
              <p class="text-[34px] font-extrabold leading-none mt-1 tabular-nums nk-gradient-text" id="res-units">—</p>
              <p class="text-[11.5px] font-semibold" style="color:var(--nk-text-secondary);">per month</p>
              <p class="text-[11.5px] mt-1.5 max-w-[320px] mx-auto" style="color:var(--nk-text-secondary);" id="res-line">—</p>
            </div>
            <div class="p-3.5 space-y-2.5">
              <!-- Key figures -->
              <div class="rounded-xl text-[12px]" style="border:1px solid var(--nk-border);">
                <div class="flex justify-between px-3 py-2 tabular-nums"><span style="color:var(--nk-text-secondary);">Break-even revenue</span><strong style="color:var(--nk-text);" id="res-rev">—</strong></div>
                <div class="flex justify-between px-3 py-2 tabular-nums" style="border-top:1px solid var(--nk-border);"><span style="color:var(--nk-text-secondary);">Contribution margin</span><strong style="color:var(--nk-text);"><span id="res-cm">—</span> <span class="font-normal" style="color:var(--nk-text-tertiary);" id="res-cmr">—</span></strong></div>
                <div class="flex justify-between px-3 py-2 tabular-nums" style="border-top:1px solid var(--nk-border);"><span style="color:var(--nk-text-secondary);">Monthly fixed costs</span><strong style="color:var(--nk-text);" id="res-fc">—</strong></div>
              </div>

              <!-- Profit -->
              <div id="res-profit-box" class="rounded-xl p-3" style="border:1px solid var(--nk-border);"></div>

              <!-- Position bar -->
              <div class="rounded-xl px-3 pt-2.5 pb-2" style="border:1px solid var(--nk-border);">
                <div class="relative h-2 rounded-full" style="background:var(--nk-muted);">
                  <div id="vis-fill" class="absolute left-0 top-0 bottom-0 rounded-full" style="background:var(--nk-accent); width:0%;"></div>
                  <div id="vis-dot" class="absolute top-1/2 -translate-y-1/2 w-3 h-3 rounded-full border-2" style="background:var(--nk-surface); border-color:var(--nk-accent); left:0%;"></div>
                </div>
                <div class="flex justify-between text-[10.5px] mt-1 tabular-nums" style="color:var(--nk-text-tertiary);"><span>Loss · 0</span><span id="vis-be">Break-even</span><span id="vis-exp">Expected · Profit</span></div>
              </div>

              <!-- Margin of safety + target: single lines -->
              <p id="res-mos" class="hidden text-[11.5px] tabular-nums px-1" style="color:var(--nk-text-secondary);"></p>
              <div id="res-target" class="hidden rounded-xl px-3 py-2.5 text-[12px]" style="background:var(--nk-hover); border:1px solid var(--nk-border);"></div>

              <!-- Details (collapsed) -->
              <details class="rounded-xl" style="border:1px solid var(--nk-border);">
                <summary class="px-3 py-2 text-[12px] font-semibold cursor-pointer select-none" style="color:var(--nk-text);">Expense breakdown</summary>
                <div id="res-breakdown" class="px-3 pb-2.5 space-y-1 text-[12px]"></div>
              </details>

              <div id="res-vat" class="hidden rounded-xl p-3 text-[11.5px]" style="background:var(--nk-hover); border:1px solid var(--nk-border);"></div>
              <div id="res-warn" class="space-y-1.5"></div>
              <div class="flex gap-2"><button id="copy-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1">Copy</button><button id="print-btn" class="nk-btn nk-btn-secondary nk-btn-sm flex-1">Print</button></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 max-w-3xl space-y-6">
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">What Is the Break-Even Point?</h2><p class="text-[12.5px] leading-relaxed" style="color:var(--nk-text-secondary);">The break-even point is where your business covers all costs. <strong>Fixed costs</strong> stay the same each month (rent, salaries). <strong>Variable costs</strong> change per unit (materials, packaging). <strong>Contribution margin</strong> = selling price − variable cost. When you sell exactly <em>fixed costs ÷ contribution margin</em> units, you break even.</p></section>
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">How to Calculate Break-Even Point</h2><div class="rounded-xl p-3 text-[12.5px] font-mono" style="background:var(--nk-hover); border:1px solid var(--nk-border); color:var(--nk-text);">Break-Even Units = Fixed Costs ÷ (Selling Price − Variable Cost)</div><p class="text-[11.5px] mt-1.5" style="color:var(--nk-text-tertiary);">Multiply by selling price for break-even revenue. Contribution margin ratio helps you see profit per Rs 100 of sales.</p></section>
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">Break-Even Example for a Nepal Business</h2><p class="text-[12.5px] leading-relaxed" style="color:var(--nk-text-secondary);"><em>Example — not market data:</em> A shop sells a product at Rs 1,000 with Rs 400 variable cost. Contribution = Rs 600 (60%). If monthly fixed costs are Rs 120,000, break-even = 120,000 ÷ 600 = 200 units → Rs 200,000 revenue. Selling 300 units gives revenue Rs 300,000, variables Rs 120,000, fixed Rs 120,000 → profit Rs 60,000.</p></section>
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">Why Break-Even Analysis Is Important for Small Businesses in Nepal</h2><p class="text-[12.5px] leading-relaxed" style="color:var(--nk-text-secondary);">It clarifies pricing, rent and salary decisions, inventory planning and monthly sales targets. Knowing your break-even helps you set realistic goals, judge discounts, and decide when hiring or higher rent is sustainable.</p></section>
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">How Many Products Do I Need to Sell to Make a Profit?</h2><p class="text-[12.5px] leading-relaxed" style="color:var(--nk-text-secondary);">Use target profit: Required Units = (Fixed Costs + Desired Profit) ÷ Contribution per unit. For Rs 50,000 profit with the example above: (120,000+50,000)÷600 = 284 units → about Rs 284,000 revenue.</p></section>
      <section><h2 class="text-[14px] font-bold mb-1.5" style="color:var(--nk-text);">Frequently Asked Questions</h2><div class="space-y-1.5">{faq.map(f=> <details class="rounded-lg border" style="border-color:var(--nk-border); background:var(--nk-surface);"><summary class="px-3.5 py-2 text-[12.5px] font-medium cursor-pointer select-none" style="color:var(--nk-text);">{f.q}</summary><div class="px-3.5 pb-2.5 text-[12.5px] leading-relaxed" style="color:var(--nk-text-secondary); border-top:1px solid var(--nk-border);"><p class="pt-2">{f.a}</p></div></details>)}</div></section>
      <p class="text-[11px] p-3 rounded-xl" style="background:var(--nk-hover); border:1px solid var(--nk-border); color:var(--nk-text-tertiary);">Estimates only — actual results depend on real fixed/variable costs, seasonality, discounts, taxes and operations.</p>
    </div>

    <Disclaimer variant="finance" />
    <RelatedTools tools={[{title:'House Construction Cost', description:'Estimate build cost per sq ft', href:'/nepal/construction/house-construction-cost'}, {title:'VAT Calculator', description:'Add 13% VAT', href:'/nepal/finance/vat-calculator'}, {title:'Salary Checker', description:'Take-home salary', href:'/nepal/finance/salary-checker'}]} />
  </div>
</BaseLayout>

<style>
  .cm-wrap{ background-image: radial-gradient(900px 320px at 20% 0%, var(--nk-accent-subtle), transparent 65%), linear-gradient(180deg, var(--nk-accent-subtle), transparent 280px); }
  .sec-head{ display:flex; align-items:center; gap:6px; font-size:11.5px; font-weight:700; color:var(--nk-text); margin-bottom:5px; letter-spacing:-0.01em; }
  .sec-icon{ display:inline-flex; align-items:center; justify-content:center; width:20px; height:20px; border-radius:6px; font-size:10px; background:var(--nk-gradient-primary); color:#fff; flex-shrink:0; }
  .chip{ display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:9999px; border:1px solid var(--nk-border); background:var(--nk-surface); color:var(--nk-text-secondary); font-size:11px; font-weight:500; cursor:pointer; transition:all 140ms ease; }
  .chip:hover{ border-color:var(--nk-accent); color:var(--nk-accent); transform:translateY(-1px); }
  .chip.chip-active{ background:var(--nk-gradient-primary); border-color:transparent; color:#fff; font-weight:600; box-shadow:0 4px 12px -4px rgba(230,43,30,.5); }
  .cm-field{ display:flex; flex-direction:column; gap:4px; }
  .cm-label{ font-size:11px; font-weight:600; color:var(--nk-text); }
  .cm-box{ position:relative; display:flex; align-items:center; height:36px; border:1px solid var(--nk-border); border-radius:10px; background:var(--nk-surface); transition:border-color 150ms ease, box-shadow 150ms ease, transform 120ms ease; }
  .cm-box:hover{ border-color:var(--nk-border-strong); }
  .top-accent{ position:relative; overflow:hidden; }
  .top-accent::before{ content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--nk-gradient-primary); }
  .cm-box:focus-within{ border-color:var(--nk-accent); box-shadow:0 0 0 3px var(--nk-accent-subtle); }
  .cm-box:has(input:disabled){ opacity:0.6; }
  .cm-prefix{ position:absolute; left:10px; top:50%; transform:translateY(-50%); font-size:11px; font-weight:600; color:var(--nk-text-tertiary); pointer-events:none; }
  .cm-suffix{ position:absolute; right:10px; top:50%; transform:translateY(-50%); font-size:11px; color:var(--nk-text-tertiary); }
  .cm-input{ width:100%; height:100%; border:none !important; background:transparent !important; box-shadow:none !important; padding:0 36px 0 30px !important; font-size:13px; font-weight:500; outline:none; border-radius:10px; }
  #custom-list{ display:flex; flex-direction:column; }
  #custom-list:empty{ display:none; }
  /* quick-add: one compact bordered row — name | amount | + */
  .quick-add-row{ display:grid; grid-template-columns: minmax(0,1.5fr) minmax(0,1fr) 40px; gap:0; align-items:stretch; border:1px solid var(--nk-border-strong); border-radius:12px; overflow:hidden; background:var(--nk-surface); transition:border-color 150ms ease, box-shadow 150ms ease; }
  .quick-add-row:focus-within{ border-color:var(--nk-accent); box-shadow:0 0 0 3px var(--nk-accent-subtle); }
  .quick-add-row input{ width:100%; min-width:0; border:none; background:transparent; outline:none; padding:10px 12px; font-size:13px; font-weight:500; color:var(--nk-text); }
  .quick-add-row input::placeholder{ color:var(--nk-text-tertiary); font-size:12.5px; }
  .quick-add-row #qa-name{ border-right:1px solid var(--nk-border); }
  .quick-amt{ position:relative; display:flex; align-items:center; min-width:0; border-right:1px solid var(--nk-border); }
  .quick-amt .rs{ position:absolute; left:10px; font-size:11px; font-weight:700; color:var(--nk-text-secondary); pointer-events:none; }
  .quick-amt input{ padding-left:30px !important; font-weight:600; }
  #qa-add{ border:none; background:var(--nk-accent); color:#fff; font-size:20px; font-weight:600; line-height:1; cursor:pointer; transition:filter 140ms ease; min-width:40px; }
  #qa-add:hover{ filter:brightness(0.94); }
  #qa-add:active{ transform:scale(0.97); }
  #qa-add:focus-visible{ outline:2px solid var(--nk-accent); outline-offset:2px; }
  /* NOTE: list rows / menus / edit form / toast are rendered by JS at runtime,
     so their styles live in the is:global block below (scoped CSS would not match). */
  #add-expense:hover{ border-color:var(--nk-border-strong) !important; }
  .sr-only{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  @media (max-width: 480px){
    .quick-add-row{ grid-template-columns:1fr; }
    .quick-add-row #qa-name{ border-right:none; border-bottom:1px solid var(--nk-border); padding:12px !important; font-size:16px !important; }
    .quick-amt{ border-right:none; border-bottom:1px solid var(--nk-border); }
    .quick-amt input{ padding:12px 12px 12px 32px !important; font-size:16px !important; }
    #qa-add{ height:44px; font-size:22px; }
  }
  .res-hero{ background:linear-gradient(180deg, var(--nk-accent-subtle) 0%, var(--nk-surface) 72%); position:relative; overflow:hidden; }
  .res-hero::after{ content:''; position:absolute; left:50%; top:-46px; width:220px; height:90px; transform:translateX(-50%); background:radial-gradient(closest-side, var(--nk-accent-subtle), transparent); pointer-events:none; }
  #result-card{ box-shadow:var(--shadow-md); border-top:3px solid var(--nk-accent); }
  .hidden{ display:none !important; }
</style>

<!-- Global (unscoped): JS-rendered custom-expense rows, menus, edit form and
     undo toast are created at runtime without Astro's scope attribute, so
     scoped CSS above would never match them. -->
<style is:global>
  #custom-list{ display:flex; flex-direction:column; }
  #custom-list:empty{ display:none; }
  @keyframes be-slide-in{ from{ opacity:0; transform:translateY(3px);} to{ opacity:1; transform:translateY(0);} }
  .custom-item{ display:grid; grid-template-columns:minmax(0,1fr) auto 30px; gap:8px; align-items:center; padding:9px 4px; animation:be-slide-in 160ms ease; }
  .custom-item + .custom-item{ border-top:1px solid var(--nk-border); }
  .custom-item-name{ font-size:13px; font-weight:500; color:var(--nk-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
  .custom-item-amt{ font-size:13px; font-weight:700; color:var(--nk-text); white-space:nowrap; font-variant-numeric:tabular-nums; }
  .custom-menu-wrap{ position:relative; justify-self:end; }
  .custom-dots{ width:28px; height:28px; border-radius:8px; border:none; background:transparent; color:var(--nk-text-tertiary); font-size:16px; font-weight:700; cursor:pointer; display:grid; place-items:center; line-height:1; transition:background 140ms ease, color 140ms ease; padding:0; }
  .custom-dots:hover{ background:var(--nk-hover); color:var(--nk-text); }
  .custom-dots:focus-visible{ outline:2px solid var(--nk-accent); outline-offset:2px; }
  .custom-menu{ position:absolute; right:0; top:calc(100% + 4px); min-width:132px; background:var(--nk-surface); border:1px solid var(--nk-border); border-radius:10px; box-shadow:var(--shadow-md); padding:4px; z-index:20; }
  .custom-menu button{ display:flex; align-items:center; gap:8px; width:100%; padding:8px 10px; border:none; background:transparent; border-radius:7px; font-size:12.5px; font-weight:500; color:var(--nk-text); cursor:pointer; text-align:left; font-family:inherit; }
  .custom-menu button:hover{ background:var(--nk-hover); }
  .custom-menu button.danger{ color:#DC2626; }
  .custom-menu button.danger:hover{ background:#FEF2F2; }
  .custom-edit-row{ display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) auto auto; gap:6px; align-items:center; grid-column:1 / -1; }
  .custom-edit-row input{ width:100%; min-width:0; border:1px solid var(--nk-border); border-radius:8px; background:var(--nk-surface); padding:7px 10px; font-size:13px; outline:none; color:var(--nk-text); font-family:inherit; }
  .custom-edit-row input:focus{ border-color:var(--nk-accent); box-shadow:0 0 0 3px var(--nk-accent-subtle); }
  .custom-edit-amt-wrap{ position:relative; display:flex; align-items:center; min-width:0; }
  .custom-edit-amt-wrap .rs{ position:absolute; left:8px; font-size:11px; font-weight:700; color:var(--nk-text-secondary); pointer-events:none; }
  .custom-edit-amt-wrap input{ padding-left:28px !important; font-weight:600; }
  .custom-save, .custom-cancel{ height:32px; padding:0 10px; border-radius:8px; font-size:12px; font-weight:700; cursor:pointer; white-space:nowrap; font-family:inherit; }
  .custom-save{ border:none; background:var(--nk-accent); color:#fff; }
  .custom-save:hover{ filter:brightness(0.95); }
  .custom-cancel{ border:1px solid var(--nk-border); background:var(--nk-surface); color:var(--nk-text-secondary); }
  .custom-cancel:hover{ border-color:var(--nk-border-strong); color:var(--nk-text); }
  .custom-edit-error{ grid-column:1 / -1; font-size:11px; font-weight:500; color:#DC2626; margin:0; }
  #undo-toast{ position:fixed; left:50%; bottom:20px; transform:translateX(-50%) translateY(8px); display:flex; align-items:center; gap:12px; background:#1C1917; color:#fff; font-size:12.5px; font-weight:500; padding:10px 14px; border-radius:9999px; box-shadow:0 8px 24px rgba(0,0,0,0.25); opacity:0; pointer-events:none; transition:opacity 180ms ease, transform 180ms ease; z-index:50; font-family:inherit; }
  #undo-toast.show{ opacity:1; pointer-events:auto; transform:translateX(-50%) translateY(0); }
  #undo-toast button{ border:none; background:transparent; color:#FCA5A5; font-size:12.5px; font-weight:700; cursor:pointer; font-family:inherit; }
  #undo-toast button:hover{ color:#fff; }
  @media (max-width: 480px){
    .custom-item{ grid-template-columns:minmax(0,1fr) auto 32px; gap:6px; }
    .custom-item-name, .custom-item-amt{ font-size:14px; }
    .custom-edit-row{ grid-template-columns:1fr 1fr; }
    .custom-edit-row input{ font-size:16px !important; padding:10px 12px; }
    .custom-edit-amt-wrap input{ padding-left:30px !important; }
    .custom-edit-error{ grid-column:1 / -1; }
  }
</style>

<script>
  import { calcBreakEven, sumFixedCosts, formatNPR, formatInt } from '../../../../lib/calculators/business-break-even.js';

  const $ = (id)=> document.getElementById(id);
  let bizType = null;

  // biz chips
  document.querySelectorAll('.biz-chip').forEach(b=>{
    b.addEventListener('click', ()=>{
      document.querySelectorAll('.biz-chip').forEach(x=> x.classList.remove('chip-active'));
      b.classList.add('chip-active');
      bizType = b.dataset.biz;
    });
  });

  // VAT toggle
  $('vat-toggle')?.addEventListener('change', (e)=>{
    $('vat-row').classList.toggle('hidden', !e.target.checked);
    $('vat-hint')?.classList.toggle('hidden', e.target.checked);
  });

  // Custom expenses — compact inline quick-add: name + amount + Add
  // {id, name, amount:number} — only validated adds enter the array, so empty rows never affect math.
  const customExpenses = [];
  let editingId = null;
  let openMenuId = null;
  let lastDeleted = null;
  let undoTimer = null;
  function uid(){ return 'c_'+Date.now()+'_'+Math.random().toString(36).slice(2,6); }
  function refreshResultsIfShown(){
    if(!$('res-body')?.classList.contains('hidden')) doCalc();
  }
  function syncCustomUI(){
    const has = customExpenses.length>0;
    $('custom-empty')?.classList.toggle('hidden', has);
    $('custom-list')?.classList.toggle('hidden', !has);
  }
  function showQuickError(msg){
    const err=$('quick-error');
    if(!err) return;
    if(!msg){ err.classList.add('hidden'); err.textContent=''; return; }
    err.textContent=msg; err.classList.remove('hidden');
  }
  function revealQuickAdd(){
    $('quick-add')?.classList.remove('hidden');
    const name=$('qa-name');
    if(name){ name.focus(); name.scrollIntoView({behavior:'smooth', block:'center'}); }
  }
  function parseQuickAmount(raw){
    const digits=String(raw ?? '').replace(/[^0-9]/g,'');
    if(digits==='') return {ok:false};
    const n=Number(digits);
    if(!Number.isFinite(n) || n<=0) return {ok:false};
    return {ok:true, value:Math.round(n)};
  }
  function submitQuickAdd(){
    const nameEl=$('qa-name'), amtEl=$('qa-amount');
    const name=nameEl.value.trim();
    const parsed=parseQuickAmount(amtEl.value);
    if(!name){ showQuickError('Enter an expense name.'); nameEl.focus(); return; }
    if(!parsed.ok){ showQuickError('Enter a valid amount greater than 0.'); amtEl.focus(); return; }
    showQuickError('');
    customExpenses.push({id:uid(), name, amount:parsed.value});
    nameEl.value=''; amtEl.value='';
    renderCustomList();
    updateFixedTotal();
    refreshResultsIfShown();
    nameEl.focus();
  }
  function esc(s){ return String(s ?? '').replace(/[&<>"']/g, (c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function fmtRs(n){ return 'Rs ' + Number(n).toLocaleString('en-IN'); }
  function renderCustomList(){
    const list=$('custom-list');
    if(!list) return;
    syncCustomUI();
    if(openMenuId && !customExpenses.some(x=>x.id===openMenuId)) openMenuId=null;
    if(editingId && !customExpenses.some(x=>x.id===editingId)) editingId=null;
    list.innerHTML = customExpenses.map((item)=>{
      if(item.id===editingId){
        return `<div class="custom-item" data-id="${item.id}">
          <div class="custom-edit-row">
            <input class="edit-name" type="text" value="${esc(item.name)}" maxlength="40" aria-label="Expense name" />
            <div class="custom-edit-amt-wrap"><span class="rs">Rs</span><input class="edit-amt" type="text" inputmode="numeric" value="${item.amount.toLocaleString('en-IN')}" aria-label="Amount" /></div>
            <button type="button" class="custom-save" data-act="save">Save</button>
            <button type="button" class="custom-cancel" data-act="cancel">Cancel</button>
          </div>
          <p class="custom-edit-error hidden" role="alert"></p>
        </div>`;
      }
      return `<div class="custom-item" data-id="${item.id}">
        <span class="custom-item-name">${esc(item.name)}</span>
        <span class="custom-item-amt">${fmtRs(item.amount)}</span>
        <div class="custom-menu-wrap">
          <button type="button" class="custom-dots" data-act="menu" aria-label="Expense actions" aria-haspopup="menu" aria-expanded="${openMenuId===item.id}">⋮</button>
          ${openMenuId===item.id ? `<div class="custom-menu" role="menu">
            <button type="button" data-act="edit" role="menuitem">✎ Edit</button>
            <button type="button" data-act="duplicate" role="menuitem">⧉ Duplicate</button>
            <button type="button" class="danger" data-act="delete" role="menuitem">🗑 Delete</button>
          </div>` : ''}
        </div>
      </div>`;
    }).join('');
  }
  function showUndoToast(){
    let toast=$('undo-toast');
    if(!toast){
      toast=document.createElement('div');
      toast.id='undo-toast';
      toast.innerHTML=`<span>Expense deleted</span><button type="button">Undo</button>`;
      document.body.appendChild(toast);
      toast.querySelector('button').addEventListener('click', ()=>{
        if(lastDeleted){
          customExpenses.splice(Math.min(lastDeleted.index, customExpenses.length), 0, lastDeleted.item);
          lastDeleted=null;
          renderCustomList(); updateFixedTotal(); refreshResultsIfShown();
        }
        toast.classList.remove('show');
        if(undoTimer){ clearTimeout(undoTimer); undoTimer=null; }
      });
    }
    toast.classList.add('show');
    if(undoTimer) clearTimeout(undoTimer);
    undoTimer=setTimeout(()=>{ toast.classList.remove('show'); lastDeleted=null; undoTimer=null; }, 5000);
  }
  function deleteCustom(id){
    const idx=customExpenses.findIndex(x=>x.id===id);
    if(idx<0) return;
    lastDeleted={item:customExpenses[idx], index:idx};
    customExpenses.splice(idx,1);
    if(editingId===id) editingId=null;
    if(openMenuId===id) openMenuId=null;
    renderCustomList(); updateFixedTotal(); refreshResultsIfShown();
    showUndoToast();
  }
  // quick-add events
  $('add-expense')?.addEventListener('click', revealQuickAdd);
  $('qa-add')?.addEventListener('click', submitQuickAdd);
  $('qa-name')?.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); $('qa-amount')?.focus(); }});
  $('qa-amount')?.addEventListener('input', ()=>{
    const el=$('qa-amount');
    const cleaned=el.value.replace(/[^0-9]/g,'').slice(0,9);
    if(cleaned!==el.value) el.value=cleaned;
    showQuickError('');
  });
  $('qa-amount')?.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); submitQuickAdd(); }});
  // list delegation: menu / edit / duplicate / delete / save / cancel
  $('custom-list')?.addEventListener('click', (e)=>{
    const btn=e.target.closest('button[data-act]');
    const row=e.target.closest('.custom-item');
    if(!row) return;
    const id=row.dataset.id;
    const act=btn?.dataset.act;
    if(act==='menu'){ e.stopPropagation(); openMenuId = openMenuId===id ? null : id; renderCustomList(); return; }
    if(act==='edit'){ openMenuId=null; editingId=id; renderCustomList(); const inp=row.querySelector('.edit-name') ?? document.querySelector(`.custom-item[data-id="${id}"] .edit-name`); inp?.focus(); inp?.select(); return; }
    if(act==='duplicate'){
      const src=customExpenses.find(x=>x.id===id);
      if(src){ const idx=customExpenses.findIndex(x=>x.id===id); customExpenses.splice(idx+1, 0, {id:uid(), name:src.name, amount:src.amount}); }
      openMenuId=null; renderCustomList(); updateFixedTotal(); refreshResultsIfShown(); return;
    }
    if(act==='delete'){ deleteCustom(id); return; }
    if(act==='save'){
      const r=document.querySelector(`.custom-item[data-id="${id}"]`);
      const nameEl=r?.querySelector('.edit-name'), amtEl=r?.querySelector('.edit-amt'), errEl=r?.querySelector('.custom-edit-error');
      const name=nameEl.value.trim();
      const digits=amtEl.value.replace(/[^0-9]/g,'');
      const n=digits==='' ? NaN : Number(digits);
      if(!name){ if(errEl){ errEl.textContent='Enter an expense name.'; errEl.classList.remove('hidden'); } nameEl.focus(); return; }
      if(digits==='' || !Number.isFinite(n) || n<=0){ if(errEl){ errEl.textContent='Enter a valid amount greater than 0.'; errEl.classList.remove('hidden'); } amtEl.focus(); return; }
      const item=customExpenses.find(x=>x.id===id);
      if(item){ item.name=name; item.amount=Math.round(n); }
      editingId=null; renderCustomList(); updateFixedTotal(); refreshResultsIfShown(); return;
    }
    if(act==='cancel'){ editingId=null; renderCustomList(); return; }
  });
  $('custom-list')?.addEventListener('keydown', (e)=>{
    if(e.key==='Enter' && e.target.matches('.edit-name')){
      e.preventDefault();
      e.target.closest('.custom-item')?.querySelector('.edit-amt')?.focus();
    }
    if(e.key==='Enter' && e.target.matches('.edit-amt')){
      e.preventDefault();
      e.target.closest('.custom-item')?.querySelector('[data-act="save"]')?.click();
    }
    if(e.key==='Escape' && e.target.closest('.custom-item')?.querySelector('.custom-edit-row')){
      editingId=null; renderCustomList();
    }
    else if(e.key==='Escape' && openMenuId){ openMenuId=null; renderCustomList(); }
  });
  document.addEventListener('click', (e)=>{
    if(openMenuId && !e.target.closest('.custom-menu-wrap')){ openMenuId=null; renderCustomList(); }
  });
  document.addEventListener('keydown', (e)=>{
    if(e.key==='Escape' && openMenuId){ openMenuId=null; renderCustomList(); }
  });
  // digit-only guard for edit amount (delegated, survives re-render)
  $('custom-list')?.addEventListener('input', (e)=>{
    if(e.target.matches('.edit-amt')){
      const cleaned=e.target.value.replace(/[^0-9]/g,'').slice(0,9);
      if(cleaned!==e.target.value) e.target.value=cleaned;
    }
  });

  // Live fixed-total only (no auto result)
  function updateFixedTotal(){
    $('fixed-total').textContent = formatNPR(collectFixed());
  }
  document.addEventListener('input', (e)=>{
    if(e.target.matches('[data-fixed]')) updateFixedTotal();
  });

  function collectFixed(){
    const obj={};
    // predefined fixed costs + validated quick-add customs (array only holds valid adds)
    document.querySelectorAll('#fixed-grid [data-fixed]').forEach(el=> obj[el.dataset.fixed]= el.value);
    let sum = sumFixedCosts(obj);
    for(const c of customExpenses){
      const amt = Number.isFinite(c.amount) && c.amount>0 ? c.amount : 0;
      sum += amt;
    }
    return sum;
  }
  function getBreakdown(){
    const rows=[];
    document.querySelectorAll('#fixed-grid [data-fixed]').forEach(el=>{
      const label = el.closest('.cm-field')?.querySelector('.cm-label')?.textContent?.trim() || el.dataset.fixed;
      const val = Number(String(el.value).replace(/,/g,''))||0;
      if(val>0) rows.push({label, val});
    });
    for(const c of customExpenses){
      const amt = Number.isFinite(c.amount) && c.amount>0 ? c.amount : 0;
      if(amt>0){
        const label = c.name && c.name.trim() ? c.name.trim() : 'Custom expense';
        rows.push({label, val: amt});
      }
    }
    return rows.sort((a,b)=> b.val-a.val);
  }

  function doCalc(){
    const hint=$('calc-hint'); if(hint){ hint.classList.add('hidden'); hint.textContent=''; }
    const sp = $('sp').value, vc=$('vc').value, exp=$('exp').value, target=$('target').value;
    const fc = collectFixed();
    // update fixed total
    $('fixed-total').textContent = formatNPR(fc);
    const vatEnabled=$('vat-toggle').checked;
    // Empty rate = standard 13% (placeholder value); explicit 0 is still allowed.
    const vatRateRaw=$('vat-rate').value.trim();
    const vatRate = vatRateRaw === '' ? 13 : vatRateRaw;

    const r = calcBreakEven({ sellingPrice:sp, variableCost:vc, fixedCosts:fc, expectedSales:exp, targetProfit:target, vatEnabled, vatRate });
    // warnings
    const warnBox=$('res-warn');
    // main numbers
    const units = r.hasValidMargin && Number.isFinite(r.breakEvenUnitsCeiled) ? r.breakEvenUnitsCeiled : null;
    const rev = r.hasValidMargin && Number.isFinite(r.breakEvenRevenueCeiled) ? r.breakEvenRevenueCeiled : null;

    // Always show card after calc? Keep empty hidden if never calculated valid? but show even if warnings
    $('res-empty')?.classList.add('hidden');
    $('res-body')?.classList.remove('hidden');

    if(units==null){
      $('res-units').textContent='—';
      $('res-line').textContent = r.warnings[0] || '—';
    } else {
      $('res-units').textContent = formatInt(units) + ' units';
      $('res-line').textContent = `You need to sell approximately ${formatInt(units)} units each month to cover your current costs.`;
    }
    $('res-rev').textContent = rev!=null ? formatNPR(rev)+' / mo' : '—';
    $('res-cm').textContent = formatNPR(r.contribution);
    $('res-cmr').textContent = r.hasValidMargin ? `(${(r.contributionRatio*100).toFixed(1)}%)` : '';
    $('res-fc').textContent = formatNPR(r.inputs.fixedCosts);

    // profit box
    const profitBox=$('res-profit-box');
    if(!r.inputs.expectedSales){
      profitBox.innerHTML = `<p class="text-[11.5px]" style="color:var(--nk-text-tertiary);">Enter expected monthly sales to see profit / loss.</p>`;
      profitBox.style.background='var(--nk-hover)'; profitBox.style.borderColor='var(--nk-border)';
    } else {
      const isProfit = r.profit >=0;
      profitBox.style.background = isProfit ? 'var(--nk-accent-subtle)' : '#FEF2F2';
      profitBox.style.borderColor = isProfit ? 'var(--nk-border)' : '#FECACA';
      profitBox.innerHTML = `
        <p class="text-[11px] font-bold uppercase tracking-wider" style="color:var(--nk-text-tertiary);">Monthly Profit Estimate</p>
        <div class="text-[11.5px] mt-1 space-y-1 tabular-nums">
          <div class="flex justify-between"><span style="color:var(--nk-text-secondary);">Revenue (${formatInt(r.inputs.expectedSales)} × ${formatNPR(r.inputs.sellingPrice)})</span><span style="color:var(--nk-text);">${formatNPR(r.revenueExpected)}</span></div>
          <div class="flex justify-between"><span style="color:var(--nk-text-secondary);">Variable Costs</span><span style="color:var(--nk-text);">${formatNPR(r.variableExpected)}</span></div>
          <div class="flex justify-between"><span style="color:var(--nk-text-secondary);">Fixed Costs</span><span style="color:var(--nk-text);">${formatNPR(r.inputs.fixedCosts)}</span></div>
          <div class="flex justify-between pt-1 mt-1" style="border-top:1px solid var(--nk-border);"><span style="color:var(--nk-text); font-weight:700;">${isProfit?'Estimated profit':'Estimated loss'}</span><span style="color:${isProfit?'var(--nk-accent)':'#DC2626'}; font-weight:800;">${formatNPR(Math.abs(r.profit))}</span></div>
        </div>`;
    }

    // visualization
    const expVal = r.inputs.expectedSales, be = units || 0;
    const max = Math.max(be*1.4, expVal*1.1, 10);
    const bePct = max>0 ? (be/max)*100 : 0;
    const expPct = max>0 ? (expVal/max)*100 : 0;
    $('vis-fill').style.width = Math.min(100, expPct)+'%';
    $('vis-dot').style.left = `clamp(0px, calc(${Math.min(100, Math.max(0, bePct))}% - 6px), calc(100% - 12px))`;
    $('vis-be').textContent = be? `${formatInt(be)}` : 'Break-even';
    $('vis-exp').textContent = expVal? `${formatInt(expVal)}` : 'Expected';

    // MOS — one line
    const mos=$('res-mos');
    if(r.inputs.expectedSales && units!=null && r.mosUnits>0){
      mos.classList.remove('hidden');
      mos.textContent = `Margin of safety: ${formatInt(r.mosUnits)} units (${r.mosPercent.toFixed(1)}% above break-even)`;
    } else { mos.classList.add('hidden'); }

    // Target — compact
    const tBox=$('res-target');
    if(r.requiredUnitsCeiled!=null){
      tBox.classList.remove('hidden');
      tBox.innerHTML = `<span style="color:var(--nk-text-secondary);">For ${formatNPR(r.inputs.targetProfit)} profit:</span> <strong style="color:var(--nk-text);">sell ${formatInt(r.requiredUnitsCeiled)} units/mo</strong> <span style="color:var(--nk-text-tertiary);">(${formatNPR(r.requiredRevenue)})</span>`;
    } else { tBox.classList.add('hidden'); }

    // Breakdown
    const bd=$('res-breakdown');
    const rows=getBreakdown();
    if(rows.length===0) bd.innerHTML = `<p class="text-[11.5px]" style="color:var(--nk-text-tertiary);">No fixed costs entered yet.</p>`;
    else {
      const total=rows.reduce((s,r)=>s+r.val,0);
      bd.innerHTML = rows.map(row=> `<div class="flex justify-between"><span style="color:var(--nk-text-secondary);">${esc(row.label)}</span><span class="tabular-nums" style="color:var(--nk-text); font-weight:600;">${formatNPR(row.val)}</span></div>`).join('') + `<div class="flex justify-between pt-1 mt-1" style="border-top:1px solid var(--nk-border); font-weight:700;"><span style="color:var(--nk-text);">Total</span><span style="color:var(--nk-text);">${formatNPR(total)}</span></div>`;
    }

    // VAT
    const vatBox=$('res-vat');
    if(r.vat){
      vatBox.classList.remove('hidden');
      vatBox.innerHTML = `<p class="font-semibold" style="color:var(--nk-text);">VAT ${r.vat.rate}% assumption <span style="color:var(--nk-text-tertiary); font-weight:400;">— selling price includes VAT</span></p><div class="mt-1 space-y-1"><div class="flex justify-between"><span>Net price (ex-VAT)</span><span class="tabular-nums" style="font-weight:600; color:var(--nk-text);">${formatNPR(r.vat.netPrice)}</span></div><div class="flex justify-between"><span>Net contribution</span><span class="tabular-nums" style="color:var(--nk-text);">${formatNPR(r.vat.netContribution)} • ${(r.vat.netRatio*100).toFixed(1)}%</span></div><div class="flex justify-between"><span>VAT on break-even revenue</span><span class="tabular-nums">${formatNPR(r.vat.vatAtBe)}</span></div><div class="flex justify-between"><span>Break-even (ex-VAT)</span><span class="tabular-nums">${formatNPR(r.vat.netRevenueAtBe)}</span></div></div><p class="text-[10.5px] mt-2" style="color:var(--nk-text-tertiary);">Optional model — not tax advice. Consult a tax professional.</p>`;
    } else vatBox.classList.add('hidden');

    // warnings
    warnBox.innerHTML = r.warnings.map(w=> `<div class="text-[11px] p-2.5 rounded-lg" style="background:#FEF2F2; border:1px solid #FECACA; color:#991B1B;">${w}</div>`).join('');
    if(r.warnings.length===0) warnBox.innerHTML = `<div class="text-[11px] p-2.5 rounded-lg" style="background:var(--nk-hover); border:1px solid var(--nk-border); color:var(--nk-text-tertiary);">All set — adjust numbers to model different scenarios.</div>`;
  }

  function doReset(){
    ['sp','vc','exp','target','vat-rate'].forEach(id=>{ const el=$(id); if(el){ el.value = ''; }});
    document.querySelectorAll('#fixed-grid [data-fixed]').forEach(el=> el.value='');
    customExpenses.length=0;
    editingId=null; openMenuId=null; lastDeleted=null;
    if($('qa-name')) $('qa-name').value='';
    if($('qa-amount')) $('qa-amount').value='';
    showQuickError('');
    $('quick-add')?.classList.add('hidden');
    const toast=$('undo-toast'); if(toast) toast.classList.remove('show');
    if(undoTimer){ clearTimeout(undoTimer); undoTimer=null; }
    renderCustomList();
    $('vat-toggle').checked=false; $('vat-row').classList.add('hidden');
    $('vat-hint')?.classList.remove('hidden');
    showQuickError('');
    document.querySelectorAll('.biz-chip').forEach(c=> c.classList.remove('chip-active'));
    bizType=null;
    $('fixed-total').textContent = formatNPR(0);
    $('res-body').classList.add('hidden'); $('res-empty').classList.remove('hidden');
    const hint=$('calc-hint'); if(hint){ hint.classList.add('hidden'); hint.textContent=''; }
  }

  $('calc-btn')?.addEventListener('click', doCalc);
  $('reset-btn')?.addEventListener('click', doReset);
  document.addEventListener('keydown', e=>{ if(e.key==='Enter' && e.target.matches('.cm-input, .nk-input')) doCalc(); });
  $('copy-btn')?.addEventListener('click', async()=>{
    const units=$('res-units').textContent, rev=$('res-rev').textContent;
    const text=`Break-Even: ${units} • ${rev}\nFixed: ${$('res-fc').textContent}\n${$('res-profit-box').innerText}\n— SolutionsNepal break-even calculator`;
    try{ await navigator.clipboard.writeText(text); const b=$('copy-btn'); const t=b.textContent; b.textContent='Copied!'; setTimeout(()=> b.textContent=t,1500);}catch{}
  });
  $('print-btn')?.addEventListener('click', ()=> window.print());

  // initial: placeholders only, no auto result
  renderCustomList();
  updateFixedTotal();
  $('res-body')?.classList.add('hidden'); $('res-empty')?.classList.remove('hidden');
</script>

