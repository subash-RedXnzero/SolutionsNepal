<script>
  /* Mini transitions — staggered scroll reveal for homepage sections. */
  function initHpReveals() {
    const targets = document.querySelectorAll(
      '.hp-board-wrap, .hp-section, .hp-cta'
    );
    if (!targets.length || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      targets.forEach((el) => el.classList.add('is-visible'));
      document.querySelectorAll('.hp-reveal-group > *').forEach((el) => el.classList.add('is-visible'));
      return;
    }
    targets.forEach((el) => {
      if (!el.classList.contains('hp-reveal')) el.classList.add('hp-reveal');
    });
    document.querySelectorAll(
      '.hp-pop-grid, .hp-cg-list, .hp-guide-grid, .hp-trust-grid'
    ).forEach((grid) => grid.classList.add('hp-reveal-group'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          entry.target.querySelectorAll(':scope > *').forEach((child) => {
            child.classList.add('is-visible');
          });
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
  initHpReveals();
  document.addEventListener('astro:page-load', initHpReveals);

  /* Hero search — delegates to the global SearchModal (single search logic). */
  let hpSlashBound = false;
  function initHpSlash() {
    if (hpSlashBound) return;
    hpSlashBound = true;
    // "/" opens the global search modal when the user isn't typing.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      if (document.getElementById('search-modal')?.classList.contains('open')) return;
      const t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      e.preventDefault();
      if (typeof window.openSearch === 'function') window.openSearch();
      else document.getElementById('search-modal')?.classList.add('open');
    });
  }
  initHpSlash();
  document.addEventListener('astro:page-load', initHpSlash);
</script>

