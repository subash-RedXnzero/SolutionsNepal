    border-radius: var(--radius-full);
    border: 1px solid var(--hp-border);
    background: var(--hp-card);
    color: var(--hp-text);
    font-size: var(--fs-md);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .hp-hero-ghost:hover { border-color: var(--hp-crimson); color: var(--hp-crimson); transform: translateY(-2px); }
  .hp-quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    margin-top: 22px;
    font-size: var(--fs-sm);
  }
  .hp-quick-label { color: var(--hp-text-3); font-weight: 500; }
  .hp-quick a {
    padding: 6px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--hp-border);
    background: var(--hp-card);
    color: var(--hp-text-2);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .hp-quick a:hover { border-color: var(--hp-crimson); color: var(--hp-crimson); }
  .hp-sr-only {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .hp-hero-stats li + li { border-left: 1px solid var(--hp-border); padding-left: 22px; }
  .npb-src { margin: 10px 4px 0; font-size: var(--fs-xs); line-height: 1.5; color: var(--hp-text-3); }

  /* ═══ NP NEPAL TODAY — market snapshot ═══ */
  .hp-board-wrap {
    background: #FAF9F7;
    border-top: 1px solid var(--hp-border);
    border-bottom: 1px solid var(--hp-border);
    padding: 44px 0;
  }
  :global([data-theme="dark"]) .hp-board-wrap { background: var(--hp-woven); }
  .npb-gold-value, .npb-value, .npb-wx-temp, .hp-hero-stats strong { font-variant-numeric: tabular-nums; }
  .hp-board-eyebrow {
    margin: 0 0 16px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-text-3);
  }
  .npb {
    --npb-bg: #FAF9F7;
    --npb-surface: #FFFFFF;
    --npb-text: #17212B;
    --npb-muted: #5D646C;
    --npb-pos: #0E7A44; /* darkened for 4.5:1 text contrast on tinted badge bg */
    --npb-neg: #B42318; /* darkened for 4.5:1 text contrast on tinted badge bg */
    --npb-border: #EAE7E2;
    max-width: 1200px;
    margin: 0 auto;
    background: var(--npb-surface);
    border: 1px solid var(--npb-border);
    border-radius: 22px;
    box-shadow: 0 24px 48px -28px rgba(23, 33, 43, 0.18), 0 1px 4px rgba(23, 33, 43, 0.04);
    overflow: hidden;
  }
  :global([data-theme="dark"]) .npb {
    --npb-bg: #222222;
    --npb-surface: #1B1B1B;
    --npb-text: #F5F1E8;
    --npb-muted: #9A958B;
    --npb-pos: #4ADE80;
    --npb-neg: #F47272;
    --npb-border: #2E2E2E;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.6);
  }
  .npb-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 22px 14px;
    border-bottom: 1px solid var(--npb-border);
  }
  .npb-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: var(--fs-md);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--npb-text);
  }
  .npb-flag { flex-shrink: 0; }
  .npb-subtitle {
    margin: 2px 0 0 26px;
    font-size: var(--fs-sm);
    color: var(--npb-muted);
    font-family: var(--font-nepali);
  }
  .npb-live {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
    padding-top: 2px;
  }
  .npb-live-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--npb-pos) 10%, transparent);
  }
  .npb-live-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: capitalize;
    color: var(--npb-pos);
  }
  .npb-live-label.offline { color: var(--hp-crimson-dark); }
  .npb-live-time {
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1;
    color: var(--npb-muted);
    white-space: nowrap;
  }
  .npb-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--npb-pos);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--npb-pos) 45%, transparent);
    animation: npb-pulse 2.2s ease-out infinite;
  }
  @keyframes npb-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--npb-pos) 45%, transparent); }
    70% { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .npb-dot { animation: none; }
    .npb-card { transition: none; }
    .npb-card:hover { transform: none; }
    .npb-more span { transition: none; }
  }

  /* ═══ BENTO GRID — gold hero, supporting minis, full-width weather ═══ */
  .npb-bento {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: 14px;
    padding: 18px 22px 4px;
  }
  .npb-card {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: 18px 20px 16px;
    background: #FFFDFB;
    border: 1px solid var(--npb-border);
    border-radius: 20px;
    box-shadow: 0 1px 3px rgba(23, 33, 43, 0.04);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  :global([data-theme="dark"]) .npb-card { background: var(--npb-surface); }
  .npb-card:hover {
    transform: translateY(-3px);
    border-color: #D8D3C9;
    box-shadow: 0 16px 30px -20px rgba(23, 33, 43, 0.28), 0 2px 6px rgba(23, 33, 43, 0.05);
  }
  .npb-card:focus-visible { outline: 2px solid var(--hp-crimson); outline-offset: 2px; }

  /* Gold hero — visual focal point, mostly white with a champagne accent */
  .npb-gold { grid-row: span 2; padding: 22px 24px 18px; }
  .npb-gold-ico {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-right: 8px;
    border-radius: 9px;
    background: #F8EEDC;
    border: 1px solid #F0DFC0;
    color: #A67C1A;
    vertical-align: -6px;
  }
  .npb-gold-ico svg { display: block; }
  .npb-gold-value {
    margin: 2px 0 0;
    font-size: clamp(32px, 3.4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--npb-text);
    overflow-wrap: anywhere;
  }
  .npb-trend { width: 100%; height: 56px; margin-top: 12px; overflow: visible; }
  .npb-trend-line.up { stroke: var(--npb-pos); }
  .npb-trend-line.down { stroke: var(--npb-neg); }
  .npb-trend-line.flat { stroke: var(--npb-muted); }
  .npb-trend-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 8px 0 0;
    font-size: var(--fs-xs);
    color: var(--npb-muted);
  }
  .npb-more {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 600;
    color: var(--hp-crimson);
    white-space: nowrap;
  }
  .npb-more span { transition: transform 0.2s ease; }
  .npb-card:hover .npb-more span { transform: translateX(3px); }

  /* Supporting minis — consistent, smaller than the hero */
  .npb-mini .npb-value { font-size: 24px; }
  .npb-petrol-ico {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-right: 7px;
    border-radius: 8px;
    background: var(--npb-bg);
    border: 1px solid var(--npb-border);
    color: var(--npb-muted);
    vertical-align: -5px;
  }
  .npb-petrol-ico svg { display: block; }
  .npb-petrol { grid-column: span 2; }

  /* Weather — full-width, spacious and lighter */
  .npb-wx {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
  }
  .npb-wx-ico {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--hp-blue) 10%, #fff);
    border: 1px solid var(--npb-border);
    color: var(--npb-muted);
  }
  .npb-wx-ico svg { display: block; width: 22px; height: 22px; }
  .npb-wx-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .npb-wx-temp {
    margin: 0 0 0 auto;
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--npb-text);
    flex-shrink: 0;
  }
  .npb-wx-hilo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: var(--fs-sm);
    color: var(--npb-muted);
    white-space: nowrap;
  }
  .npb-label {
    margin: 0 0 3px;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--npb-muted);
  }
  .npb-value {
    margin: 0;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--npb-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .npb-unit {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--npb-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .npb-chg {
    margin: 2px 0 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .npb-chg.up, .npb-chg.down {
    display: inline-flex; align-items: center; align-self: flex-start;
    padding: 2px 9px; border-radius: 999px;
  }
  .npb-chg.up { color: var(--npb-pos); background: color-mix(in srgb, var(--npb-pos) 12%, transparent); }
  .npb-chg.down { color: var(--npb-neg); background: color-mix(in srgb, var(--npb-neg) 12%, transparent); }
  .npb-chg.flat { color: var(--npb-muted); font-weight: 500; }

  .npb-strip {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0;
    min-height: 40px;
    margin-top: 14px;
    padding: 8px 22px;
    border-top: 1px solid var(--npb-border);
    background: var(--npb-bg);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .npb-strip::-webkit-scrollbar { display: none; }
  .npb-strip-item {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 4px 14px;
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .npb-strip-item:first-child { padding-left: 0; }
  .npb-strip-item + .npb-strip-item { border-left: 1px solid var(--npb-border); }
  .npb-strip-item:hover .npb-strip-label { color: var(--npb-text); }
  .npb-strip-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--npb-muted);
    transition: color 0.15s ease;
  }
  .npb-strip-val {
    font-weight: 600;
    color: var(--npb-text);
    font-family: var(--font-nepali);
  }
  .npb-strip-unit { font-size: var(--fs-xs); color: var(--npb-muted); }
  .npb-strip-chg { font-size: var(--fs-sm); font-weight: 600; }
  .npb-strip-chg.up { color: var(--npb-pos); }
  .npb-strip-chg.down { color: var(--npb-neg); }
  .npb-strip-chg.flat { color: var(--npb-muted); }

  /* ═══ SECTION SCAFFOLD ═══ */
  .hp-section { background: var(--hp-bg); padding: 54px 0; }
  .hp-section-tinted { background: var(--hp-woven); border-top: 1px solid var(--hp-border); border-bottom: 1px solid var(--hp-border); }
  .hp-section-roomy { padding: 64px 0 68px; }
  .hp-sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 36px;
  }
  .hp-sec-title {
    font-size: var(--fs-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--hp-text);
    margin: 0;
  }
  .hp-sec-link {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--hp-red);
    text-decoration: none;
    white-space: nowrap;
  }
  .hp-sec-link:hover { color: var(--hp-crimson-dark); }

  /* ═══ POPULAR TOOL CARDS (large, horizontal) ═══ */
  .hp-pop-grid {
    display: grid;
    grid-template-columns: 1.12fr 1fr 1fr;
    grid-auto-flow: dense;
    gap: 18px;
  }
  .hp-pop-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    background: var(--hp-card);
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease;
  }
  /* Left edge penna (vertical gold stripe) — Dhaka topi motif */
  .hp-pop-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 3.5px;
    border-radius: var(--radius-full);
    background: var(--hp-crimson);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .hp-pop-card:hover {
    transform: translateY(-3px);
    border-color: var(--hp-crimson);
    box-shadow: 0 18px 38px -18px rgba(120, 84, 40, 0.30);
  }
  .hp-pop-card:hover::before { opacity: 1; }
  /* Bento lead card: tall feature + pinned action */
  .hp-pop-card.is-tall {
    grid-row: span 2;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    background: var(--hp-woven);
  }
  .hp-pop-card.is-tall .hp-pop-icon { width: 72px; height: 72px; }
  .hp-pop-card.is-tall .hp-pop-svg { width: 34px; height: 34px; }
  .hp-pop-card.is-tall .hp-pop-desc { -webkit-line-clamp: unset; }
  .hp-pop-card.is-tall .hp-pop-arrow { display: none; }
  .hp-pop-open {
    margin-top: auto;
    padding-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--hp-crimson);
  }
  .hp-pop-card.is-tall:hover .hp-pop-open span:last-child { transform: translateX(3px); }
  .hp-pop-open span:last-child { transition: transform 0.2s ease; }
  .hp-pop-card.is-wide { grid-column: 1 / -1; padding: 18px 24px; }
  /* Pressed feedback */
  .hp-hero-cta:active, .hp-hero-ghost:active, .hp-quick a:active,
  .hp-pop-card:active, .hp-chip:active { transform: scale(0.98); }
  .hp-pop-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 16px;
    background: color-mix(in srgb, var(--hp-crimson) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--hp-crimson) 22%, var(--hp-border));
    color: var(--hp-crimson);
  }
  .hp-pop-svg { width: 30px; height: 30px; }
  .hp-pop-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
  .hp-pop-name {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hp-text);
    line-height: 1.28;
  }
  .hp-pop-desc {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--hp-text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-pop-arrow {
    font-size: var(--fs-lg);
    color: var(--hp-text-3);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .hp-pop-card:hover .hp-pop-arrow { transform: translateX(3px); color: var(--hp-red); }

  /* ═══ CATEGORY DISCOVERY — editorial, borderless ═══ */
  .hp-cg-head { text-align: center; margin-bottom: 36px; }
  .hp-cg-head .hp-sec-title { letter-spacing: -0.028em; }
  .hp-cg-sub {
    margin: 10px 0 0;
    font-size: var(--fs-md);
    color: var(--hp-text-2);
  }
  /* ═══ WHAT WE DO — linked category rows ═══ */
  .hp-cg-head--left {
    text-align: left;
    margin-bottom: 12px;
  }
  .hp-cg-list {
    margin: 0;
    border-top: 1px solid var(--hp-border);
  }
  .hp-cg-row {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--hp-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  a.hp-cg-row:hover { background: color-mix(in srgb, var(--hp-crimson) 4%, transparent); }
  a.hp-cg-row:hover .hp-cg-name { color: var(--hp-crimson); }
  a.hp-cg-row:hover .hp-cg-arrow { transform: translateX(4px); color: var(--hp-crimson); }
  a.hp-cg-row:focus-visible { outline: 2px solid var(--hp-crimson); outline-offset: -2px; }
  .hp-cg-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: var(--hp-crimson);
  }
  .hp-cg-svg { width: 22px; height: 22px; }
  .hp-cg-text {
    display: flex;
    flex: 1;
    align-items: baseline;
    gap: 8px 28px;
    min-width: 0;
  }
  .hp-cg-title {
    flex: 0 0 280px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hp-cg-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--hp-text-3);
    font-variant-numeric: tabular-nums;
  }
  .hp-cg-name {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--hp-text);
  }
  .hp-cg-count {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 9px;
    border-radius: var(--radius-full);
    border: 1px solid var(--hp-border);
    background: var(--hp-woven);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--hp-text-2);
    vertical-align: 2px;
    white-space: nowrap;
  }
  .hp-cg-arrow {
    flex-shrink: 0;
    margin-left: auto;
    align-self: center;
    font-size: 18px;
    color: var(--hp-text-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .hp-cg-desc {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--hp-text-2);
  }

  /* ═══ EXPLORE ALL TOOLS ═══ */
  .hp-explore {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1040px;
  }
  .hp-explore-row {
    display: flex;
    align-items: baseline;
    gap: 24px;
  }
  .hp-explore-group {
    flex-shrink: 0;
    width: 180px;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--hp-text);
    text-decoration: none;
    letter-spacing: -0.015em;
  }
  .hp-explore-group:hover { color: var(--hp-red); }
  .hp-explore-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hp-chip {
    padding: 9px 18px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--hp-crimson) 32%, var(--hp-border));
    background: color-mix(in srgb, var(--hp-crimson) 7%, var(--hp-card));
    color: var(--hp-text-2);
    font-size: var(--fs-body);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .hp-chip:hover {
    border-color: var(--hp-red);
    color: var(--hp-red);
    background: color-mix(in srgb, var(--hp-red) 5%, var(--hp-card));
  }

  /* ═══ NEW & UPDATED — borderless editorial changelog ═══ */
  .hp-section-tight { padding: 56px 0; }
  .hp-upd-list {
    max-width: 980px;
    border-top: 1px solid var(--hp-border);
  }
  .hp-upd-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 10px;
    border-bottom: 1px solid var(--hp-border);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .hp-upd-row:hover { background: color-mix(in srgb, var(--hp-crimson) 4%, transparent); }
  .hp-upd-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    flex-shrink: 0;
    width: 96px;
  }
  .hp-upd-badge {
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-full);
  }
  .hp-upd-badge.is-new { background: #B42318; color: #fff; } /* 6.57:1, matches CTA fix */
  .hp-upd-badge.is-upd {
    border: 1px solid var(--hp-border);
    color: var(--hp-text-2);
  }
  .hp-upd-date { font-size: var(--fs-sm); color: var(--hp-text-3); white-space: nowrap; }

  /* ═══ GUIDES — rich reading cards ═══ */
  .hp-guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;
    gap: 18px;
  }
  .hp-guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 24px 22px;
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-card);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease;
  }
  .hp-guide-card:hover {
    transform: translateY(-3px);
    border-color: var(--hp-crimson);
    box-shadow: var(--shadow-md);
  }
  .hp-guide-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .hp-guide-badge {
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--hp-crimson) 10%, transparent);
    color: var(--hp-crimson);
  }
  .hp-guide-date { font-size: var(--fs-xs); color: var(--hp-text-3); white-space: nowrap; }
  .hp-guide-title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--hp-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-guide-desc {
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--hp-text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-guide-more {
    margin-top: auto;
    padding-top: 6px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--hp-crimson);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hp-guide-more span { transition: transform 0.2s ease; }
  .hp-guide-card:hover .hp-guide-more span { transform: translateX(4px); }
  @media (max-width: 900px) { .hp-guide-grid { grid-template-columns: 1fr; } }
  .hp-guide-thumb {
    display: block;
    overflow: hidden;
    margin: -24px -24px 0;
    aspect-ratio: 16 / 10;
    background: var(--hp-woven);
  }
  .hp-guide-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .hp-guide-card:hover .hp-guide-thumb img { transform: scale(1.04); }
  .hp-guide-main { display: flex; flex-direction: column; gap: 10px; flex: 1; min-width: 0; }
  .hp-guide-card.is-lead { grid-column: 1 / -1; flex-direction: row; align-items: stretch; gap: 0; padding: 0; }
  .hp-guide-card.is-lead .hp-guide-thumb { margin: 0; aspect-ratio: auto; flex: 0 0 42%; min-height: 280px; }
  .hp-guide-card.is-lead .hp-guide-main { padding: 30px 32px; }
  .hp-guide-card.is-lead .hp-guide-title { font-size: 24px; -webkit-line-clamp: 2; }
  @media (max-width: 900px) {
    .hp-guide-card.is-lead { flex-direction: column; align-items: stretch; }
    .hp-guide-card.is-lead .hp-guide-thumb { flex: none; width: 100%; aspect-ratio: 16 / 9; min-height: 0; }
    .hp-guide-card.is-lead .hp-guide-main { padding: 20px 22px 22px; }
    .hp-guide-card.is-lead .hp-guide-title { font-size: 20px; }
  }
  .hp-upd-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }
  .hp-upd-name {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--hp-text);
    line-height: 1.35;
  }
  .hp-upd-row:hover .hp-upd-name { color: var(--hp-crimson); }
  .hp-upd-desc { font-size: var(--fs-body); line-height: 1.55; color: var(--hp-text-2); }
  .hp-upd-arrow {
    flex-shrink: 0;
    font-size: var(--fs-lg);
    color: var(--hp-text-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .hp-upd-row:hover .hp-upd-arrow { transform: translateX(4px); color: var(--hp-crimson); }

  /* ═══ TRUST + FAQ — borderless ═══ */
  .hp-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 20px;
    max-width: 1100px;
    margin: 0 auto 44px;
  }
  .hp-trust-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 10px 14px;
  }
  .hp-trust-tick {
    width: 42px;
    height: 42px;
    padding: 10px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--hp-green) 13%, transparent);
    color: var(--hp-green);
    margin-bottom: 12px;
  }
  .hp-trust-name {
    margin: 0 0 6px;
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--hp-text);
  }
  .hp-trust-desc { margin: 0; font-size: var(--fs-sm); line-height: 1.55; color: var(--hp-text-2); }
  .hp-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }
  .hp-faq-side {
    position: sticky;
    top: 24px;
    padding: 8px 0;
  }
  .hp-faq-title {
    margin: 0 0 16px;
    font-size: clamp(32px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--hp-text);
    text-wrap: balance;
  }
  .hp-faq-more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--hp-crimson);
    text-decoration: none;
  }
  .hp-faq-more-link span { transition: transform 0.2s ease; }
  .hp-faq-more-link:hover span { transform: translateX(3px); }
  .hp-faq-sub { margin: 0; font-size: var(--fs-md); line-height: 1.55; color: var(--hp-text-2); }
  .hp-faq { min-width: 0; }
  .hp-faq-item { border-bottom: 1px solid var(--hp-border); }
  .hp-faq-item:first-child { border-top: 1px solid var(--hp-border); }
  .hp-faq-q {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--hp-text);
    cursor: pointer;
    list-style: none;
  }
  .hp-faq-q::-webkit-details-marker { display: none; }
  .hp-faq-q::after {
    content: '+';
    flex-shrink: 0;
    margin-left: auto;
    font-size: 19px;
    font-weight: 400;
    line-height: 1;
    color: var(--hp-text-3);
  }
  .hp-faq-item[open] .hp-faq-q::after { content: '\2212'; color: var(--hp-text); }
  .hp-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .hp-faq-item[open] .hp-faq-a { grid-template-rows: 1fr; }
  .hp-faq-a > p {
    overflow: hidden;
    min-height: 0;
    margin: 0;
    padding: 0;
    font-size: var(--fs-body);
    line-height: 1.75;
    color: var(--hp-text-2);
    max-width: 62ch;
  }
  .hp-faq-item[open] .hp-faq-a > p { padding-bottom: 24px; }
  @media (prefers-reduced-motion: reduce) {
    .hp-faq-a { transition: none; }
    .hp-faq-q, .hp-faq-q::after { transition: none; }
  }

  /* ═══ FINAL CTA — quiet woven band ═══ */
  .hp-cta {
    position: relative;
    background: var(--hp-woven);
    border-top: 1px solid var(--hp-border);
    border-bottom: 1px solid var(--hp-border);
    padding: 72px 0;
    overflow: hidden;
  }
  .hp-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hp-cta-eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--hp-crimson);
  }
  .hp-cta-flag {
    display: block;
    margin-bottom: 20px;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.12));
  }
  .hp-cta-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--hp-text);
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .hp-cta-sub {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--hp-text-2);
    margin: 0 0 28px;
    max-width: 520px;
  }
  .hp-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    border-radius: var(--radius-full);
    /* Fixed dark red (not var): white text needs 4.5:1 — brand #E62B1E is 4.44 */
    background: #B42318;
    color: #fff;
    font-size: var(--fs-md);
    font-weight: 600;
    font-family: var(--font-sans);
    text-decoration: none;
    box-shadow: 0 14px 30px -14px color-mix(in srgb, var(--hp-crimson) 55%, transparent);
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.15s ease;
  }
  .hp-cta-btn:hover {
    transform: translateY(-2px);
    background: #8F1B13;
    box-shadow: 0 18px 36px -14px color-mix(in srgb, var(--hp-crimson) 60%, transparent);
  }
  .hp-cta-btn:active { transform: translateY(0); }
  .hp-cta-btn span { transition: transform 0.2s ease; }
  .hp-cta-btn:hover span { transform: translateX(3px); }
  .hp-cta-count {
    margin: 22px 0 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--hp-text-3);
  }

  /* MINI TRANSITIONS — scroll reveal, hover physics, image scale */
  .hp-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rv-d, 0ms);
    will-change: opacity, transform;
  }
  .hp-reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .hp-pop-grid.hp-reveal-group > *:nth-child(2) { --rv-d: 70ms; }
  .hp-pop-grid.hp-reveal-group > *:nth-child(3) { --rv-d: 140ms; }
  .hp-pop-grid.hp-reveal-group > *:nth-child(4) { --rv-d: 210ms; }
  .hp-pop-grid.hp-reveal-group > *:nth-child(5) { --rv-d: 280ms; }
  .hp-pop-grid.hp-reveal-group > *:nth-child(6) { --rv-d: 350ms; }
  .hp-cg-list.hp-reveal-group > *:nth-child(2) { --rv-d: 80ms; }
  .hp-cg-list.hp-reveal-group > *:nth-child(3) { --rv-d: 160ms; }
  .hp-cg-list.hp-reveal-group > *:nth-child(4) { --rv-d: 120ms; }
  .hp-cg-list.hp-reveal-group > *:nth-child(5) { --rv-d: 200ms; }
  .hp-cg-list.hp-reveal-group > *:nth-child(6) { --rv-d: 280ms; }
  .hp-guide-grid.hp-reveal-group > *:nth-child(2) { --rv-d: 90ms; }
  .hp-guide-grid.hp-reveal-group > *:nth-child(3) { --rv-d: 180ms; }
  .hp-guide-grid.hp-reveal-group > *:nth-child(4) { --rv-d: 270ms; }
  .hp-trust-grid.hp-reveal-group > *:nth-child(2) { --rv-d: 80ms; }
  .hp-trust-grid.hp-reveal-group > *:nth-child(3) { --rv-d: 160ms; }
  .hp-trust-grid.hp-reveal-group > *:nth-child(4) { --rv-d: 240ms; }
  .hp-pop-card,
  .hp-guide-card,
  .hp-chip,
  .hp-quick a {
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      box-shadow 0.35s ease,
      background-color 0.25s ease,
      color 0.2s ease;
  }
  .hp-guide-thumb {
    overflow: hidden;
  }
  .hp-guide-thumb img {
    transform: scale(0.985);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hp-guide-card:hover .hp-guide-thumb img {
    transform: scale(1.045);
  }
  .hp-hero-cta,
  .hp-hero-ghost,
  .hp-cta-btn {
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .hp-guide-thumb img {
      transform: none;
      transition: none;
    }
  }

  /* ═══ RESPONSIVE ═══
     Tiers: ≥1024 desktop · 768–1023 tablet · <768 mobile · <480 small mobile.
     Smaller screens reflow (grids collapse, rows become carousels), not shrink. */

  /* ── Desktop-large (≤1440px): cap content width tighter ── */
  @media (max-width: 1440px) {
    .hp-container { max-width: 1240px; }
  }

  /* ── Tablet (≤1023px): gold stays prominent, minis wrap below ── */
  @media (max-width: 1023px) {
    .hp-container { padding: 0 28px; }
    .hp-section { padding: 60px 0; }
    .hp-sec-head { margin-bottom: 26px; }
    /* Nepal Today bento: hero spans full width, three minis share a row */
    .npb-bento { grid-template-columns: repeat(3, 1fr); }
    .npb-gold { grid-column: 1 / -1; grid-row: auto; }
    .npb-petrol { grid-column: auto; }
    .hp-pop-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .hp-pop-card { padding: 22px 24px; gap: 16px; }
    .hp-pop-icon { width: 54px; height: 54px; font-size: var(--fs-value); border-radius: var(--radius-xl); }
    .hp-cg-title { flex-basis: 240px; }
    .hp-cg-head { margin-bottom: 30px; }
    .hp-explore { max-width: 100%; }
    .hp-explore-row { gap: 20px; }
    .hp-explore-group { width: 150px; }
  }

  /* ── Mobile (<768px): genuine reflow — one column, carousels, 44px targets ── */
  @media (max-width: 767px) {
    .hp-container { padding: 0 20px; }
    .hp-section { padding: 36px 0; }
    .hp-sec-head { margin-bottom: 18px; }

    /* Mobile reading order: tools first, proof later.
       DOM stays the same (screen readers, SEO); only visual order changes. */
    .hp { display: flex; flex-direction: column; }
    .hp-hero { order: 0; }
    .hp-section[aria-label="Popular tools"] { order: 1; }
    .hp-section[aria-label="Browse by category"] { order: 2; }
    .hp-section[aria-label="Guides and explainers"] { order: 3; }
    .hp-section[aria-label="New and updated tools"] { order: 4; }
    .hp-section[aria-label="Why trust SolutionsNepal"] { order: 5; }
    .hp-section[aria-label="Frequently asked questions"] { order: 6; }
    .hp-cta { order: 7; }

    /* Hero */
    .hp-hero { padding: 32px 0 24px; }
    .hp-hero-grid { gap: 24px; }
    .hp-hero-ghost { display: none; }
    .hp-title { font-size: var(--fs-hero-m); margin-bottom: 12px; }
    .hp-sub-strong { font-size: var(--fs-md); margin-bottom: 8px; }
    .hp-sub { font-size: var(--fs-body); }
    .hp-hero-cta { margin-top: 22px; min-height: 46px; padding: 12px 26px; font-size: var(--fs-body); }
    .hp-hero-trust { margin-top: 14px; font-size: var(--fs-sm); }

    /* Nepal Today bento on phones: gold first, silver + USD side by
       side, then petrol, weather and the secondary strip — stacked,
       never squeezed into tiny columns. */
    .hp-board-wrap { padding: 28px 0; }
    .hp-board-eyebrow { margin-bottom: 12px; }
    .npb-bento { grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px 14px 2px; }
    .npb-card { padding: 16px 16px 14px; border-radius: 18px; }
    .npb-gold { grid-column: 1 / -1; }
    .npb-gold-value { font-size: 34px; }
    .npb-mini .npb-value { font-size: 20px; }
    .npb-petrol { grid-column: 1 / -1; }
    .npb-wx { grid-column: 1 / -1; flex-wrap: wrap; row-gap: 8px; }
    .npb-wx-temp { font-size: 32px; }
    .npb-wx-hilo { flex-basis: 100%; }
    .npb-strip { margin-top: 10px; padding: 8px 14px; }
    .hp-today-more { display: none; }

    /* New & updated: comfortable stacked rows */
    .hp-section-tight { padding: 32px 0; }
    .hp-upd-list { max-width: 100%; }
    .hp-upd-row { gap: 14px; padding: 15px 4px; }
    .hp-upd-meta { width: 78px; }
    .hp-upd-name { font-size: var(--fs-md); }
    .hp-upd-desc { font-size: var(--fs-sm); }

    /* Trust: 2-up, borderless */
    .hp-trust-grid { grid-template-columns: repeat(2, 1fr); gap: 16px 12px; margin-bottom: 28px; }
    .hp-trust-card { padding: 6px 8px; }

    /* FAQ: stacked, side header on top */
    .hp-faq-grid { grid-template-columns: 1fr; gap: 28px; }
    .hp-faq-side { position: static; }
    .hp-faq-title { font-size: 30px; }
    .hp-faq-q { padding: 18px 0; }
    .hp-faq-item[open] .hp-faq-a > p { padding-bottom: 20px; }

    /* Popular tools: compact uniform rows — icon + name + arrow.
       Descriptions are hidden on phones so 6 tools scan like a list. */
    .hp-pop-grid { grid-template-columns: 1fr; gap: 8px; }
    .hp-pop-card { padding: 12px 16px; gap: 12px; min-height: 58px; }
    .hp-pop-card.is-tall { flex-direction: row; align-items: center; gap: 12px; }
    .hp-pop-card.is-tall .hp-pop-icon { width: 42px; height: 42px; }
    .hp-pop-card.is-tall .hp-pop-svg { width: 22px; height: 22px; }
    .hp-pop-card.is-wide { padding: 12px 16px; }
    .hp-pop-open { display: none; }
    .hp-pop-icon { width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0; }
    .hp-pop-svg { width: 22px; height: 22px; }
    .hp-pop-name { font-size: var(--fs-body); }
    .hp-pop-desc { display: none; }
    .hp-pop-arrow { font-size: var(--fs-md); }

    /* Guides: text-only cards on phones — 4 large photos cost
       a lot of scroll and mobile data for little meaning. */
    .hp-guide-thumb { display: none; }
    .hp-guide-grid { gap: 10px; }
    .hp-guide-card { padding: 18px; gap: 8px; }
    .hp-guide-card.is-lead .hp-guide-main { padding: 20px; }
    .hp-guide-title { font-size: var(--fs-md); }
    .hp-guide-desc { font-size: var(--fs-sm); }

    /* What-we-do rows: stack naturally, same minimalist style */
    .hp-cg-head--left { margin-bottom: 20px; }
    .hp-cg-row { gap: 12px; padding: 14px 2px; }
    .hp-cg-icon { width: 32px; height: 32px; }
    .hp-cg-svg { width: 20px; height: 20px; }
    .hp-cg-text { flex-direction: column; gap: 4px; }
    .hp-cg-title { flex: none; flex-direction: row; align-items: baseline; gap: 10px; }
    .hp-cg-name { font-size: var(--fs-md); }
    .hp-cg-desc { font-size: var(--fs-body); }

    /* CTA: shorter band, near full-width button */
    .hp-cta { padding: 44px 0; }
    .hp-cta-flag { width: 36px; height: 36px; }
    .hp-cta-title { font-size: var(--fs-display); }
    .hp-cta-sub { font-size: var(--fs-body); }
    .hp-cta-btn {
      display: flex;
      width: 100%;
      max-width: 340px;
      justify-content: center;
      min-height: 48px;
      margin-top: 22px;
    }
    .hp-cta-count { margin-top: 16px; font-size: var(--fs-sm); }
  }

  /* ── Small mobile (<480px): touch-first sizing ── */
  @media (max-width: 479px) {
    .hp-container { padding: 0 16px; }
    .hp-hero { padding: 28px 0 20px; }
    .hp-section { padding: 32px 0; }
    .hp-title { font-size: var(--fs-hero-m); }
    .npb-bento { padding: 12px 12px 2px; }
    .npb-mini .npb-value { font-size: 19px; }
    .hp-pop-card { padding: 14px; min-height: 72px; }
    .hp-cg-desc { font-size: var(--fs-sm); }
    .hp-cta { padding: 48px 0; }
    .hp-chip { padding: 10px 14px; font-size: var(--fs-sm); }
  }

  /* ── Tiny phones (≤375px) ── */
  @media (max-width: 375px) {
    .hp-title { font-size: var(--fs-hero-m); }
    .hp-sub-strong { font-size: var(--fs-md); }
    .hp-sub { font-size: var(--fs-body); }
    .npb-gold-value { font-size: 30px; }
    .hp-cta-title { font-size: var(--fs-display); }
