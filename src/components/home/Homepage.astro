// ─── NP NEPAL TODAY — market snapshot (server-computed, no client JS) ───
import { getTodayInfo, BS_MONTHS_NP } from '../../lib/nepal/nepal-time.js';
import { getGoldPriceAsync } from '../../lib/nepal/gold-price.js';
import { getSilverPriceAsync } from '../../lib/nepal/silver-price.js';
import { getFuelPriceAsync } from '../../lib/nepal/fuel-price.js';
import { getHomepageCurrenciesAsync } from '../../lib/nepal/forex.js';
import { boardUpdatedLabel, freshness } from '../../lib/nepal/providers/live-snapshot.js';
import { npb as FLAG_PATHS } from '../../lib/utils/nepal-flag.js';
import { getWeather } from '../../lib/nepal/weather.js';
import { formatNumber, toDevanagari } from '../../lib/utils/npr.js';

const today = getTodayInfo();
const bsShort = `${toDevanagari(String(today.bsDay))} ${BS_MONTHS_NP[today.bsMonth - 1]}`;
const bsFull = `${toDevanagari(String(today.bsYear))} ${bsShort}`;
// Parallel fetches — these are independent snapshot reads, no reason to await serially.
const [gold, silver, fuel, currencies] = await Promise.all([
  getGoldPriceAsync(),
  getSilverPriceAsync(),
  getFuelPriceAsync('kathmandu'),
  getHomepageCurrenciesAsync(),
]);
const usd = currencies.find(c => c.iso3 === 'USD');
const eur = currencies.find(c => c.iso3 === 'EUR');
const inr = currencies.find(c => c.iso3 === 'INR');
// Pill is green only when every market section is freshly fetched.
// Silver shares the gold section; 'stale'/'mock' sections flip it to Offline.
const isLive = ['forex', 'gold', 'fuel'].every((k) => freshness(k) === 'live');
const boardUpdated = boardUpdatedLabel();
const ktmWeather = getWeather('kathmandu');

function badge(dir, text) {
  const up = dir === 'up';
  const flat = dir === 'flat';
  return { arrow: flat ? '→' : up ? '↑' : '↓', text, cls: flat ? 'flat' : up ? 'up' : 'down' };
}

const gold24k = gold.fineGold.pricePerTola;

// Minimal stroke weather glyphs (no emoji in the data board)
const WX_SVG = {
  clear: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  partly: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"/><path d="M8 2.5V4M2.5 8H4M4.3 4.3l1 1M11.7 4.3l-1 1"/><path d="M9.5 20h8a3.5 3.5 0 0 0 .6-6.95A5 5 0 0 0 8.7 14.5 2.8 2.8 0 0 0 9.5 20z"/></svg>',
  cloudy: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 .9-8.9A6 6 0 0 0 6.7 11.6 3.8 3.8 0 0 0 7.5 19h10z"/></svg>',
  rain: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 14a4.5 4.5 0 0 0 .9-8.9A6 6 0 0 0 6.7 6.6 3.8 3.8 0 0 0 7.5 14h10z"/><path d="M8 17v2.5M12 17v2.5M16 17v2.5"/></svg>',
};

// Honest 2-point trend (yesterday → today) from snapshot values only.
// The snapshot carries no multi-day history, so the hero shows a straight
// line between the two real points — never fabricated volatility.
function trendD(yesterday, today, w = 220, h = 56, pad = 10) {
  const min = Math.min(yesterday, today);
  const max = Math.max(yesterday, today);
  const range = max - min || 1;
  const y = (v) => (h - pad - ((v - min) / range) * (h - pad * 2)).toFixed(1);
  return `M0,${y(yesterday)} L${w},${y(today)}`;
}

const goldTrend = trendD(gold.yesterday.pricePerTola, gold24k);
const goldBadge = badge(gold.change.direction, `${gold.change.percent.toFixed(1)}% today`);
const silverBadge = badge(silver.change.direction, `${silver.change.percent.toFixed(1)}% today`);
const petrolBadge = fuel.petrol.change.direction === 'none' ? null : badge(fuel.petrol.change.direction, `Rs ${formatNumber(Math.abs(fuel.petrol.change.amount))}/L`);
const wxIcon = WX_SVG[ktmWeather.today.cond.k] || WX_SVG.rain;

const STRIP = [
  {
    label: 'EUR/NPR',
    text: `Rs ${formatNumber(eur?.sellPerUnit ?? 0)}`,
    badge: null,
    href: '/foreign-exchange-nepal',
  },
  {
    label: 'INR/NPR',
    text: inr ? `Rs ${formatNumber(inr.sell)}` : 'N/A',
    unit: '100 INR',
    badge: null,
    href: '/foreign-exchange-nepal',
  },
  {
    label: 'DIESEL',
    text: `Rs ${formatNumber(fuel.diesel.price)}/L`,
    badge: null,
    href: '/nepal/fuel-price-nepal',
  },
  {
    label: 'LPG',
    text: `Rs ${formatNumber(fuel.lpg.price)}`,
    badge: null,
    href: '/nepal/fuel-price-nepal',
  },
  {
    label: 'DATE',
    text: bsShort,
    badge: null,
    href: '/nepal/calendar',
  },
];
