const HP_FAQS = [
  {
    q: 'What is SolutionsNepal?',
    a: 'SolutionsNepal is a free collection of calculators, converters, and utility tools built for everyday life in Nepal. It includes salary calculators, date converters, gold weight converters, vehicle tax calculators, and more. All calculations run in your browser — no data is sent to any server.',
  },
