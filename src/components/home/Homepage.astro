<style>
  /* SHAPE + LAYER SCALES (one system): pills = buttons/chips/badges only;
     cards = 16-24px; inputs = 8px (global). Layers: page < grain 60 < nav 100 < search modal 200. */
  /* ═══ NEPAL PALETTE (spec) ═══ */
  .hp {
    /* Colour tokens alias the global --nk-* system (single source of truth) */
    --hp-bg: var(--nk-bg);
    --hp-card: var(--nk-surface);
    --hp-text: var(--nk-text);
    --hp-text-2: #45413C;
    --hp-text-3: #5F5B55;
    --hp-border: var(--nk-border);
    --hp-woven: #F6F3EE;            /* subtle band tint derived from border */
    --hp-crimson: var(--nk-accent);         /* primary — Nepal-inspired red */
    --hp-crimson-dark: var(--nk-accent-hover); /* primary hover */
    --hp-red: var(--nk-accent);
    --hp-gold: #D9A441;
    --hp-green: var(--color-success);       /* positive prices/results */
    --hp-blue: #1F5D8B;             /* Himalaya sky (accents only) */
    --hp-radius: 20px;
  }
  /* Dark mode: bg/text/border/accent inherit the --nk-* dark tokens automatically;
     only the tuned surfaces and button reds keep homepage-specific values. */
  :global([data-theme="dark"]) .hp {
    --hp-woven: #262420;
    --hp-crimson: #F24A38;          /* band/button red tuned for dark surfaces */
    --hp-crimson-dark: #D32F20;     /* hover red on white buttons */
    --hp-red: #F24A38;
    --hp-gold: #E8BC5C;
    --hp-green: #4ADE80;
    --hp-blue: #7FB3D8;
  }

  .hp-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  /* Overflow + wrapping safety nets (sitewide guard for the homepage) */
  .hp {
    overflow-x: clip;
  }
  .hp :is(h1, h2, h3, p, a, span) { overflow-wrap: break-word; }
  .hp img, .hp svg, .hp video { max-width: 100%; height: auto; }
  .hp :is(button, a, input, select) { touch-action: manipulation; }

  /* ═══ HERO ═══ */
  .hp-hero {
    position: relative;
    background:
      radial-gradient(1200px 420px at 28% -140px, color-mix(in srgb, var(--hp-crimson) 10%, transparent), transparent 70%),
      var(--hp-bg);
    padding: 64px 0 50px;
    text-align: left;
    overflow: hidden;
  }
  .hp-container { position: relative; }
  .hp-hero-grid { display: grid; grid-template-columns: 7fr 5fr; gap: 56px; align-items: center; }
  .hp-hero-copy { min-width: 0; }
  /* One authored entrance: staggered rise establishes reading order on first paint */
  .hp-hero-copy > * { animation: hp-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hp-hero-copy > :nth-child(2) { animation-delay: 0.06s; }
  .hp-hero-copy > :nth-child(3) { animation-delay: 0.12s; }
  .hp-hero-copy > :nth-child(4) { animation-delay: 0.16s; }
  .hp-hero-copy > :nth-child(5) { animation-delay: 0.22s; }
  .hp-hero-copy > :nth-child(6) { animation-delay: 0.28s; }
  @keyframes hp-rise { from { opacity: 0; transform: translateY(14px); } }
  .hp-today {
    border: 1px solid var(--hp-border);
    border-radius: var(--hp-radius);
    background: var(--hp-card);
    padding: 16px;
    box-shadow: var(--shadow-md);
    animation: hp-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }
  .hp-today-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hp-border);
  }
  .hp-today-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--hp-text);
  }
  .hp-today-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--hp-green);
    animation: npb-pulse 2.2s ease-out infinite;
  }
  .hp-today-date { margin: 0; font-size: 12px; color: var(--hp-text-2); white-space: nowrap; }
  .hp-today-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 0; }
  .hp-mini { border: 1px solid var(--hp-border); border-radius: 14px; padding: 14px; min-width: 0; }
  .hp-mini-wx { background: color-mix(in srgb, var(--hp-blue) 10%, var(--hp-card)); }
  .hp-mini-cal { background: color-mix(in srgb, var(--hp-crimson) 6%, var(--hp-card)); text-decoration: none; color: inherit; display: block; transition: border-color 0.15s ease, background 0.15s ease; }
  .hp-mini-cal:hover { border-color: var(--hp-border-strong); background: color-mix(in srgb, var(--hp-crimson) 10%, var(--hp-card)); }
  .hp-mini-cal .hp-mini-loc svg { color: var(--hp-crimson); }
  .hp-mini-loc { display: flex; align-items: center; gap: 6px; margin: 0 0 6px; font-size: 12px; font-weight: 600; color: var(--hp-text-2); }
  .hp-mini-loc svg { color: var(--hp-text-3); flex-shrink: 0; }
  .hp-mini-big { margin: 0; font-size: 42px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--hp-text); font-variant-numeric: tabular-nums; }
  .hp-mini-sub { display: flex; align-items: center; gap: 6px; margin: 6px 0 0; font-size: 12.5px; color: var(--hp-text-2); }
  .hp-today-fx { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--hp-border); border-radius: 14px; overflow: hidden; }
  .hp-fx { display: flex; align-items: center; gap: 10px; padding: 12px 14px; text-decoration: none; min-width: 0; }
  .hp-fx + .hp-fx { border-left: 1px solid var(--hp-border); }
  .hp-fx:hover { background: var(--nk-hover); }
  .hp-fx-ico { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; background: color-mix(in srgb, var(--hp-gold) 16%, transparent); color: var(--hp-gold); overflow: hidden; }
  .hp-fx-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .hp-fx-label { font-size: 11.5px; color: var(--hp-text-2); white-space: nowrap; }
  .hp-fx-label span { color: var(--hp-text-3); }
  .hp-fx-val { font-size: 16.5px; font-weight: 800; letter-spacing: -0.01em; color: var(--hp-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hp-fx .hp-fx-chg { margin: 0 0 0 auto; font-size: 11px; }
  .hp-today-links { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; }
  .hp-today-links a {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 12px; border: 1px solid var(--hp-border); border-radius: 9999px;
    font-size: 12.5px; color: var(--hp-text-2); text-decoration: none; background: var(--hp-card);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .hp-today-links a:hover { border-color: var(--hp-crimson); color: var(--hp-crimson); }
  .hp-today-links strong { font-weight: 700; color: var(--hp-text); font-variant-numeric: tabular-nums; }
  .hp-today-links .hp-today-more { border: none; background: none; color: var(--hp-crimson-dark); font-weight: 600; padding: 8px 4px; }
  /* Dark theme: light salmon keeps 4.5:1 on the dark card */
  :global([data-theme="dark"]) .hp-today-links .hp-today-more { color: #FF7A6E; }
  .hp-today-more span { transition: transform 0.2s ease; }
  .hp-today-more:hover span { transform: translateX(3px); }
  @media (max-width: 420px) {
    .hp-today-mini { grid-template-columns: 1fr; }
    .hp-today-fx { grid-template-columns: 1fr; }
    .hp-fx + .hp-fx { border-left: none; border-top: 1px solid var(--hp-border); }
  }
  @media (max-width: 900px) {
    .hp-hero-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero-copy > *, .hp-today, .hp-today-dot { animation: none; }
  }
  /* System layer: fixed film grain, never on scrolling content */
  .hp-grain {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0.05;
