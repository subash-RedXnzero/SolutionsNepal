            <p class="hp-mini-big" lang="ne">{toDevanagari(String(today.bsDay))}</p>
            <p class="hp-mini-sub" lang="ne">{BS_MONTHS_NP[today.bsMonth - 1]} {toDevanagari(String(today.bsYear))}</p>
