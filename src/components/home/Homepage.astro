          <a href="/nepal/calendar"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.6h17M8 3v4M16 3v4"/></svg>Date <strong lang="ne">{bsShort}</strong><span aria-hidden="true">→</span></a>
