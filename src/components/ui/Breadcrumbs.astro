---
import { SITE_URL } from '../../data/seo.js';

const { items } = Astro.props;

// Build BreadcrumbList JSON-LD (normalize trailing slashes, absolute URLs)
function absUrl(href) {
  if (!href) return SITE_URL + '/';
  const clean = href !== '/' ? href.replace(/\/+$/, '') : '/';
  return `${SITE_URL}${clean}`;
}

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
];
items.forEach((item, index) => {
  const position = index + 2;
  if (item.href && index < items.length - 1) {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position,
      name: item.label,
      item: absUrl(item.href),
    });
  } else {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position,
      name: item.label,
    });
  }
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

<nav aria-label="Breadcrumb" class="breadcrumb-nav">
  <ol class="breadcrumb-list">
    <li>
      <a href="/" class="breadcrumb-link">Home</a>
    </li>
    {items.map((item, index) => (
      <li class="breadcrumb-sep">
        <span class="breadcrumb-slash">/</span>
        {item.href && index < items.length - 1 ? (
          <a href={item.href} class="breadcrumb-link">{item.label}</a>
        ) : (
          <span class="breadcrumb-current">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumb-nav {
    margin-bottom: 20px;
    max-width: 100%;
    min-width: 0;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 4px;
    column-gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .breadcrumb-list > li {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
  }
  .breadcrumb-link {
    font-size: 12px;
    color: var(--nk-text-tertiary);
    text-decoration: none;
    transition: color 0.1s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .breadcrumb-link:hover {
    color: var(--nk-accent);
  }
  .breadcrumb-slash {
    font-size: 12px;
    color: var(--nk-border-strong);
    flex-shrink: 0;
  }
  .breadcrumb-current {
    font-size: 12px;
    color: var(--nk-text-secondary);
    font-weight: 500;
    min-width: 0;
    overflow-wrap: break-word;
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 640px) {
    .breadcrumb-nav { margin-bottom: 16px; }
  }
</style>
