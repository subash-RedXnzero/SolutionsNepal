---
// BlogCard — one reusable card for the Blog journal grid.
// Props: post = { slug, title, description, image, category, author, readTime }
// To change the blog look, edit ONLY this file.
// To change text/images, edit the .md file in Blogedit/ (never edit this file for content).
import Image from '../ui/Image.astro';

const { post } = Astro.props;
---
<a href={`/blog/${post.slug}`} class="post-card">
  <div class="post-thumb">
    <Image src={post.image} alt={post.title} width={400} height={240} loading="lazy" wrapper={false} />
  </div>
  <div class="post-body">
    <span class="post-category">{post.category}</span>
    <h3 class="post-title">{post.title}</h3>
    <p class="post-excerpt">{post.description}</p>
    <div class="post-author">
      <div class="author-avatar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <span class="author-name">{post.author}</span>
      <span class="author-dot"></span>
      <span class="author-read">{post.readTime}</span>
    </div>
  </div>
</a>

<style>
  .post-card {
    border: 1px solid var(--nk-border);
    border-radius: var(--radius-lg);
    background: var(--nk-card-bg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
    min-width: 0;
    max-width: 100%;
    display: flex;
    flex-direction: column;
  }
  .post-card:hover {
    border-color: var(--nk-border-strong);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .post-thumb {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--nk-muted);
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .post-card:hover .post-thumb img { transform: scale(1.03); }
  .post-body { padding: 24px 24px 22px; min-width: 0; display: flex; flex-direction: column; }
  .post-category {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--nk-accent);
    margin-bottom: 12px;
  }
  .post-title {
    font-size: 17px;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--nk-text);
    margin: 0 0 10px;
    overflow-wrap: break-word;
    word-break: break-word;
    text-wrap: pretty;
  }
  .post-excerpt {
    font-size: 14.5px;
    color: var(--nk-text-secondary);
    line-height: 1.65;
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-author {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 4px;
    gap: 8px;
    padding-top: 16px;
    margin-top: auto;
    border-top: 1px solid var(--nk-border);
    min-width: 0;
  }
  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--nk-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--nk-text-tertiary);
  }
  .author-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--nk-text);
    min-width: 0;
    overflow-wrap: break-word;
  }
  .author-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--nk-border);
  }
  .author-read {
    font-size: 11px;
    color: var(--nk-text-tertiary);
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .post-body { padding: 20px 20px 18px; }
    .post-title { font-size: 16px; }
    .post-excerpt { font-size: 14px; -webkit-line-clamp: 3; }
  }
</style>
