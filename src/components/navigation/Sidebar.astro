---
import { getActiveCategories } from '../../data/categories.js';

const { currentPath } = Astro.props;
const activeCategories = getActiveCategories();

const iconPaths: Record<string, string> = {
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>',
  banknote: '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  'land-plot': '<path d="m12 8 6-3-6-3v10"/><path d="m8 11.99-5.5 3.14a1 1 0 0 0 0 1.74l8.5 4.86a2 2 0 0 0 2 0l8.5-4.86a1 1 0 0 0 0-1.74L16 12"/><path d="m6.49 12.85 11.02 6.3"/><path d="M17.51 12.85 6.5 19.15"/>',
  gem: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  'graduation-cap': '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 12 0v-5"/>',
  languages: '<path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>',
  camera: '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>',
  image: '<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>',
  baby: '<circle cx="12" cy="8" r="4"/><path d="M12 4c.6 1.2.6 2.8 0 4M9 13c-2 1-3 3-3 6h12c0-3-1-5-3-6"/>',
  briefcase: '<rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  droplets: '<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>',
  truck: '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>',
  'file-text': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/>',
};

function isActive(href: string) {
  const path = currentPath.length > 1 ? currentPath.replace(/\/+$/, '') : currentPath;
  return path === href || path.startsWith(href + '/');
}
---

<aside class="sidebar-container hidden lg:block shrink-0">
  <nav class="sidebar-nav">
    <p class="sidebar-label">Categories</p>
    <div class="sidebar-list">
      {activeCategories.map(cat => {
        const active = isActive(cat.href);
        return (
          <a
            href={cat.href}
            class:list={["sidebar-item", { active }]}
            aria-current={active ? 'page' : undefined}
          >
            <span class="sidebar-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[cat.icon] || iconPaths.calendar} />
            </span>
            <span class="sidebar-name">{cat.name}</span>
            <span class="sidebar-count">{cat.count}</span>
          </a>
        );
      })}
    </div>
  </nav>
</aside>

<style>
  .sidebar-container {
    width: 220px;
    flex-shrink: 0;
  }
  .sidebar-nav {
    position: sticky;
    top: 64px;
  }
  .sidebar-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nk-text-tertiary);
    padding: 0 12px;
    margin-bottom: 8px;
  }
  .sidebar-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--nk-border);
    border-radius: var(--radius-lg);
    background-color: var(--nk-sidebar-bg);
    overflow: hidden;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 400;
    color: var(--nk-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--nk-hairline);
    transition: background-color 0.1s ease, color 0.1s ease;
  }
  .sidebar-item:last-child { border-bottom: none; }
  .sidebar-item:hover {
    background-color: var(--nk-hover);
    color: var(--nk-text);
  }
  .sidebar-item.active {
    background-color: var(--nk-sidebar-active);
    color: var(--nk-accent);
    font-weight: 500;
  }
  .sidebar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--nk-text-tertiary);
  }
  .sidebar-item.active .sidebar-icon {
    color: var(--nk-accent);
  }
  .sidebar-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sidebar-count {
    font-size: 11px;
    font-weight: 500;
    color: var(--nk-text-tertiary);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .sidebar-item.active .sidebar-count {
    color: var(--nk-accent);
    opacity: 0.7;
  }

  @media (max-width: 1024px) {
    .sidebar-container { width: 200px; }
  }
</style>
