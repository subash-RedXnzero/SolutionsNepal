  .pdf-dropzone { color: var(--nk-text-secondary); background: var(--nk-bg); transition: border-color 150ms ease, background-color 150ms ease; }
  .pdf-dropzone:hover { border-color: var(--nk-accent); background: var(--nk-hover); }
  .pdf-upload-mark { display: flex; width: 42px; height: 42px; margin: 0 auto 12px; align-items: center; justify-content: center; border-radius: 50%; background: var(--nk-accent-subtle); color: var(--nk-accent); font-size: 24px; }
</style>
