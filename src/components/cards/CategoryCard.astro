---
const { name, description, href, icon, tools: toolCount, color } = Astro.props;

const iconPaths: Record<string, string> = {
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>',
  banknote: '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  gem: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  'graduation-cap': '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 6 3 12 0v-5"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  coins: '<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>',
  'map-pin': '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
};
---

<a
  href={href}
  class="category-card group flex items-center gap-3 px-4 py-3 transition-colors duration-100 no-underline"
  style="background-color: var(--nk-surface); text-decoration: none; color: var(--nk-text);"
>
  <div
    class="flex items-center justify-center w-7 h-7 rounded-md shrink-0"
    style={`background-color: ${color}10; color: ${color};`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[icon] || iconPaths.calendar} />
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <h3 class="text-[13px] font-medium truncate" style="color: var(--nk-text);">{name}</h3>
      {toolCount > 0 && (
        <span class="text-[10px] tabular-nums" style="color: var(--nk-text-tertiary);">{toolCount}</span>
      )}
    </div>
    <p class="text-[11px] truncate" style="color: var(--nk-text-tertiary);">{description}</p>
  </div>
  <svg
    class="category-arrow flex-shrink-0 w-3.5 h-3.5 transition-all duration-100"
    style="color: var(--nk-text-tertiary);"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M5 12h14"/>
    <path d="m12 5 7 7-7 7"/>
  </svg>
</a>

<style>
  .category-card:hover .category-arrow {
    transform: translateX(3px);
    opacity: 0.6;
  }
</style>
