{
  // Cloudflare Workers — serves ./dist as static assets (no adapter needed:
  // this site is fully pre-rendered, no SSR).
  // `main` adds the edge worker (src/worker.js): same-origin /api/live/*
  // routes re-fetch free upstream prices with edge caching so gold/silver
  // and fuel stay live after hosting without rebuilds. All other routes
  // fall through to the static assets below untouched.
  "main": "src/worker.js",
  "name": "solutionsnepal",
  "compatibility_date": "2026-10-11",
   "workers_dev": false,
  "preview_urls": false,
  // Cron refresh: the scheduled handler in src/worker.js re-fetches the
  // /api/live/* upstreams and re-warms the edge cache twice daily at
  // 09:30 & 17:00 Nepal time (UTC-5:45) — day-open local rates + NRB's
  // late-afternoon forex bulletin. Triggers upload with the next deploy.
  "triggers": {
    "crons": ["45 3 * * *", "15 11 * * *"]
  },
  "routes": [
    {
      "pattern": "solutionsnepal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.solutionsnepal.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
