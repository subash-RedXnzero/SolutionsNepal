{
  // Cloudflare Workers — serves ./dist as static assets (no adapter needed:
  // this site is fully pre-rendered, no SSR).
  // `main` adds the edge worker (src/worker.js): same-origin /api/live/*
  // routes re-fetch free upstream prices with edge caching so gold/silver
  // and fuel stay live after hosting without rebuilds. All other routes
  // fall through to the static assets below untouched.
  "main": "src/worker.js",
  "name": "solutionsnepal",
  "compatibility_date": "2026-10-11",
   "workers_dev": false,
  "preview_urls": false,
  // Cron refresh: the scheduled handler in src/worker.js re-fetches the
  // /api/live/* upstreams and re-warms the edge cache twice daily at
  // 09:30 & 17:00 Nepal time (UTC-5:45) — day-open local rates + NRB's
  // late-afternoon forex bulletin. Triggers upload with the next deploy.
  "triggers": {
    "crons": ["45 3 * * *", "15 11 * * *"]
  },
  "routes": [
    {
      "pattern": "solutionsnepal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.solutionsnepal.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Env binding so src/worker.js fetch() can fall through to the assets
    // pipeline: ASSETS.fetch(request) applies this whole config (_redirects,
    // html_handling, not_found_handling). Required with run_worker_first.
    "binding": "ASSETS",
    // Serve /page directly (200 from /page/index.html) and redirect /page/ away.
    // Must match BaseLayout's canonical tags, the sitemap and internal links,
    // which all use the non-trailing-slash form. The default
    // "auto-trailing-slash" did the opposite (307'd /page → /page/) so every
    // canonical URL redirected away from itself — GSC then grouped the 200
    // slash pages as "Alternate page with proper canonical tag" and the
    // canonical URLs were never served.
    "html_handling": "drop-trailing-slash",
    // Invoke the worker for EVERY request, including asset matches — without
    // this, matching assets are served before the worker runs and the worker's
    // www→apex 301 + trailing-slash 301 (src/worker.js) never fire for page
    // URLs.
    "run_worker_first": true
  }
}
