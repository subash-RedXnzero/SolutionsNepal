    "docx": "^9.7.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "nepali-date-engine": "^1.0.0",
    "pako": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "upng-js": "^2.1.0"
